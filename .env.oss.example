# Sotto OSS local defaults.
# Copy to .env.local, then add at least one AI provider key and one TTS provider key
# unless you route generation through a local agent/CLI integration.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sotto?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sotto?schema=public"
REDIS_URL="redis://localhost:6379"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
EXPO_PUBLIC_API_URL="http://localhost:3000/api"
BYOK_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

SYSTEM_USER_EMAIL="system@example.com"
SYSTEM_USER_HANDLE="system"
SYSTEM_USER_NAME="System Owner"
SYSTEM_USER_BIO="Private podcasts generated by this self-hosted deployment."
SYSTEM_USER_IMAGE="/brand/profile?v=amber"

STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./.sotto/storage"
PAYMENT_PROVIDER="none"

# Minimal one-key path: OpenAI can cover both script generation and TTS.
AI_PROVIDER="openai"
TTS_PROVIDER="openai"
STT_PROVIDER="openai"
OPENAI_API_KEY=""

# Alternative AI providers.
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Alternative TTS providers.
ELEVENLABS_API_KEY=""
CARTESIA_API_KEY=""
HUME_API_KEY=""
FAL_KEY=""
REPLICATE_API_TOKEN=""
MISTRAL_API_KEY=""

# Optional integrations for self-hosters.
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""
TWITTER_BOT_USER_ID=""
NEXT_PUBLIC_TWITTER_BOT_HANDLE=""
TELEGRAM_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
