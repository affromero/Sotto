# Sotto OSS local defaults.
# Copy to .env.local, then add at least one AI provider key and one TTS provider key
# unless you route generation through a local agent/CLI integration.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sotto?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sotto?schema=public"
REDIS_URL="redis://localhost:6379"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
EXPO_PUBLIC_API_URL="http://localhost:3000/api"
BYOK_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

SYSTEM_USER_EMAIL="system@example.com"
SYSTEM_USER_HANDLE="system"
SYSTEM_USER_NAME="System Owner"
SYSTEM_USER_BIO="Private podcasts generated by this self-hosted deployment."
SYSTEM_USER_IMAGE="/brand/profile?v=amber"

STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./.sotto/storage"
PAYMENT_PROVIDER="none"

# Minimal one-key path: OpenAI can cover both script generation and TTS.
AI_PROVIDER="openai"
TTS_PROVIDER="openai"
STT_PROVIDER="openai"
OPENAI_API_KEY=""

# Alternative AI providers.
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Bring your own agent: route every LLM call through your local Claude Code /
# Codex CLI with no API key. Set AI_PROVIDER="claude-code".
# If that agent lives on a VPS, point Sotto at it over SSH (key-based auth, no
# password) and it runs `ssh <host> claude ...` instead of a local subprocess.
# CLAUDE_CODE_SSH_HOST="you@your-vps"

# Totally local, zero cloud keys: run your own OpenAI-compatible model server
# (Ollama / vLLM / LM Studio) and set AI_PROVIDER="local". Pick a multilingual
# model for language learning (qwen3, gemma3, llama3.3). Requires AI_BASE_URL +
# AI_MODEL; AI_API_KEY is optional (only for a server behind auth).
# AI_PROVIDER="local"
# AI_BASE_URL="http://localhost:11434/v1"
# AI_MODEL="qwen3"

# Local speech-to-text (pronunciation grading) with no cloud key: run a local
# OpenAI-compatible Whisper server (faster-whisper-server / Speaches) and set
# STT_PROVIDER="local". Whisper large-v3-turbo gives the broadest language coverage.
# STT_PROVIDER="local"
# STT_BASE_URL="http://localhost:8000/v1"
# STT_MODEL="whisper-1"

# Totally local text-to-speech with no cloud key: run the bundled Kokoro sidecar
# (services/local-tts) and set TTS_PROVIDER="kokoro". Multilingual (en, es, fr,
# it, pt, hi, ja, zh). TTS_API_KEY is optional (only for a sidecar behind auth).
# TTS_PROVIDER="kokoro"
# TTS_BASE_URL="http://localhost:8000"     # local dev outside Docker
# TTS_BASE_URL="http://local-tts:8000"     # inside Docker Compose (service name)
# TTS_API_KEY=""

# Alternative TTS providers.
ELEVENLABS_API_KEY=""
CARTESIA_API_KEY=""
HUME_API_KEY=""
FAL_KEY=""
REPLICATE_API_TOKEN=""
MISTRAL_API_KEY=""

# Optional public links shown in the UI.
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_DISCORD_URL=""
NEXT_PUBLIC_VERIFICATION_STANDARD_URL=""
