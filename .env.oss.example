# Sotto OSS local defaults.
# Copy to .env.local, then add at least one AI provider key and one TTS provider key
# unless you route generation through a local agent/CLI integration.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sotto?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sotto?schema=public"
REDIS_URL="redis://localhost:6379"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
EXPO_PUBLIC_API_URL="http://localhost:3000/api"
BYOK_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

SYSTEM_USER_EMAIL="system@example.com"
SYSTEM_USER_HANDLE="system"
SYSTEM_USER_NAME="System Owner"
SYSTEM_USER_BIO="Private podcasts generated by this self-hosted deployment."
SYSTEM_USER_IMAGE="/brand/profile?v=amber"

STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./.sotto/storage"
PAYMENT_PROVIDER="none"

# Self-hosted instance (the default). The /welcome wizard persists real choices,
# and the first account becomes the owner who can set the AI/STT/TTS/storage stack
# in-app. Set SELF_HOSTED="false" only for the managed showcase, where /welcome
# runs as a non-persisting demo.
SELF_HOSTED="true"

# Minimal one-key path: OpenAI can cover both script generation and TTS.
AI_PROVIDER="openai"
TTS_PROVIDER="openai"
STT_PROVIDER="openai"
OPENAI_API_KEY=""

# Alternative AI providers.
ANTHROPIC_API_KEY=""
GOOGLE_GENERATIVE_AI_API_KEY=""

# Bring your own agent: route every LLM call through your local Claude Code /
# Codex CLI with no API key. Set AI_PROVIDER="claude-code".
# If that agent lives on a VPS, point Sotto at it over SSH (key-based auth, no
# password) and it runs `ssh <host> claude ...` instead of a local subprocess.
# CLAUDE_CODE_SSH_HOST="you@your-vps"

# ===========================================================================
# TOTALLY LOCAL, ZERO CLOUD KEYS
# The bundled inference stack runs with:  docker compose --profile local up
# (Ollama + faster-whisper + the Kokoro sidecar). Uncomment the block below to
# route all LLM/STT/TTS through it. Use the http://localhost:PORT URLs when Sotto
# runs on the host; use the http://<service>:PORT URLs when Sotto runs in Compose.
# ===========================================================================

# Local LLM (Ollama / vLLM / LM Studio). Multilingual models recommended for
# language learning: qwen3, gemma3, llama3.3. AI_API_KEY is optional (server auth).
# AI_PROVIDER="local"
# AI_BASE_URL="http://localhost:11434/v1"   # host;  Docker: http://ollama:11434/v1
# AI_MODEL="qwen3"

# Local speech-to-text (pronunciation grading) — OpenAI-compatible Whisper server.
# large-v3-turbo gives the broadest (99+ language) coverage. STT_MODEL must match
# what the server serves (the bundled faster-whisper service uses the id below).
# STT_PROVIDER="local"
# STT_BASE_URL="http://localhost:8001/v1"   # host;  Docker: http://whisper:8000/v1
# STT_MODEL="deepdml/faster-whisper-large-v3-turbo-ct2"

# Local text-to-speech — the bundled Kokoro sidecar (services/local-tts).
# Multilingual (en, es, fr, it, pt, hi, ja, zh). TTS_API_KEY optional (sidecar auth).
# TTS_PROVIDER="kokoro"
# TTS_BASE_URL="http://localhost:8000"      # host;  Docker: http://local-tts:8000
# TTS_API_KEY=""

# Alternative TTS providers.
ELEVENLABS_API_KEY=""
CARTESIA_API_KEY=""
HUME_API_KEY=""
FAL_KEY=""
REPLICATE_API_TOKEN=""
MISTRAL_API_KEY=""

# Optional public links shown in the UI.
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_DISCORD_URL=""
NEXT_PUBLIC_VERIFICATION_STANDARD_URL=""
