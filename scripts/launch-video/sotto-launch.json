{
  "version": 1,
  "project": {
    "title": "Sotto Product Launch",
    "description": "Cinematic product launch video for Sotto — the social podcast network"
  },
  "defaults": {
    "ttsProvider": "elevenlabs",
    "ttsModel": "eleven_v3",
    "ttsVoiceId": "VOICEID_PLACEHOLDER",
    "backgroundMusicUrl": "MUSIC_URL_PLACEHOLDER",
    "backgroundMusicVolume": 0.07,
    "subtitles": {
      "enabled": true,
      "style": "cinematic",
      "position": "bottom",
      "fontSize": 34
    }
  },
  "scenes": [
    {
      "title": "Landing Page — Brand Introduction",
      "narration": "What if creating a podcast was as simple as having a conversation? Sotto turns any topic into a studio-quality, two-voice podcast — in minutes. No mic. No editing. Just your curiosity.",
      "actions": [
        { "type": "navigate", "url": "https://sotto.fm" },
        { "type": "wait", "ms": 1500 },
        { "type": "scroll", "distance": 300, "duration": 2000 },
        { "type": "wait", "ms": 2000 },
        { "type": "scroll", "distance": 400, "duration": 2000 },
        { "type": "wait", "ms": 2000 },
        { "type": "scroll", "distance": -700, "duration": 1500 }
      ],
      "sfx": {
        "clickSounds": false,
        "typingSounds": false
      },
      "overlays": [
        {
          "text": "Every voice. Every topic. One feed.",
          "position": "center",
          "showAtSeconds": 0.5,
          "hideAtSeconds": 3.5,
          "fontSize": 42,
          "backgroundColor": "rgba(0,0,0,0.6)",
          "textColor": "#FFFFFF"
        }
      ],
      "transition": { "type": "fade" }
    },
    {
      "title": "Navigate to Create",
      "narration": "Let's create a podcast from scratch. One click to begin.",
      "actions": [
        { "type": "wait", "ms": 500 },
        { "type": "click", "selector": "a[href='/create']" },
        { "type": "waitForSelector", "selector": "[class*='chatArea'], [class*='inputBar']", "timeout": 5000 },
        { "type": "wait", "ms": 1000 }
      ],
      "sfx": {
        "clickSounds": true,
        "typingSounds": false
      },
      "transition": { "type": "fade" }
    },
    {
      "title": "Discovery Chat — Topic Input",
      "narration": "Start by telling Sotto what you're curious about. The AI discovery chat digs deeper — asking follow-up questions to understand exactly what makes this topic fascinating to you.",
      "actions": [
        { "type": "intercept", "name": "discovery", "options": { "podcastId": "PODCAST_ID_PLACEHOLDER" } },
        { "type": "intercept", "name": "interact", "options": { "podcastId": "PODCAST_ID_PLACEHOLDER" } },
        { "type": "wait", "ms": 800 },
        { "type": "click", "selector": "[class*='input']:not(button)" },
        { "type": "type", "selector": "[class*='input']:not(button)", "text": "The science of why we dream — why do our brains create entire worlds while we sleep?", "speed": { "min": 25, "max": 65 } },
        { "type": "wait", "ms": 600 },
        { "type": "click", "selector": "[class*='sendButton'], button[type='submit']" },
        { "type": "wait", "ms": 2000 },
        { "type": "scroll", "distance": 200, "duration": 800 }
      ],
      "sfx": {
        "clickSounds": true,
        "typingSounds": true
      },
      "transition": { "type": "dissolve" }
    },
    {
      "title": "Discovery Chat — AI Follow-up",
      "narration": "Sotto doesn't just take your topic at face value. It asks the right questions — what angle interests you most, what level of depth you want, what surprised you. This shapes a podcast that's truly yours.",
      "actions": [
        { "type": "waitForSelector", "selector": "[class*='assistantBubble'], [class*='bubble']", "timeout": 5000 },
        { "type": "wait", "ms": 2000 },
        { "type": "scroll", "distance": 150, "duration": 600 },
        { "type": "wait", "ms": 1500 },
        { "type": "click", "selector": "[class*='input']:not(button)" },
        { "type": "type", "selector": "[class*='input']:not(button)", "text": "I'm fascinated by lucid dreaming and the neuroscience behind it — why some people can control their dreams", "speed": { "min": 30, "max": 70 } },
        { "type": "wait", "ms": 500 },
        { "type": "click", "selector": "[class*='sendButton'], button[type='submit']" },
        { "type": "wait", "ms": 2500 },
        { "type": "scroll", "distance": 200, "duration": 800 }
      ],
      "sfx": {
        "clickSounds": true,
        "typingSounds": true
      },
      "transition": { "type": "dissolve" }
    },
    {
      "title": "Script Generation",
      "narration": "When the conversation is complete, Sotto generates a full podcast script — a natural two-voice dialogue between a Host and an Expert, with researched facts, smooth transitions, and your unique angle woven throughout.",
      "actions": [
        { "type": "intercept", "name": "scriptApprove", "options": { "podcastId": "PODCAST_ID_PLACEHOLDER" } },
        { "type": "wait", "ms": 1000 },
        { "type": "click", "selector": "[class*='generateButton'], button:has-text('Generate')" },
        { "type": "wait", "ms": 3000 },
        { "type": "waitForSelector", "selector": "[class*='turn'], [class*='turns']", "timeout": 10000 },
        { "type": "wait", "ms": 1500 }
      ],
      "sfx": {
        "clickSounds": true,
        "typingSounds": false
      },
      "transition": { "type": "fade" }
    },
    {
      "title": "Script Review",
      "narration": "Review every line before a single word is spoken. Edit turns, reorder sections, adjust the tone. This is your podcast — you have full creative control.",
      "actions": [
        { "type": "scroll", "distance": 300, "duration": 2000 },
        { "type": "wait", "ms": 1500 },
        { "type": "scroll", "distance": 300, "duration": 2000 },
        { "type": "wait", "ms": 1500 },
        { "type": "scroll", "distance": 300, "duration": 2000 },
        { "type": "wait", "ms": 1000 },
        { "type": "scroll", "distance": -900, "duration": 1500 }
      ],
      "sfx": {
        "clickSounds": false,
        "typingSounds": false
      },
      "transition": { "type": "dissolve" }
    },
    {
      "title": "Audio Generation — ElevenLabs",
      "narration": "Now, choose a voice. Sotto supports six professional TTS providers — each with its own character. Here's ElevenLabs, known for expressive, natural-sounding speech.",
      "actions": [
        { "type": "wait", "ms": 500 },
        { "type": "click", "selector": "button:has-text('Approve'), button:has-text('Generate Audio')" },
        { "type": "wait", "ms": 3000 }
      ],
      "sfx": {
        "clickSounds": true,
        "typingSounds": false
      },
      "providerBanner": {
        "provider": "ElevenLabs",
        "showAtSeconds": 2,
        "hideAtSeconds": null,
        "position": "bottom-right"
      },
      "ttsProvider": "elevenlabs",
      "ttsModel": "eleven_v3",
      "transition": { "type": "fade" }
    },
    {
      "title": "Podcast Playback — ElevenLabs Voice",
      "narration": "Listen to the result. Two distinct voices, natural pacing, emotional range — all generated from text in under a minute.",
      "actions": [
        { "type": "navigate", "url": "https://sotto.fm/podcast/PODCAST_ID_PLACEHOLDER" },
        { "type": "waitForSelector", "selector": "[class*='player']", "timeout": 5000 },
        { "type": "wait", "ms": 1000 },
        { "type": "click", "selector": "[class*='playButton']" },
        { "type": "wait", "ms": 8000 },
        { "type": "click", "selector": "[class*='playButton']" }
      ],
      "sfx": {
        "clickSounds": true,
        "typingSounds": false
      },
      "providerBanner": {
        "provider": "ElevenLabs",
        "showAtSeconds": 0,
        "hideAtSeconds": null,
        "position": "bottom-right"
      },
      "transition": { "type": "dissolve" }
    },
    {
      "title": "Voice Comparison — OpenAI TTS",
      "narration": "But you're not locked into one voice. Switch providers instantly. Here's OpenAI — crisp, clear, and remarkably fluid.",
      "actions": [
        { "type": "wait", "ms": 500 },
        { "type": "click", "selector": "[class*='pill']:nth-child(2), [class*='voiceTrack']:nth-child(2)" },
        { "type": "wait", "ms": 1000 },
        { "type": "click", "selector": "[class*='playButton']" },
        { "type": "wait", "ms": 7000 },
        { "type": "click", "selector": "[class*='playButton']" }
      ],
      "sfx": {
        "clickSounds": true,
        "typingSounds": false
      },
      "providerBanner": {
        "provider": "OpenAI TTS",
        "showAtSeconds": 0,
        "hideAtSeconds": null,
        "position": "bottom-right"
      },
      "ttsProvider": "openai",
      "ttsModel": "tts-1-hd",
      "transition": { "type": "dissolve" }
    },
    {
      "title": "Voice Comparison — Cartesia Sonic",
      "narration": "And Cartesia Sonic — ultra-low latency with warm, conversational tone. Every provider brings something different. Pick the voice that matches your podcast's personality.",
      "actions": [
        { "type": "wait", "ms": 500 },
        { "type": "click", "selector": "[class*='pill']:nth-child(3), [class*='voiceTrack']:nth-child(3)" },
        { "type": "wait", "ms": 1000 },
        { "type": "click", "selector": "[class*='playButton']" },
        { "type": "wait", "ms": 7000 },
        { "type": "click", "selector": "[class*='playButton']" }
      ],
      "sfx": {
        "clickSounds": true,
        "typingSounds": false
      },
      "providerBanner": {
        "provider": "Cartesia Sonic",
        "showAtSeconds": 0,
        "hideAtSeconds": null,
        "position": "bottom-right"
      },
      "ttsProvider": "cartesia",
      "ttsModel": "sonic-3",
      "transition": { "type": "fade" }
    },
    {
      "title": "Video Generation Introduction",
      "narration": "But Sotto doesn't stop at audio. Every podcast can become a video — with AI-generated visuals, illustrations, and footage that bring your story to life.",
      "actions": [
        { "type": "wait", "ms": 1000 },
        { "type": "scroll", "distance": 400, "duration": 1500 },
        { "type": "wait", "ms": 1500 },
        { "type": "click", "selector": "button:has-text('Video'), [class*='videoTab']" },
        { "type": "wait", "ms": 2000 }
      ],
      "sfx": {
        "clickSounds": true,
        "typingSounds": false
      },
      "overlays": [
        {
          "text": "AI-Generated Video",
          "position": "top-center",
          "showAtSeconds": 1,
          "hideAtSeconds": 4,
          "fontSize": 36,
          "backgroundColor": "rgba(0,0,0,0.6)",
          "textColor": "#FFFFFF"
        }
      ],
      "transition": { "type": "dissolve" }
    },
    {
      "title": "Video Playback",
      "narration": "Each segment of your script is classified — illustration, stock footage, text card — and matched with AI-generated visuals. The result is a polished video podcast, ready to share.",
      "actions": [
        { "type": "waitForSelector", "selector": "video, [class*='videoPlayer']", "timeout": 5000 },
        { "type": "wait", "ms": 1000 },
        { "type": "click", "selector": "video, [class*='videoPlayer']" },
        { "type": "wait", "ms": 10000 }
      ],
      "sfx": {
        "clickSounds": false,
        "typingSounds": false
      },
      "transition": { "type": "fade" }
    },
    {
      "title": "Avatar Introduction",
      "narration": "And for that personal touch — add an avatar. A photorealistic AI presenter who delivers your introduction, reacts to the conversation, and makes your podcast feel truly alive.",
      "actions": [
        { "type": "intercept", "name": "avatar", "options": { "videoUrl": "AVATAR_CLIP_URL_PLACEHOLDER" } },
        { "type": "wait", "ms": 1000 },
        { "type": "click", "selector": "button:has-text('Avatar'), [class*='avatarBtn']" },
        { "type": "wait", "ms": 2000 },
        { "type": "waitForSelector", "selector": "[class*='avatarPreview'], [class*='avatar'] video", "timeout": 5000 },
        { "type": "wait", "ms": 5000 },
        { "type": "clearIntercept", "name": "avatar" }
      ],
      "sfx": {
        "clickSounds": true,
        "typingSounds": false
      },
      "avatar": {
        "videoUrl": "AVATAR_CLIP_URL_PLACEHOLDER",
        "posX": 0.72,
        "posY": 0.05,
        "width": 0.25,
        "height": 0.35,
        "maskShape": "rounded",
        "showAtSeconds": 3,
        "hideAtSeconds": null
      },
      "transition": { "type": "dissolve" }
    },
    {
      "title": "Dashboard Tour",
      "narration": "Your dashboard is your studio. Every podcast you've created, every fork, every collaboration — all in one place. Track listens, manage voice tracks, and see your content grow.",
      "actions": [
        { "type": "navigate", "url": "https://sotto.fm/dashboard" },
        { "type": "waitForSelector", "selector": "[class*='greeting'], [class*='header']", "timeout": 5000 },
        { "type": "wait", "ms": 1500 },
        { "type": "scroll", "distance": 300, "duration": 1500 },
        { "type": "wait", "ms": 2000 },
        { "type": "scroll", "distance": 300, "duration": 1500 },
        { "type": "wait", "ms": 1500 },
        { "type": "hover", "selector": "[class*='card']:first-child, [class*='statCard']:first-child" },
        { "type": "wait", "ms": 1000 },
        { "type": "scroll", "distance": -600, "duration": 1200 }
      ],
      "sfx": {
        "clickSounds": false,
        "typingSounds": false
      },
      "transition": { "type": "fade" }
    },
    {
      "title": "Closing — Back to Landing",
      "narration": "Sotto. Every voice. Every topic. One feed. Start creating — it only takes a conversation.",
      "actions": [
        { "type": "navigate", "url": "https://sotto.fm" },
        { "type": "waitForSelector", "selector": "[class*='hero']", "timeout": 5000 },
        { "type": "wait", "ms": 4000 }
      ],
      "sfx": {
        "clickSounds": false,
        "typingSounds": false
      },
      "overlays": [
        {
          "text": "sotto.fm",
          "position": "center",
          "showAtSeconds": 2,
          "hideAtSeconds": 6,
          "fontSize": 48,
          "backgroundColor": "rgba(0,0,0,0.5)",
          "textColor": "#FFFFFF"
        }
      ],
      "transition": { "type": "fade" }
    }
  ]
}
