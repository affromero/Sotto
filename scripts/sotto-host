#!/usr/bin/env bash
# sotto-host — move a self-hosted Sotto to newer images and report what it runs.
#
# A self-host install has no clone: install.sh writes ~/.sotto/docker-compose.yml
# and ~/.sotto/.env, and the stack runs pre-built images from GHCR. Updating is
# therefore repointing SOTTO_IMAGE_TAG, refreshing the compose file, pulling,
# and restarting -- never a git operation.
#
# Install:  curl -fsSL https://sotto.fm/sotto-host -o ~/.local/bin/sotto-host && chmod +x ~/.local/bin/sotto-host
set -euo pipefail
umask 077

SOTTO_DIR="${SOTTO_DIR:-$HOME/.sotto}"
SOTTO_REPOSITORY="${SOTTO_REPOSITORY:-affromero/Sotto}"
SOTTO_REF="${SOTTO_REF:-main}"
RAW_BASE="${SOTTO_RAW_BASE:-https://raw.githubusercontent.com/${SOTTO_REPOSITORY}/${SOTTO_REF}}"
API_BASE="${SOTTO_API_BASE:-https://api.github.com/repos/${SOTTO_REPOSITORY}}"
STAGING_DIR=""
cleanup() {
  [ -z "${INSTALL_LOCK_DIR:-}" ] || rmdir "$INSTALL_LOCK_DIR"
  [ -z "$STAGING_DIR" ] || rm -rf "$STAGING_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

load_image_helper() {
  STAGING_DIR=$(mktemp -d)
  if [ -f "$SOTTO_DIR/images.sh" ]; then
    cp "$SOTTO_DIR/images.sh" "$STAGING_DIR/images.sh"
  else
    curl -fsSL "$RAW_BASE/scripts/selfhost/images.sh" -o "$STAGING_DIR/images.sh" ||
      fail "Could not download the image verification helper. Configuration has not changed."
  fi
  . "$STAGING_DIR/images.sh"
}

BOLD=$(printf '\033[1m'); DIM=$(printf '\033[2m'); RESET=$(printf '\033[0m')
CYAN=$(printf '\033[36m'); GREEN=$(printf '\033[32m'); YELLOW=$(printf '\033[33m'); RED=$(printf '\033[31m')
info() { printf "${CYAN}${BOLD}>${RESET} %b\n" "$1"; }
ok()   { printf "${GREEN}${BOLD}✓${RESET} %b\n" "$1"; }
warn() { printf "${YELLOW}${BOLD}!${RESET} %b\n" "$1"; }
fail() { printf "${RED}${BOLD}✗${RESET} %b\n" "$1" >&2; exit 1; }

usage() {
  cat <<'USAGE'
sotto-host — manage a self-hosted Sotto

  sotto-host update [--to REF] [--check] [--no-backup]
      Move the stack to newer images and restart it.
      --to REF     a released version (v0.3.1), a commit (2ce63555), or
                   "latest"; defaults to the newest published image
      --check      report what an update would do, change nothing
      --no-backup  skip the database dump taken before restarting

  sotto-host status
      Show the pinned image tag, what the stack reports, and its health.

  sotto-host access list
      List profiles to find the first Admin's principal ID.

  sotto-host access setup
      Create the first Admin profile and shared password locally.

  sotto-host access reset
      Replace the shared password locally and sign out existing sessions.

  sotto-host rollback
      Return to the tag the last update replaced.

  sotto-host help

  Environment:
    SOTTO_DIR   install directory (default ~/.sotto)
USAGE
}

compose() {
  if docker compose version >/dev/null 2>&1; then
    docker compose "$@"
  elif command -v docker-compose >/dev/null 2>&1; then
    docker-compose "$@"
  else
    fail "Docker Compose v2 is required.\n  Install: ${BOLD}https://docs.docker.com/compose/install/${RESET}"
  fi
}

candidate_compose() {
  local candidate_dir="${CANDIDATE_DIR:-$STAGING_DIR}"
  local arguments=(--project-directory "$install_dir" --env-file "$candidate_dir/.env")
  if [ -f "$candidate_dir/frozen-compose.json" ]; then
    arguments+=(-f "$candidate_dir/frozen-compose.json")
  else
    arguments+=(-f "$candidate_dir/docker-compose.yml" -f "$candidate_dir/candidate-env.yml")
    if [ -f "$candidate_dir/docker-compose.override.yml" ]; then
      arguments+=(-f "$candidate_dir/docker-compose.override.yml")
    fi
  fi
  if [ -f "$candidate_dir/candidate-images.yml" ]; then
    arguments+=(-f "$candidate_dir/candidate-images.yml")
  fi
  compose "${arguments[@]}" "$@"
}

write_candidate_env() {
  local directory=$1 path
  path=${directory//\'/\'\'}
  printf "services:\n  web:\n    env_file: ['%s/.env']\n  workers:\n    env_file: ['%s/.env']\n" "$path" "$path" > "$directory/candidate-env.yml"
}

# Resolve external Compose inputs once. A second parse must reproduce the
# same model before this private snapshot can authorize any action.
freeze_candidate_config() {
  local candidate_dir="${CANDIDATE_DIR:-$STAGING_DIR}" web_id
  [ ! -e "$candidate_dir/frozen-compose.json" ] || return 1
  [ -f "$STAGING_DIR/resolved-image-ids" ] || return 1
  web_id=$(sed -n '1p' "$STAGING_DIR/resolved-image-ids") || return 1
  [[ "$web_id" =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
  candidate_compose config --format json > "$candidate_dir/rendered-compose.json" 2>/dev/null || return 1
  docker run --rm -i --network none --entrypoint node "$web_id" -e '
    // __SOTTO_FREEZE_CONFIG__
    let input = "";
    process.stdin.on("data", (part) => input += part);
    process.stdin.on("end", () => {
      try {
        const normalize = (value) => {
          if (Array.isArray(value)) return value.map(normalize);
          if (value && typeof value === "object") {
            const result = Object.create(null);
            for (const [key, item] of Object.entries(value)) {
              const restored = key.replaceAll("$$", () => "$");
              if (Object.hasOwn(result, restored)) throw new Error();
              result[restored] = normalize(item);
            }
            return result;
          }
          return value;
        };
        process.stdout.write(JSON.stringify(normalize(JSON.parse(input))));
      } catch { process.exitCode = 1; }
    });
  ' < "$candidate_dir/rendered-compose.json" > "$candidate_dir/frozen-compose.tmp" 2>/dev/null || return 1
  compose --project-directory "$install_dir" --env-file "$candidate_dir/.env" -f "$candidate_dir/frozen-compose.tmp" config --format json > "$candidate_dir/rerendered-compose.json" 2>/dev/null || return 1
  {
    printf '['
    cat "$candidate_dir/rendered-compose.json" || return 1
    printf ','
    cat "$candidate_dir/rerendered-compose.json" || return 1
    printf ']'
  } | docker run --rm -i --network none --entrypoint node "$web_id" -e '
    // __SOTTO_COMPARE_CONFIG__
    let input = "";
    process.stdin.on("data", (part) => input += part);
    process.stdin.on("end", () => {
      try {
        const canonical = (value) => Array.isArray(value) ? value.map(canonical) :
          value && typeof value === "object" ? Object.fromEntries(Object.keys(value).sort().map((key) => [key, canonical(value[key])])) : value;
        const models = JSON.parse(input);
        if (!Array.isArray(models) || models.length !== 2 || JSON.stringify(canonical(models[0])) !== JSON.stringify(canonical(models[1]))) throw new Error();
      } catch { process.exitCode = 1; }
    });
  ' >/dev/null 2>/dev/null || return 1
  mv "$candidate_dir/frozen-compose.tmp" "$candidate_dir/frozen-compose.json" || return 1
  rm -f "$candidate_dir/rendered-compose.json" "$candidate_dir/rerendered-compose.json"
}

# Inspect the effective roles without printing their environment, then pin the
# exact images verified before the candidate pull. User overrides stay in the
# configuration, but cannot replace the verified executable images.
pin_candidate_images() {
  local web_id worker_id web_ref worker_ref actual_web actual_worker candidate_dir="${CANDIDATE_DIR:-$STAGING_DIR}"
  [ -f "$STAGING_DIR/resolved-image-ids" ] || return 1
  web_id=$(sed -n '1p' "$STAGING_DIR/resolved-image-ids")
  worker_id=$(sed -n '2p' "$STAGING_DIR/resolved-image-ids")
  [[ "$web_id" =~ ^sha256:[0-9a-f]{64}$ && "$worker_id" =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
  [ "$web_id" != "$worker_id" ] || return 1
  [ -f "$candidate_dir/frozen-compose.json" ] || return 1
  candidate_compose config --format json | docker run --rm -i --network none --entrypoint node "$web_id" -e '
    // __SOTTO_COMPOSE_IMAGE_PROBE__
    let input = "";
    process.stdin.on("data", (part) => input += part);
    process.stdin.on("end", () => {
      try {
        const services = JSON.parse(input).services;
        const web = services.web, workers = services.workers;
        for (const role of [web, workers]) {
          if (!role || typeof role.image !== "string" || !/^[^\s]+$/.test(role.image) ||
              role.build || role.entrypoint || role.command ||
              role.configs?.length || role.secrets?.length || role.tmpfs?.length ||
              role.volumes_from?.length || role.post_start?.length || role.pre_stop?.length) throw new Error();
          if (role.working_dir && role.working_dir !== "/app/apps/web") throw new Error();
          for (const [name, value] of Object.entries(role.environment ?? {})) {
            if (value && ((name.startsWith("NODE_") && name !== "NODE_ENV") ||
                name.startsWith("LD_") || name.startsWith("TSX_") ||
                ["PATH", "BASH_ENV", "ENV"].includes(name))) throw new Error();
          }
          for (const mount of role.volumes ?? []) {
            const target = mount.target;
            if (typeof target !== "string" || target === "/" ||
                !target.startsWith("/") || require("node:path").posix.normalize(target) !== target ||
                target.split("/").includes("..")) throw new Error();
            const inside = (root) => target === root || target.startsWith(root + "/");
            const privateData = inside("/app/apps/web/.sotto/storage") ||
              inside("/app/apps/web/.sotto/runtime");
            if ((!privateData && inside("/app")) ||
                ["/usr", "/bin", "/sbin", "/lib", "/lib64", "/etc"].some(inside))
              throw new Error();
          }
        }
        for (const key of ["DATABASE_URL", "DIRECT_DATABASE_URL", "BYOK_ENCRYPTION_KEY", "SOTTO_SPEAKING_REFERENCE_KEYRING"]) {
          if ((web.environment?.[key] ?? "") !== (workers.environment?.[key] ?? "")) throw new Error();
        }
        process.stdout.write(web.image + "\n" + workers.image + "\n");
      } catch { process.exitCode = 1; }
    });
  ' > "$candidate_dir/effective-image-refs" || return 1
  web_ref=$(sed -n '1p' "$candidate_dir/effective-image-refs")
  worker_ref=$(sed -n '2p' "$candidate_dir/effective-image-refs")
  [ -n "$web_ref" ] && [ -n "$worker_ref" ] || return 1
  actual_web=$(docker image inspect --format '{{.Id}}' "$web_ref") || return 1
  actual_worker=$(docker image inspect --format '{{.Id}}' "$worker_ref") || return 1
  [ "$actual_web" = "$web_id" ] && [ "$actual_worker" = "$worker_id" ] || return 1
  printf 'services:\n  web:\n    image: "%s"\n    pull_policy: never\n  workers:\n    image: "%s"\n    pull_policy: never\n' \
    "$web_id" "$worker_id" > "$candidate_dir/candidate-images.yml"
}

require_install() {
  [ -f "$SOTTO_DIR/docker-compose.yml" ] ||
    fail "No Sotto install at ${SOTTO_DIR}.\n  Install it first: ${BOLD}curl -fsSL https://sotto.fm/install.sh | bash${RESET}\n  Or point at another directory: ${BOLD}SOTTO_DIR=/path sotto-host ...${RESET}"
}

# Read one key from .env without sourcing it, which would pull every secret in
# the file into this process's environment.
env_value() {
  [ -f "$SOTTO_DIR/.env" ] || return 0
  sed -n "s/^${1}=//p" "$SOTTO_DIR/.env" | tail -n 1 | tr -d '"'"'"''
}

set_env_value() {
  local key=$1 value=$2 tmp
  tmp=$(mktemp "$SOTTO_DIR/.env.XXXXXX")
  if [ -f "$SOTTO_DIR/.env" ]; then
    awk -v key="$key" '$0 !~ ("^" key "=") { print }' "$SOTTO_DIR/.env" > "$tmp"
  fi
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$SOTTO_DIR/.env"
}

# Preserve exact spelling and distinguish an absent assignment from an empty
# one. Ambiguous shell/dotenv forms must not be used to authorize restoration.
strict_env_assignment() {
  local file=$1 key=$2
  [ -r "$file" ] || return 1
  awk -v key="$key" '
    /^[[:space:]]*#/ { next }
    $0 ~ "^[[:space:]]*(export[[:space:]]+)?" key "([[:space:]]|=|$)" {
      count++
      if ($0 !~ "^" key "=") invalid = 1
      value = substr($0, length(key) + 2)
      first = substr(value, 1, 1)
      single = sprintf("%c", 39)
      if (index(value, "\r")) invalid = 1
      if (first == single || first == "\"") {
        if (length(value) < 2 || substr(value, length(value), 1) != first) invalid = 1
        inner = substr(value, 2, length(value) - 2)
        if (index(inner, first)) invalid = 1
        if (first == "\"" && (index(inner, "$") || index(inner, "`") || index(inner, "\\"))) invalid = 1
      } else if (index(value, single) || index(value, "\"") || index(value, "$") || index(value, "`") || index(value, "\\")) invalid = 1
    }
    END {
      if (invalid || count > 1) exit 1
      if (count == 0) printf "absent"
      else printf "present:%s", value
    }
  ' "$file"
}

# Compare the staged target with both rendered and running role environments.
# Compose output and container environments stay in a pipe, never in logs.
verify_rollback_effective_keys() {
  local rollback_dir=$1 web_id worker_id web_image worker_image target_web target_worker web_ref worker_ref actual_web actual_worker
  web_id=$(compose ps -q web 2>/dev/null) || return 1
  worker_id=$(compose ps -q workers 2>/dev/null) || return 1
  [[ "$web_id" =~ ^[0-9a-f]{64}$ && "$worker_id" =~ ^[0-9a-f]{64}$ && "$web_id" != "$worker_id" ]] || return 1
  [ "$(docker inspect --format '{{.State.Running}}' "$web_id")" = true ] || return 1
  [ "$(docker inspect --format '{{.State.Running}}' "$worker_id")" = true ] || return 1
  web_image=$(docker inspect --format '{{.Image}}' "$web_id") || return 1
  worker_image=$(docker inspect --format '{{.Image}}' "$worker_id") || return 1
  target_web=$(sed -n '1p' "$STAGING_DIR/resolved-image-ids")
  target_worker=$(sed -n '2p' "$STAGING_DIR/resolved-image-ids")
  [[ "$web_image" =~ ^sha256:[0-9a-f]{64}$ && "$worker_image" =~ ^sha256:[0-9a-f]{64}$ && "$target_web" =~ ^sha256:[0-9a-f]{64}$ && "$target_worker" =~ ^sha256:[0-9a-f]{64}$ ]] || return 1
  {
    printf '['
    compose config --format json 2>/dev/null || return 1
    printf ','
    candidate_compose config --format json 2>/dev/null || return 1
    for id in "$web_id" "$worker_id"; do
      printf ','
      docker inspect --format '{{json .Config.Env}}' "$id" 2>/dev/null || return 1
    done
    for id in "$web_image" "$worker_image" "$target_web" "$target_worker"; do
      printf ','
      docker image inspect --format '{{json .Config.Env}}' "$id" 2>/dev/null || return 1
    done
    printf ']'
  } | docker run --rm -i --network none --entrypoint node "$target_web" -e '
    // __SOTTO_ROLLBACK_KEY_PROBE__
    let input = "";
    process.stdin.on("data", (part) => input += part);
    process.stdin.on("end", () => {
      try {
        const [current, target, liveWeb, liveWorker, currentWebDefaults, currentWorkerDefaults, targetWebDefaults, targetWorkerDefaults] = JSON.parse(input);
        const parse = (entries) => {
          if (!Array.isArray(entries)) throw new Error();
          const values = Object.create(null);
          for (const entry of entries) {
            if (typeof entry !== "string" || !entry.includes("=")) throw new Error();
            const at = entry.indexOf("="), key = entry.slice(0, at);
            if (Object.hasOwn(values, key)) throw new Error();
            values[key] = entry.slice(at + 1);
          }
          return values;
        };
        const live = [parse(liveWeb), parse(liveWorker)];
        const defaults = [currentWebDefaults, currentWorkerDefaults, targetWebDefaults, targetWorkerDefaults].map(parse);
        const roles = [current.services.web, current.services.workers, target.services.web, target.services.workers];
        const effective = roles.map((role, index) => {
          if (!role || !role.environment || typeof role.environment !== "object" || Array.isArray(role.environment)) throw new Error();
          const environment = Object.fromEntries(Object.entries(role.environment).map(([key, value]) =>
            [key, typeof value === "string" ? value.replaceAll("$$", () => "$") : value]));
          return { ...defaults[index], ...environment };
        });
        for (const key of ["BYOK_ENCRYPTION_KEY", "SOTTO_SPEAKING_REFERENCE_KEYRING"]) {
          const values = [...live, ...effective].map((row) => row[key] === undefined ? "" : row[key]);
          if (values.some((value) => typeof value !== "string") || new Set(values).size !== 1 ||
              (key === "BYOK_ENCRYPTION_KEY" && !values[0])) throw new Error();
        }
        for (const role of [target.services.web, target.services.workers])
          if (typeof role.image !== "string" || !/^[^\s]+$/.test(role.image)) throw new Error();
        process.stdout.write(target.services.web.image + "\n" + target.services.workers.image + "\n");
      } catch { process.exitCode = 1; }
    });
  ' > "$rollback_dir/effective-image-refs" 2>/dev/null || return 1
  web_ref=$(sed -n '1p' "$rollback_dir/effective-image-refs")
  worker_ref=$(sed -n '2p' "$rollback_dir/effective-image-refs")
  [ -n "$web_ref" ] && [ -n "$worker_ref" ] || return 1
  actual_web=$(docker image inspect --format '{{.Id}}' "$web_ref" 2>/dev/null) || return 1
  actual_worker=$(docker image inspect --format '{{.Id}}' "$worker_ref" 2>/dev/null) || return 1
  [ "$actual_web" = "$target_web" ] && [ "$actual_worker" = "$target_worker" ] || return 1
  [ "$(compose ps -q web 2>/dev/null)" = "$web_id" ] && [ "$(compose ps -q workers 2>/dev/null)" = "$worker_id" ] || return 1
  [ "$(docker inspect --format '{{.State.Running}}' "$web_id")" = true ] &&
    [ "$(docker inspect --format '{{.State.Running}}' "$worker_id")" = true ]
}

web_port() {
  local port
  port=$(env_value WEB_PORT)
  echo "${port:-3000}"
}

health() {
  curl -fsS --max-time 5 "http://localhost:$(web_port)/api/v1/health" 2>/dev/null
}

current_tag() {
  local tag
  tag=$(env_value SOTTO_IMAGE_TAG)
  echo "${tag:-latest}"
}

# The published images carry `latest` and 8-character commit shas; git version
# tags never reach the registry. So a version has to be resolved to the commit
# it points at before it can name an image.
resolve_ref() {
  local ref=$1 sha
  case "$ref" in
    latest) echo latest; return 0 ;;
  esac

  if printf '%s' "$ref" | grep -Eq '^[0-9a-f]{8}$'; then
    echo "$ref"
    return 0
  fi

  sha=$(curl -fsSL "${API_BASE}/commits/${ref}" 2>/dev/null |
    sed -n 's/^  "sha": "\([0-9a-f]\{40\}\)",$/\1/p' | head -1)
  [ -n "$sha" ] ||
    fail "Could not resolve '${ref}' in ${SOTTO_REPOSITORY}.\n  Use a version (v0.3.1), an 8-character commit, or 'latest'."
  printf '%s\n' "${sha:0:8}"
}

running_version() {
  local response
  response=$(health) || return 1
  printf '%s' "$response" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | cut -c1-8
}

cmd_status() {
  require_install
  echo "install:  ${SOTTO_DIR}"
  echo "pinned:   $(current_tag)"

  local running
  if running=$(running_version); then
    echo "running:  ${running}"
  else
    echo "running:  unreachable at http://localhost:$(web_port)"
  fi

  echo "updates:  run 'sotto-host update' to resolve the newest published release"

  local response
  if response=$(health); then
    echo "health:   ${response}"
  fi
}

cmd_access() {
  require_install
  if [ "$#" -ne 1 ] || { [ "${1:-}" != list ] && [ "${1:-}" != setup ] && [ "${1:-}" != reset ]; }; then
    fail "Use sotto-host access list, setup, or reset."
  fi
  cd "$SOTTO_DIR"
  compose run --rm --no-deps web node dist/access.cjs "$@"
}

backup_database() {
  local dir file
  dir="${SOTTO_BACKUP_DIR:-$SOTTO_DIR/backups}"
  mkdir -p "$dir"
  file="${dir}/sotto_$(date +%Y%m%d_%H%M%S).sql.gz"

  # Nothing to dump before the first successful start.
  if ! compose ps --status running postgres 2>/dev/null | grep -q postgres; then
    warn "Postgres is not running; skipping the backup"
    return 0
  fi

  info "Backing up the database..."
  if compose exec -T postgres pg_dump -U sotto sotto 2>/dev/null | gzip > "$file"; then
    ok "Backup written to ${file}"
  else
    rm -f "$file"
    fail "Backup failed; not touching a running install.\n  Skip it with ${BOLD}--no-backup${RESET} if that is deliberate."
  fi
}

cmd_update() {
  require_install
  cd "$SOTTO_DIR"

  local target from revision source_base install_dir previous_revision CANDIDATE_DIR=""
  from=$(current_tag)
  if [ -n "$TO_REF" ]; then
    target=$(resolve_ref "$TO_REF")
  else
    target=latest
  fi

  local running
  running=$(running_version || true)

  echo "install:  ${SOTTO_DIR}"
  echo "pinned:   ${from}"
  if [ -n "$running" ]; then
    echo "running:  ${running}"
  fi
  echo "update:   ${from} → ${target}"

  if [ "$from" = "$target" ] && [ "${running:-}" = "$target" ]; then
    ok "Already running ${target}; nothing to do."
    return 0
  fi

  if [ "$CHECK_ONLY" = "1" ]; then
    printf "${DIM}(--check: nothing changed; image availability and revision are verified when updating)${RESET}\n"
    return 0
  fi

  load_image_helper
  CANDIDATE_DIR="$STAGING_DIR"
  acquire_install_lock "$SOTTO_DIR" || fail "Update is locked. Configuration has not changed."
  revision=$(resolve_images "$target") || fail "Could not verify the requested release. Configuration has not changed."
  target="${revision:0:8}"
  # Old installers pinned latest. Record the running immutable revision so a
  # rollback cannot accidentally pull the newly published release again.
  if [ "$from" = latest ]; then
    previous_revision=$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$(compose ps -q web)") ||
      fail "Cannot identify the previous release. Start the existing web container before updating."
    [[ "$previous_revision" =~ ^[0-9a-f]{8}([0-9a-f]{32})?$ ]] || fail "The previous release has no valid revision."
    from="${previous_revision:0:8}"
  fi
  if [ "$from" = "$target" ] && [ "${running:-}" = "$target" ]; then
    ok "Already running ${target}; nothing to do."
    return 0
  fi

  if [ "$BACKUP" = "1" ]; then
    backup_database
  fi

  info "Downloading configuration for release ${target}..."
  source_base="${SOTTO_RAW_BASE:-https://raw.githubusercontent.com/${SOTTO_REPOSITORY}/${revision}}"
  curl -fsSL "$source_base/docker-compose.selfhost.yml" -o "$STAGING_DIR/docker-compose.yml" || fail "Could not download release Compose configuration."
  curl -fsSL "$source_base/scripts/agent/sync-cli-credentials.sh" -o "$STAGING_DIR/sync-cli-credentials.sh" || fail "Could not download release credential synchronization."
  curl -fsSL "$source_base/scripts/selfhost/images.sh" -o "$STAGING_DIR/images.sh" || fail "Could not download release image verification helper."
  cp "$SOTTO_DIR/.env" "$STAGING_DIR/.env"
  [ ! -f "$SOTTO_DIR/docker-compose.override.yml" ] || cp "$SOTTO_DIR/docker-compose.override.yml" "$STAGING_DIR/docker-compose.override.yml"
  install_dir="$SOTTO_DIR"
  SOTTO_DIR="$STAGING_DIR"
  set_env_value SOTTO_IMAGE_TAG "$target"
  set_env_value SOTTO_PREVIOUS_IMAGE_TAG "$from"
  # --env-file controls interpolation; service env_file paths still resolve
  # relative to --project-directory. Add the staged base environment before
  # user overrides so their env_file and environment settings retain priority.
  write_candidate_env "$STAGING_DIR"
  cd "$STAGING_DIR"
  candidate_compose config --quiet || fail "Release configuration is invalid. Existing configuration has not changed."
  info "Pulling images..."
  candidate_compose pull || fail "Could not pull images tagged ${target}. Existing configuration has not changed.\n  Published tags: ${BOLD}https://github.com/${SOTTO_REPOSITORY}/pkgs/container/sotto-web${RESET}"
  freeze_candidate_config || fail "Candidate configuration could not be frozen. Existing configuration has not changed."
  pin_candidate_images || fail "Candidate images or runtime settings changed after verification. Existing configuration has not changed."

  info "Applying database migrations and updating the language curriculum..."
  candidate_compose run --rm --no-deps workers sh -c \
    "cd /app && npx --no-install prisma migrate deploy --config=/app/prisma.config.ts && npx --no-install tsx apps/web/prisma/seed-curriculum.ts" ||
    fail "Database initialization failed. Existing configuration and rollback history have not changed. Inspect the migration or curriculum error before retrying."
  candidate_compose run --rm --no-deps web node dist/access.cjs initialize ||
    fail "Sidedoor conversion failed. Existing services remain active. Inspect the conversion error before retrying."

  SOTTO_DIR="$install_dir"
  cd "$SOTTO_DIR"
  mkdir -p "$SOTTO_DIR/previous"
  for file in .env docker-compose.yml sync-cli-credentials.sh images.sh docker-compose.override.yml; do
    rm -f "$SOTTO_DIR/previous/$file"
    [ ! -f "$SOTTO_DIR/$file" ] || cp "$SOTTO_DIR/$file" "$SOTTO_DIR/previous/$file"
  done
  # Keep rollback immutable when an installation currently tracks latest.
  SOTTO_DIR="$install_dir/previous"
  set_env_value SOTTO_IMAGE_TAG "$from"
  SOTTO_DIR="$install_dir"
  for file in .env docker-compose.yml sync-cli-credentials.sh images.sh; do
    cp "$STAGING_DIR/$file" "$SOTTO_DIR/$file"
  done

  info "Restarting Sotto..."
  candidate_compose up -d --pull never

  printf "${CYAN}${BOLD}>${RESET} Waiting for health"
  local response=""
  for _ in $(seq 1 45); do
    if response=$(health) && release_healthy "$response" "$target" "$(sed -n '1p' "$STAGING_DIR/resolved-image-ids")"; then break; fi
    response=""
    printf '.'
    sleep 2
  done
  printf '\n'

  if [ -n "$response" ]; then
    candidate_compose run --rm --no-deps web node dist/access.cjs finalize ||
      fail "Sidedoor finalization failed. Source state remains available for rollback. Inspect the error before retrying."
    ok "Sotto is up on ${target}: ${response}"
  else
    fail "Sotto did not report healthy at http://localhost:$(web_port)\n  Logs:     ${BOLD}cd ${SOTTO_DIR} && docker compose logs --tail 50 web${RESET}\n  Roll back: ${BOLD}sotto-host rollback${RESET}"
  fi
}

cmd_rollback() {
  require_install
  cd "$SOTTO_DIR"

  local previous CANDIDATE_DIR="" install_dir="$SOTTO_DIR"
  previous=$(env_value SOTTO_PREVIOUS_IMAGE_TAG)
  [ -n "$previous" ] || fail "No previous tag recorded; nothing to roll back to.\n  Pin one yourself: ${BOLD}sotto-host update --to <commit>${RESET}"

  info "Rolling back $(current_tag) → ${previous}"
  load_image_helper
  acquire_install_lock "$SOTTO_DIR" || fail "Rollback is locked. Configuration has not changed."
  resolve_images "$previous" >/dev/null || fail "Cannot pull the previous release. Configuration has not changed."
  if [ -f "$SOTTO_DIR/previous/docker-compose.yml" ]; then
    local rollback_dir="$STAGING_DIR/rollback" key current_assignment previous_assignment
    mkdir "$rollback_dir"
    CANDIDATE_DIR="$rollback_dir"
    for file in .env docker-compose.yml sync-cli-credentials.sh images.sh docker-compose.override.yml; do
      [ ! -f "$SOTTO_DIR/previous/$file" ] || cp "$SOTTO_DIR/previous/$file" "$rollback_dir/$file"
    done
    for key in BYOK_ENCRYPTION_KEY SOTTO_SPEAKING_REFERENCE_KEYRING; do
      current_assignment=$(strict_env_assignment "$SOTTO_DIR/.env" "$key") ||
        fail "Current key configuration is ambiguous. Configuration has not changed."
      previous_assignment=$(strict_env_assignment "$rollback_dir/.env" "$key") ||
        fail "Saved key configuration is unavailable or ambiguous. Configuration has not changed."
      if [ "$key" = BYOK_ENCRYPTION_KEY ]; then
        case "$current_assignment" in absent|present:|present:'""'|"present:''")
          fail "Current encryption key is unavailable. Configuration has not changed." ;;
        esac
      fi
      [ "$current_assignment" = "$previous_assignment" ] ||
        fail "Saved encryption settings differ from the current installation. Configuration has not changed."
    done
    write_candidate_env "$rollback_dir"
    freeze_candidate_config ||
      fail "Saved configuration could not be frozen. Configuration has not changed."
    verify_rollback_effective_keys "$rollback_dir" ||
      fail "Running and saved encryption settings could not be verified. Configuration has not changed."
    pin_candidate_images 2>/dev/null ||
      fail "Saved image configuration could not be verified. Configuration has not changed."
    for file in .env docker-compose.yml sync-cli-credentials.sh images.sh docker-compose.override.yml; do
      if [ -f "$rollback_dir/$file" ]; then
        cp "$rollback_dir/$file" "$SOTTO_DIR/$file"
      elif [ "$file" = docker-compose.override.yml ]; then
        rm -f "$SOTTO_DIR/$file"
      fi
    done
  else
    set_env_value SOTTO_IMAGE_TAG "$previous"
  fi
  if [ -n "$CANDIDATE_DIR" ]; then
    candidate_compose up -d --pull never
  else
    compose up -d
  fi

  # A rollback does not undo migrations: Prisma migrations are forward-only, so
  # the older image runs against the newer schema. Say so rather than imply the
  # database moved back too.
  warn "Images rolled back. Database migrations are forward-only and were not reverted."
  for _ in $(seq 1 45); do
    if response=$(health) && release_healthy "$response" "$previous" "$(sed -n '1p' "$STAGING_DIR/resolved-image-ids")"; then
      set_env_value SOTTO_PREVIOUS_IMAGE_TAG ""
      ok "Sotto is on ${previous}."
      return 0
    fi
    sleep 2
  done
  fail "The previous release did not become healthy. Inspect docker compose logs."
}

CHECK_ONLY=0
BACKUP=1
TO_REF=""
command=${1:-help}
shift || true
if [ "$command" = access ]; then
  cmd_access "$@"
  exit
fi
while [ $# -gt 0 ]; do
  argument=$1
  shift
  case "$argument" in
    --check) CHECK_ONLY=1 ;;
    --no-backup) BACKUP=0 ;;
    --to)
      TO_REF=${1:?--to needs a version, commit, or 'latest'}
      shift
      ;;
    --to=*) TO_REF=${argument#--to=} ;;
    *) fail "unknown option ${argument}" ;;
  esac
done

case "$command" in
  update) cmd_update ;;
  status) cmd_status ;;
  rollback) cmd_rollback ;;
  help | -h | --help) usage ;;
  *)
    printf "sotto-host: unknown command %s\n" "$command" >&2
    usage >&2
    exit 1
    ;;
esac
