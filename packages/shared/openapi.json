{
  "openapi": "3.0.3",
  "info": {
    "title": "Sotto API",
    "version": "0.0.1",
    "description": "Core /api/v1 surface consumed by the Sotto terminal client. Generated from the Zod contract registry in @sotto/shared."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A long-lived Sotto API key (sk_sotto_...) minted via /api/v1/auth/pair/redeem."
      }
    },
    "schemas": {
      "CefrLevel": {
        "type": "string",
        "enum": [
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "C2"
        ]
      },
      "PracticeKind": {
        "type": "string",
        "enum": [
          "GRAMMAR",
          "READING",
          "LISTENING",
          "SPEAKING",
          "WRITING",
          "VOCAB"
        ]
      },
      "PracticeStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "COMPLETED"
        ]
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "USER",
          "ADMIN"
        ]
      },
      "HealthCheckResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "latencyMs": {
            "type": "number"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded"
            ]
          },
          "timestamp": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthCheckResult"
            }
          },
          "oauth": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "vapid": {
            "type": "boolean"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "required": [
          "status",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "CourseSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nativeLang": {
            "type": "string"
          },
          "targetLang": {
            "type": "string"
          },
          "currentLevel": {
            "$ref": "#/components/schemas/CefrLevel"
          },
          "startLevel": {
            "$ref": "#/components/schemas/CefrLevel"
          },
          "activeClassId": {
            "type": "string",
            "nullable": true
          },
          "curriculum": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          },
          "placement": {
            "type": "object",
            "properties": {
              "level": {
                "$ref": "#/components/schemas/CefrLevel"
              },
              "createdAt": {
                "type": "string"
              }
            },
            "required": [
              "level",
              "createdAt"
            ],
            "additionalProperties": false,
            "nullable": true
          }
        },
        "required": [
          "id",
          "nativeLang",
          "targetLang",
          "currentLevel",
          "startLevel",
          "activeClassId",
          "curriculum",
          "placement"
        ],
        "additionalProperties": false
      },
      "CoursesListResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseSummary"
            }
          }
        },
        "required": [
          "courses"
        ],
        "additionalProperties": false
      },
      "PracticeRecentSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PracticeKind"
          },
          "status": {
            "$ref": "#/components/schemas/PracticeStatus"
          },
          "score": {
            "type": "number",
            "nullable": true
          },
          "startedAt": {
            "type": "string"
          },
          "completedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "score",
          "startedAt",
          "completedAt"
        ],
        "additionalProperties": false
      },
      "PracticeOverviewResponse": {
        "type": "object",
        "properties": {
          "due": {
            "type": "object",
            "properties": {
              "vocab": {
                "type": "number"
              },
              "grammar": {
                "type": "number"
              }
            },
            "required": [
              "vocab",
              "grammar"
            ],
            "additionalProperties": false
          },
          "totalVocab": {
            "type": "number"
          },
          "recent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PracticeRecentSession"
            }
          }
        },
        "required": [
          "due",
          "totalVocab",
          "recent"
        ],
        "additionalProperties": false
      },
      "PracticeItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "prompt",
          "options"
        ],
        "additionalProperties": false
      },
      "PracticeSpeakingPrompt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "targetPhrase": {
            "type": "string"
          },
          "translation": {
            "type": "string"
          },
          "referenceTtsUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "targetPhrase",
          "translation",
          "referenceTtsUrl"
        ],
        "additionalProperties": false
      },
      "PracticeWritingPrompt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "guidance": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "task",
          "guidance"
        ],
        "additionalProperties": false
      },
      "StartPracticeRequest": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/PracticeKind"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      "StartPracticeUnavailable": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "unavailable"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "not_enough_vocab",
              "nothing_due",
              "no_content"
            ]
          }
        },
        "required": [
          "status",
          "reason"
        ],
        "additionalProperties": false
      },
      "StartPracticeReady": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          },
          "sessionId": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PracticeKind"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PracticeItem"
            }
          },
          "episodeId": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "sessionId",
          "kind",
          "items"
        ],
        "additionalProperties": false
      },
      "StartPracticeReadySpeaking": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready_speaking"
            ]
          },
          "sessionId": {
            "type": "string"
          },
          "prompts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PracticeSpeakingPrompt"
            }
          }
        },
        "required": [
          "status",
          "sessionId",
          "prompts"
        ],
        "additionalProperties": false
      },
      "StartPracticeReadyWriting": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready_writing"
            ]
          },
          "sessionId": {
            "type": "string"
          },
          "prompts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PracticeWritingPrompt"
            }
          }
        },
        "required": [
          "status",
          "sessionId",
          "prompts"
        ],
        "additionalProperties": false
      },
      "StartPracticeResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/StartPracticeUnavailable"
          },
          {
            "$ref": "#/components/schemas/StartPracticeReady"
          },
          {
            "$ref": "#/components/schemas/StartPracticeReadySpeaking"
          },
          {
            "$ref": "#/components/schemas/StartPracticeReadyWriting"
          }
        ],
        "discriminator": {
          "propertyName": "status",
          "mapping": {
            "unavailable": "#/components/schemas/StartPracticeUnavailable",
            "ready": "#/components/schemas/StartPracticeReady",
            "ready_speaking": "#/components/schemas/StartPracticeReadySpeaking",
            "ready_writing": "#/components/schemas/StartPracticeReadyWriting"
          }
        }
      },
      "SubmitPracticeRequest": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "itemId": {
                  "type": "string",
                  "minLength": 1
                },
                "selectedIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "itemId",
                "selectedIndex"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "answers"
        ],
        "additionalProperties": false
      },
      "SubmitPracticeResponse": {
        "type": "object",
        "properties": {
          "score": {
            "type": "number"
          },
          "correct": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "score",
          "correct",
          "total"
        ],
        "additionalProperties": false
      },
      "EpisodeStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "DISCOVERING",
          "EXTRACTING",
          "RESEARCHING",
          "PLANNING",
          "SCRIPTING",
          "COMPILING",
          "SCRIPT_READY",
          "GENERATING_AUDIO",
          "STITCHING",
          "READY",
          "UPDATING",
          "FAILED",
          "IMPORTING",
          "TRANSCRIBING"
        ]
      },
      "EpisodeSegment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "audioUrl": {
            "type": "string",
            "nullable": true
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "startTime": {
            "type": "number",
            "nullable": true
          },
          "duration": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "id",
          "speaker",
          "text",
          "audioUrl",
          "order",
          "startTime",
          "duration"
        ],
        "additionalProperties": {}
      },
      "EpisodeDetailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/EpisodeStatus"
          },
          "audioUrl": {
            "type": "string",
            "nullable": true
          },
          "duration": {
            "type": "number",
            "nullable": true
          },
          "language": {
            "type": "string",
            "nullable": true
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EpisodeSegment"
            }
          }
        },
        "required": [
          "id",
          "title",
          "status",
          "audioUrl",
          "duration",
          "language",
          "segments"
        ],
        "additionalProperties": {}
      },
      "SpeakingGradeStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "GRADING",
          "SCORED",
          "FAILED"
        ]
      },
      "SpeakingPollResponse": {
        "type": "object",
        "properties": {
          "status": {
            "$ref": "#/components/schemas/SpeakingGradeStatus"
          },
          "overallScore": {
            "type": "number",
            "nullable": true
          },
          "transcript": {
            "type": "string",
            "nullable": true
          },
          "feedback": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "status",
          "overallScore",
          "transcript",
          "feedback"
        ],
        "additionalProperties": {}
      },
      "RedeemPairingRequest": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 10,
            "maxLength": 256
          }
        },
        "required": [
          "token"
        ],
        "additionalProperties": false
      },
      "RedeemPairingResponse": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string"
          },
          "user": {
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/PairedUser"
              }
            ]
          }
        },
        "required": [
          "token",
          "user"
        ],
        "additionalProperties": false
      },
      "PairedUser": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "nullable": true
          },
          "email": {
            "type": "string"
          },
          "handle": {
            "type": "string",
            "nullable": true
          },
          "image": {
            "type": "string",
            "nullable": true
          },
          "role": {
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "required": [
          "id",
          "name",
          "email",
          "handle",
          "image",
          "role"
        ],
        "additionalProperties": false
      }
    }
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "operationId": "health",
        "summary": "Liveness and dependency health for the instance.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "503": {
            "description": "Degraded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/courses": {
      "get": {
        "operationId": "listCourses",
        "summary": "List the authenticated learner's courses.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CoursesListResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/courses/{courseId}/practice": {
      "get": {
        "operationId": "getPracticeOverview",
        "summary": "Due counts per skill, total vocab, and recent practice sessions.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PracticeOverviewResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ]
      },
      "post": {
        "operationId": "startPractice",
        "summary": "Start an ungated, single-skill practice session.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartPracticeResponse"
                }
              }
            }
          },
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StartPracticeResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "courseId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StartPracticeRequest"
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/practice/{sessionId}/submit": {
      "post": {
        "operationId": "submitPractice",
        "summary": "Grade a practice session and update spaced-repetition state.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmitPracticeResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitPracticeRequest"
              }
            }
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/episodes/{episodeId}": {
      "get": {
        "operationId": "getEpisode",
        "summary": "Episode detail with ordered segments and playable audio URLs.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EpisodeDetailResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "episodeId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/practice/{sessionId}/speaking/{promptId}": {
      "get": {
        "operationId": "pollSpeaking",
        "summary": "Poll grading status for an uploaded speaking attempt.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SpeakingPollResponse"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "promptId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "recordingId",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ]
      }
    },
    "/api/v1/auth/pair/redeem": {
      "post": {
        "operationId": "redeemPairingToken",
        "summary": "Exchange a single-use pairing token for a long-lived API key.",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RedeemPairingResponse"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RedeemPairingRequest"
              }
            }
          }
        }
      }
    }
  }
}
