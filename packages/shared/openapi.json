{
  "openapi": "3.0.3",
  "info": {
    "title": "Sotto API",
    "version": "0.0.1",
    "description": "Core /api/v1 surface consumed by the Sotto terminal client. Generated from the Zod contract registry in @sotto/shared."
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A long-lived Sotto API key (sk_sotto_...) minted via /api/v1/auth/pair/redeem."
      }
    },
    "schemas": {
      "CefrLevel": {
        "type": "string",
        "enum": [
          "A1",
          "A2",
          "B1",
          "B2",
          "C1",
          "C2"
        ]
      },
      "PracticeKind": {
        "type": "string",
        "enum": [
          "GRAMMAR",
          "READING",
          "LISTENING",
          "SPEAKING",
          "WRITING",
          "VOCAB"
        ]
      },
      "PracticeStatus": {
        "type": "string",
        "enum": [
          "ACTIVE",
          "COMPLETED"
        ]
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "USER",
          "ADMIN"
        ]
      },
      "HealthCheckResult": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string"
          },
          "latencyMs": {
            "type": "number"
          },
          "detail": {
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "additionalProperties": false
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "degraded"
            ]
          },
          "timestamp": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "checks": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/components/schemas/HealthCheckResult"
            }
          },
          "oauth": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "vapid": {
            "type": "boolean"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          }
        },
        "required": [
          "status",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "CourseSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "nativeLang": {
            "type": "string"
          },
          "targetLang": {
            "type": "string"
          },
          "currentLevel": {
            "$ref": "#/components/schemas/CefrLevel"
          },
          "startLevel": {
            "$ref": "#/components/schemas/CefrLevel"
          },
          "activeClassId": {
            "type": "string",
            "nullable": true
          },
          "curriculum": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string"
              }
            },
            "required": [
              "title"
            ],
            "additionalProperties": false
          },
          "placement": {
            "type": "object",
            "properties": {
              "level": {
                "$ref": "#/components/schemas/CefrLevel"
              },
              "createdAt": {
                "type": "string"
              }
            },
            "required": [
              "level",
              "createdAt"
            ],
            "additionalProperties": false,
            "nullable": true
          }
        },
        "required": [
          "id",
          "nativeLang",
          "targetLang",
          "currentLevel",
          "startLevel",
          "activeClassId",
          "curriculum",
          "placement"
        ],
        "additionalProperties": false
      },
      "CoursesListResponse": {
        "type": "object",
        "properties": {
          "courses": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CourseSummary"
            }
          }
        },
        "required": [
          "courses"
        ],
        "additionalProperties": false
      },
      "PracticeRecentSession": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PracticeKind"
          },
          "status": {
            "$ref": "#/components/schemas/PracticeStatus"
          },
          "score": {
            "type": "number",
            "nullable": true
          },
          "startedAt": {
            "type": "string"
          },
          "completedAt": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "kind",
          "status",
          "score",
          "startedAt",
          "completedAt"
        ],
        "additionalProperties": false
      },
      "PracticeOverviewResponse": {
        "type": "object",
