              "unavailable"
            ]
          },
          "reason": {
            "type": "string",
            "enum": [
              "not_enough_vocab",
              "nothing_due",
              "no_content"
            ]
          }
        },
        "required": [
          "status",
          "reason"
        ],
        "additionalProperties": false
      },
      "StartPracticeReady": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready"
            ]
          },
          "sessionId": {
            "type": "string"
          },
          "kind": {
            "$ref": "#/components/schemas/PracticeKind"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PracticeItem"
            }
          },
          "episodeId": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "sessionId",
          "kind",
          "items"
        ],
        "additionalProperties": false
      },
      "StartPracticeReadySpeaking": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready_speaking"
            ]
          },
          "sessionId": {
            "type": "string"
          },
          "prompts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PracticeSpeakingPrompt"
            }
          }
        },
        "required": [
          "status",
          "sessionId",
          "prompts"
        ],
        "additionalProperties": false
      },
      "StartPracticeReadyWriting": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ready_writing"
            ]
          },
          "sessionId": {
            "type": "string"
          },
          "prompts": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PracticeWritingPrompt"
            }
          }
        },
        "required": [
          "status",
          "sessionId",
          "prompts"
        ],
        "additionalProperties": false
      },
      "StartPracticeResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/StartPracticeUnavailable"
          },
          {
            "$ref": "#/components/schemas/StartPracticeReady"
          },
          {
            "$ref": "#/components/schemas/StartPracticeReadySpeaking"
          },
          {
            "$ref": "#/components/schemas/StartPracticeReadyWriting"
          }
        ],
        "discriminator": {
          "propertyName": "status",
          "mapping": {
            "unavailable": "#/components/schemas/StartPracticeUnavailable",
            "ready": "#/components/schemas/StartPracticeReady",
            "ready_speaking": "#/components/schemas/StartPracticeReadySpeaking",
            "ready_writing": "#/components/schemas/StartPracticeReadyWriting"
          }
        }
      },
      "SubmitPracticeRequest": {
        "type": "object",
        "properties": {
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "itemId": {
                  "type": "string",
                  "minLength": 1
                },
                "selectedIndex": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "itemId",
                "selectedIndex"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "answers"
        ],
        "additionalProperties": false
      },
      "SubmitPracticeResponse": {
        "type": "object",
        "properties": {
          "score": {
            "type": "number"
          },
          "correct": {
            "type": "number"
          },
          "total": {
            "type": "number"
          }
        },
        "required": [
          "score",
          "correct",
          "total"
        ],
        "additionalProperties": false
      },
      "EpisodeStatus": {
        "type": "string",
        "enum": [
          "PENDING",
          "DISCOVERING",
          "EXTRACTING",
          "RESEARCHING",
          "PLANNING",
          "SCRIPTING",
          "COMPILING",
          "SCRIPT_READY",
          "GENERATING_AUDIO",
          "STITCHING",
          "READY",
          "UPDATING",
          "FAILED",
          "IMPORTING",
          "TRANSCRIBING"
