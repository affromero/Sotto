          "text": {
            "type": "string"
          },
          "audioUrl": {
            "type": "string",
            "nullable": true
          },
          "order": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "startTime": {
            "type": "number",
            "nullable": true
          },
          "duration": {
            "type": "number",
            "nullable": true
          }
        },
        "required": [
          "id",
          "speaker",
          "text",
          "audioUrl",
          "order",
          "startTime",
          "duration"
        ],
        "additionalProperties": {}
      },
      "EpisodeDetailResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/EpisodeStatus"
          },
          "audioUrl": {
            "type": "string",
            "nullable": true
          },
          "duration": {
            "type": "number",
            "nullable": true
          },
          "language": {
            "type": "string",
            "nullable": true
          },
          "segments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/EpisodeSegment"
