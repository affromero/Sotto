                "type": "number"
              },
              "grammar": {
                "type": "number"
              }
            },
            "required": [
              "vocab",
              "grammar"
            ],
            "additionalProperties": false
          },
          "totalVocab": {
            "type": "number"
          },
          "recent": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PracticeRecentSession"
            }
          }
        },
        "required": [
          "due",
          "totalVocab",
          "recent"
        ],
        "additionalProperties": false
      },
      "PracticeItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "prompt": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "prompt",
          "options"
        ],
        "additionalProperties": false
      },
      "PracticeSpeakingPrompt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "targetPhrase": {
            "type": "string"
          },
          "translation": {
            "type": "string"
          },
          "referenceTtsUrl": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "targetPhrase",
          "translation",
          "referenceTtsUrl"
        ],
        "additionalProperties": false
      },
      "PracticeWritingPrompt": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "guidance": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "task",
          "guidance"
        ],
        "additionalProperties": false
      },
      "StartPracticeRequest": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/PracticeKind"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      },
      "StartPracticeUnavailable": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
