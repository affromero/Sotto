{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "noEmit": false,
    "declaration": true,
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ESNext"],
    "types": ["node"],
    "jsx": "preserve"
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
