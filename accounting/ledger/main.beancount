option "title" "Sotto Financial Ledger"
option "operating_currency" "USD"

; Chart of accounts
include "accounts.beancount"

; Opening balances and initial transactions
include "opening.beancount"

; Monthly transaction files
include "2026/02-february.beancount"
include "2026/03-march.beancount"
