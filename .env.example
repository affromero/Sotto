# ============================================
# SOTTO ENVIRONMENT CONFIGURATION
# ============================================
#
# PRODUCTION: Secrets are managed via Doppler (project: sotto, config: prd).
# The deploy workflow runs `doppler secrets download` to generate .env on every deploy.
# To edit production secrets: https://dashboard.doppler.com/workplace/projects/sotto/configs/prd
#
# LOCAL DEV: Copy this file to .env and fill in values, or run `npm run setup`.
#
# LEGEND:
#   [AUTO]     - Configured automatically by setup script
#   [OPTIONAL] - Not required for local development
#   [REQUIRED] - You MUST set this manually for the feature to work
#
# ============================================


# ============================================
# AUTO-CONFIGURED BY SETUP SCRIPT
# ============================================

# [AUTO] Database - Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sotto?schema=public"

# [AUTO] Redis - Local Redis server
REDIS_URL="redis://localhost:6379"

# [REQUIRED in production] Redis password — protects Redis from unauthorized access
# Generate with: openssl rand -hex 32
# REDIS_PASSWORD=generate-with-openssl-rand-hex-32

# [AUTO] NextAuth Secret - Secure session encryption
# Auto-generated with: openssl rand -base64 32
# AUTH_SECRET is required by next-auth v5; NEXTAUTH_SECRET kept for middleware compat
AUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# [AUTO] BYOK Encryption Key - AES-256-GCM encryption for user API keys
# Generate with: openssl rand -hex 32
BYOK_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# [AUTO] App URL
NEXTAUTH_URL="http://localhost:3000"


# Investor pitch password
# PITCH_PASSWORD=your-investor-pitch-password

# Admin emails (comma-separated) — users with these emails get ADMIN role automatically
# ADMIN_EMAILS=admin@example.com

# Admin report API key — used by /traffic-report skill to pull analytics from prod.
# Generate with: openssl rand -hex 32
# ADMIN_REPORT_KEY=xxxxxxxxxxxxxxxxxxxxx


# ============================================
# PROVIDER SELECTION [OPTIONAL]
# ============================================
# Change these to swap external service providers.
# Default values work out of the box with the standard stack.

# Worker profile: all (default) | heavy | pipeline | light
# Controls which BullMQ workers start in this process.
# In production, three containers run with heavy/pipeline/light profiles.
# WORKER_PROFILE=all

# AI Provider: anthropic (default) | openai | claude-code
# AI_PROVIDER=anthropic

# Claude Code CLI model (only used when AI_PROVIDER=claude-code)
# Options: opus (default), sonnet, haiku
# CLAUDE_CODE_MODEL=opus

# Claude Code CLI credentials (JSON from ~/.claude/.credentials.json).
# Required for claude-code:* models to work in Docker — no volume mount needed.
# Obtain: cat ~/.claude/.credentials.json
# Store in Doppler: doppler secrets set CLAUDE_CODE_CREDENTIALS_JSON="$(cat ~/.claude/.credentials.json)"
# CLAUDE_CODE_CREDENTIALS_JSON=

# TTS Provider: elevenlabs (default) | openai | cartesia | fal | replicate
# TTS_PROVIDER=elevenlabs

# Cartesia (Sonic 3) - Premium low-latency TTS with emotion support
# Get yours at: https://play.cartesia.ai/keys
# CARTESIA_API_KEY=sk_car_xxxxxxxxxxxxxxxxxxxxx

# Fal.ai (Qwen3-TTS) — Open-source TTS via Fal serverless
# Also powers MiniMax Speech-02 HD (minimax provider)
# Get yours at: https://fal.ai/dashboard/keys
# FAL_KEY=fal_sk_xxxxxxxxxxxxxxxxxxxxx

# MiniMax - AI video generation (T2V-01, Hailuo-02, Hailuo-2.3)
# Used as an alternative to FAL for text-to-video generation
# Get yours at: https://www.minimax.io/platform
# MINIMAX_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# HeyGen - AI avatar lip-sync video generation
# Used for avatar overlays on podcast videos (stock avatars, green screen)
# Get yours at: https://app.heygen.com/settings/developer
# HEYGEN_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Runway - AI avatar lip-sync video generation (realtime)
# Used for avatar overlays on podcast videos (preset avatars, scene background)
# Get yours at: https://dev.runwayml.com
# RUNWAY_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Replicate - Open-source TTS via Replicate
# Get yours at: https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxx

# Mistral (Voxtral) - Premium neural TTS with voice cloning
# Get yours at: https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Storage Provider: r2 (default) | s3 | local
# STORAGE_PROVIDER=r2

# Payment Provider: stripe (default) | none
# PAYMENT_PROVIDER=stripe


# ============================================
# VOICE VERIFICATION [OPTIONAL]
# ============================================

# [OPTIONAL] Path to sherpa-onnx speaker recognition model
# Download with: bash scripts/download-speaker-model.sh
SHERPA_ONNX_MODEL_PATH=./models/wespeaker_en_voxceleb_CAM++_LM.onnx


# ============================================
# AI SERVICES [REQUIRED for podcast generation]
# ============================================

# Anthropic Claude (default AI_PROVIDER) - Discovery chat, script generation, Q&A
# Get yours at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# OpenAI (alternative AI_PROVIDER) - GPT-5 for script generation
# Get yours at: https://platform.openai.com/
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-5

# Google Gemini (alternative AI_PROVIDER) - Gemini models with 1M context
# Get yours at: https://aistudio.google.com/apikey
# GOOGLE_AI_API_KEY=AIza...

# ============================================
# CONTENT SAFETY [OPTIONAL]
# ============================================
# OpenAI Moderation API key — screens user input/output for policy violations.
# Uses the free omni-moderation-latest model (13 categories).
# Fail-open: if unset or unavailable, content passes through unscreened.
# Get yours at: https://platform.openai.com/
# OPENAI_MODERATION_KEY=sk-xxxxxxxxxxxxxxxxxxxxx


# ElevenLabs (default TTS_PROVIDER) - Multi-voice TTS for podcast audio
# Get yours at: https://elevenlabs.io/
# ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Voice IDs for podcast speakers (overrides voice pool selection)
# Browse voices at: https://elevenlabs.io/voice-library
# ELEVENLABS_HOST_VOICE_ID=xxxxxxxxxxxxx
# ELEVENLABS_EXPERT_VOICE_ID=xxxxxxxxxxxxx

# Hume AI (Octave) — Ultra-quality expressive TTS with emotional intelligence
# Get yours at: https://platform.hume.ai/settings/keys
# HUME_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# yt-dlp — Path to yt-dlp binary for YouTube/Twitter video download fallback
# Install: brew install yt-dlp (macOS) or pip install yt-dlp
# YT_DLP_PATH=yt-dlp

# Together AI — Cheap Whisper STT at $0.0015/min
# Get yours at: https://api.together.xyz/settings/api-keys
# TOGETHER_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Deepgram — Nova-3 STT ($200 free credits)
# Get yours at: https://console.deepgram.com/
# DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# AssemblyAI — Universal-2 STT ($50 free credits)
# Get yours at: https://www.assemblyai.com/app
# ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Pinchtab — headless Chrome fallback for content extraction (JS-rendered pages)
# Points to the pinchtab container in docker-compose
# PINCHTAB_URL=http://localhost:9867
# PINCHTAB_TOKEN=

# OpenAlex polite pool email — provides higher rate limits for reference verification
# OPENALEX_EMAIL=hello@sotto.fm


# ============================================
# OAUTH PROVIDERS [OPTIONAL]
# ============================================
# Enable social login with Google, GitHub, and Apple.
# Auth buttons only appear for providers with credentials configured.

# Google OAuth - https://console.cloud.google.com/apis/credentials
# 1. Create project → Credentials → OAuth client ID → Web application
# 2. Authorized JS origins: https://sotto.fm (or http://localhost:3000 for dev)
# 3. Authorized redirect URI: https://sotto.fm/api/auth/callback/google
# 4. Also configure OAuth consent screen (APIs & Services → OAuth consent screen)
# GOOGLE_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxx
# Google iOS client ID (for mobile app OAuth code exchange — native public client)
# GOOGLE_IOS_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com

# GitHub OAuth - https://github.com/settings/developers
# 1. New OAuth App → Homepage URL: https://sotto.fm
# 2. Authorization callback URL: https://sotto.fm/api/auth/callback/github
# GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx

# Apple Sign In (web + iOS) - https://developer.apple.com/
# Requires Apple Developer account ($99/year).
# 1. Register App ID with "Sign In with Apple" capability
# 2. Register Services ID (= Client ID), configure domain + return URL:
#    Domain: sotto.fm | Return URL: https://sotto.fm/api/auth/callback/apple
# 3. Create Key with "Sign In with Apple" → download .p8 → generate JWT secret
# APPLE_CLIENT_ID=com.sotto.app
# APPLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx

# Twitter/X OAuth 2.0 - https://developer.twitter.com/en/portal/dashboard
# Used for "Connect Twitter" in user settings (NextAuth provider)
# TWITTER_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxx
# TWITTER_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx


# ============================================
# TWITTER @SOTTOFM BOT [OPTIONAL]
# ============================================
# Enable tweet-to-podcast: users tag @sottofm to generate podcasts.
# Requires Twitter API v2 Basic tier ($100/mo).

# Bearer token for reading mentions (app-only auth)
# TWITTER_BEARER_TOKEN=xxxxxxxxxxxxxxxxxxxxx

# OAuth 1.0a credentials for posting replies as @sottofm
# TWITTER_API_KEY=xxxxxxxxxxxxxxxxxxxxx
# TWITTER_API_SECRET=xxxxxxxxxxxxxxxxxxxxx
# TWITTER_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxx
# TWITTER_ACCESS_SECRET=xxxxxxxxxxxxxxxxxxxxx

# The Twitter numeric user ID for the @sottofm bot account
# Find via: https://tweeterid.com/
# TWITTER_SOTTO_USER_ID=xxxxxxxxxxxxxxxxxxxxx

# Polling interval in milliseconds (default: 60000 = 60s)
# TWITTER_POLL_INTERVAL_MS=60000


# ============================================
# TELEGRAM @SOTTOFMBOT [OPTIONAL]
# ============================================
# Enable Telegram-to-podcast: users message @SottoFMBot to generate podcasts.
# Create a bot via @BotFather on Telegram.

# Bot token from @BotFather
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Webhook mode (production): set both to enable instant updates via webhook.
# When set, the worker registers a webhook instead of polling.
# Generate secret with: openssl rand -hex 32
# IMPORTANT: Use the apex domain (sotto.fm), NOT www.sotto.fm.
# Cloudflare redirects www→apex (301) and Telegram webhooks don't follow redirects.
# TELEGRAM_WEBHOOK_URL=https://sotto.fm/api/telegram/webhook
# TELEGRAM_WEBHOOK_SECRET=generate-with-openssl-rand-hex-32

# Polling mode (dev): used when webhook vars are NOT set.
# Poll interval in milliseconds (default: 5000 = 5s)
# TELEGRAM_POLL_INTERVAL_MS=5000

# Long poll timeout in seconds — how long getUpdates blocks waiting for new updates (default: 2)
# TELEGRAM_POLL_TIMEOUT=2


# ============================================
# STRIPE PAYMENTS [OPTIONAL]
# ============================================
# Voice marketplace: per-podcast pricing with Stripe Connect.
# Voice owners connect their Stripe account to receive payouts (90%).
# Platform takes 10% via application_fee_amount.

# API Keys
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# Webhook Secret
# LOCAL: stripe listen --forward-to localhost:3000/api/stripe/webhooks
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Pro subscription price ID (create in Stripe Dashboard → Products)
# STRIPE_PRO_PRICE_ID=price_xxxxxxxxxxxxx

# ElevenLabs pricing tier for cost tracking: free | starter | creator | scale (default)
# ELEVENLABS_TIER=scale


# ============================================
# CLOUDFLARE R2 STORAGE [OPTIONAL]
# ============================================
# Podcast audio file storage.

# Cloudflare R2 (default STORAGE_PROVIDER)
# R2_ACCOUNT_ID=xxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxx
# R2_BUCKET_NAME=sotto-storage
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Cloudflare API token for R2 usage monitoring (Workers R2 Storage: Read + Account Analytics: Read)
# CF_API_TOKEN=xxxxxxxxxxxxx

# AWS S3 (alternative STORAGE_PROVIDER)
# AWS_ACCESS_KEY_ID=xxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxx
# AWS_S3_BUCKET=sotto-storage
# AWS_S3_REGION=us-east-1

# Local filesystem (development STORAGE_PROVIDER)
# LOCAL_STORAGE_DIR=/tmp/sotto-storage


# ============================================
# WEB PUSH NOTIFICATIONS [OPTIONAL]
# ============================================
# Generate VAPID keys with: npx web-push generate-vapid-keys

# NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxxxxxxx
# VAPID_PRIVATE_KEY=xxxxxxxxxxxxx
# VAPID_SUBJECT=mailto:hello@sotto.fm


# ============================================
# EMAIL (RESEND) [OPTIONAL]
# ============================================
# Waitlist welcome emails and weekly digests.
# Get yours at: https://resend.com/
# Note: Requires DNS domain verification for sotto.fm before sending from hello@sotto.fm.

# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# EMAIL_FROM=Sotto <hello@sotto.fm>


# ============================================
# MCP SERVER [OPTIONAL]
# ============================================
# Used by @sotto/mcp — the MCP server that lets AI assistants
# create and manage podcasts via Claude Desktop, Claude Code, etc.

# [REQUIRED for MCP] Sotto API key (create at sotto.fm/settings/api)
# SOTTO_API_KEY=sk_sotto_xxxxxxxxxxxxxxxxxxxxx

# [OPTIONAL] Override API base URL (defaults to https://sotto.fm)
# SOTTO_API_URL=http://localhost:3000


# ============================================
# E2E TESTING [LOCAL ONLY]
# ============================================
# Set these to redirect AI SDK calls to the LLMock server during E2E tests.
# Never set in Doppler dev/prd configs — local-only test vars.
# ANTHROPIC_BASE_URL=http://localhost:4100
# OPENAI_BASE_URL=http://localhost:4100
# GOOGLE_AI_BASE_URL=http://localhost:4100


# ============================================
# ERROR TRACKING & ANALYTICS [OPTIONAL]
# ============================================

# Sentry - https://sentry.io/
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# PostHog - https://posthog.com/
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com


# ============================================
# VIDEO GENERATION [OPTIONAL]
# ============================================

# Remotion — video rendering sidecar (internal Docker service)
# REMOTION_URL=http://remotion:3100

# Pexels — free stock video API for video generation visuals
# Get yours at: https://www.pexels.com/api/
# PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Hera — AI motion graphics for programmatic visual types (charts, quotes, timelines)
# Get yours at: https://hera.video or email support@hera.video
# HERA_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Mapbox — map visuals for geographic podcast content
# Get yours at: https://account.mapbox.com/access-tokens/
# MAPBOX_ACCESS_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxx
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.xxxxxxxxxxxxxxxxxxxxxxxx

# GeoNames — historical/modern place resolution (free)
# Register at: https://www.geonames.org/login
# GEONAMES_USERNAME=your_username
