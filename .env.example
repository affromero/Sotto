# ============================================
# SOTTO ENVIRONMENT CONFIGURATION
# ============================================
#
# QUICK START: Run `npm run setup` to auto-configure most variables.
#
# LEGEND:
#   [AUTO]     - Configured automatically by setup script
#   [OPTIONAL] - Not required for local development
#   [REQUIRED] - You MUST set this manually for the feature to work
#
# ============================================


# ============================================
# AUTO-CONFIGURED BY SETUP SCRIPT
# ============================================

# [AUTO] Database - Local PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sotto?schema=public"

# [AUTO] Redis - Local Redis server
REDIS_URL="redis://localhost:6379"

# [AUTO] NextAuth Secret - Secure session encryption
# Auto-generated with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"

# [AUTO] App URL
NEXTAUTH_URL="http://localhost:3000"


# ============================================
# PROVIDER SELECTION [OPTIONAL]
# ============================================
# Change these to swap external service providers.
# Default values work out of the box with the standard stack.

# AI Provider: anthropic (default) | openai
# AI_PROVIDER=anthropic

# TTS Provider: elevenlabs (default) | openai
# TTS_PROVIDER=elevenlabs

# Storage Provider: r2 (default) | s3 | local
# STORAGE_PROVIDER=r2

# Payment Provider: stripe (default) | none
# PAYMENT_PROVIDER=stripe


# ============================================
# AI SERVICES [REQUIRED for podcast generation]
# ============================================

# Anthropic Claude (default AI_PROVIDER) - Discovery chat, script generation, Q&A
# Get yours at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# OpenAI (alternative AI_PROVIDER) - GPT-4o for script generation
# Get yours at: https://platform.openai.com/
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-4o

# ElevenLabs (default TTS_PROVIDER) - Multi-voice TTS for podcast audio
# Get yours at: https://elevenlabs.io/
# ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Voice IDs for podcast speakers (overrides voice pool selection)
# Browse voices at: https://elevenlabs.io/voice-library
# ELEVENLABS_HOST_VOICE_ID=xxxxxxxxxxxxx
# ELEVENLABS_EXPERT_VOICE_ID=xxxxxxxxxxxxx


# ============================================
# OAUTH PROVIDERS [OPTIONAL]
# ============================================
# Enable social login with Google, GitHub, and Apple.

# Google OAuth - https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxx

# GitHub OAuth - https://github.com/settings/developers
# GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxxx
# GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx

# Apple Sign In (for iOS) - https://developer.apple.com/
# APPLE_CLIENT_ID=com.sotto.app
# APPLE_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx


# ============================================
# STRIPE PAYMENTS [OPTIONAL]
# ============================================
# Enable subscription billing.

# API Keys
# STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx
# STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxx

# Webhook Secret
# LOCAL: stripe listen --forward-to localhost:3000/api/webhooks/stripe
# STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxx

# Price IDs - Create 3 products:
# - Pro: $19/month (20 podcasts/month)
# - Team: $49/month (unlimited, 10 seats)
# STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxxx
# STRIPE_PRICE_ID_TEAM=price_xxxxxxxxxxxxx


# ============================================
# CLOUDFLARE R2 STORAGE [OPTIONAL]
# ============================================
# Podcast audio file storage.

# Cloudflare R2 (default STORAGE_PROVIDER)
# R2_ACCOUNT_ID=xxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxx
# R2_BUCKET_NAME=sotto-storage
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# AWS S3 (alternative STORAGE_PROVIDER)
# AWS_ACCESS_KEY_ID=xxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxx
# AWS_S3_BUCKET=sotto-storage
# AWS_S3_REGION=us-east-1

# Local filesystem (development STORAGE_PROVIDER)
# LOCAL_STORAGE_DIR=/tmp/sotto-storage


# ============================================
# WEB PUSH NOTIFICATIONS [OPTIONAL]
# ============================================
# Generate VAPID keys with: npx web-push generate-vapid-keys

# NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxxxxxxx
# VAPID_PRIVATE_KEY=xxxxxxxxxxxxx
# VAPID_SUBJECT=mailto:hello@sotto.fm


# ============================================
# ERROR TRACKING & ANALYTICS [OPTIONAL]
# ============================================

# Sentry - https://sentry.io/
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# PostHog - https://posthog.com/
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
