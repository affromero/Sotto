# ============================================
# SOTTO ENVIRONMENT CONFIGURATION
# ============================================
#
# PRODUCTION: Use your own secret manager or deployment platform env store.
# Generate a production .env from that system during deploy; do not commit it.
#
# LOCAL DEV: Run `npm run setup`, or copy .env.oss.example to .env.local.
#
# LEGEND:
#   [AUTO]     - Configured automatically by setup script
#   [OPTIONAL] - Not required for local development
#   [REQUIRED] - You MUST set this manually for the feature to work
#
# ============================================


# ============================================
# AUTO-CONFIGURED BY SETUP SCRIPT
# ============================================

# [AUTO] Database - Local PostgreSQL (dev) or self-hosted PG17+pgvector (prod)
# Production uses pgbouncer for connection pooling — append &pgbouncer=true
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sotto?schema=public"
# DIRECT_DATABASE_URL bypasses pgbouncer — required for Prisma migrations
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sotto?schema=public"

# [REQUIRED in production] Postgres credentials for Docker container
# POSTGRES_USER=sotto
# POSTGRES_PASSWORD=generate-with-openssl-rand-hex-32
# POSTGRES_DB=sotto

# [AUTO] Redis - Local Redis server (dev) or self-hosted Redis 7 (prod)
REDIS_URL="redis://localhost:6379"

# [REQUIRED in production] Redis password — protects Redis from unauthorized access
# Generate with: openssl rand -hex 32
# REDIS_PASSWORD=generate-with-openssl-rand-hex-32

# [AUTO] BYOK Encryption Key - AES-256-GCM encryption for user API keys
# Generate with: openssl rand -hex 32
BYOK_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# [AUTO] App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Self-hosted instance (default true). The /welcome onboarding wizard persists
# real choices and lets the owner configure the AI/STT/TTS/storage stack in-app.
# Set "false" only for the managed showcase, where /welcome runs as a
# non-persisting demo.
# SELF_HOSTED=true

# Optional public community/project links. Leave blank to hide them.
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_DISCORD_URL=""
NEXT_PUBLIC_VERIFICATION_STANDARD_URL=""


# ============================================
# PROVIDER SELECTION [OPTIONAL]
# ============================================
# Change these to swap external service providers.
# Default values work out of the box with the standard stack.

# Worker profile: all (default) | heavy | pipeline | light
# Controls which BullMQ workers start in this process.
# In production, three containers run with heavy/pipeline/light profiles.
# WORKER_PROFILE=all

# AI Provider: anthropic (default) | openai | google | claude-code | codex | local
# AI_PROVIDER=anthropic

# Claude Code CLI model (only used when AI_PROVIDER=claude-code)
# Set CLAUDE_CODE_MODELS to expose additional aliases/full model IDs without code changes.
# CLAUDE_CODE_MODEL=opus
# CLAUDE_CODE_MODELS=opus,sonnet,haiku,claude-fable-5
# CLAUDE_CODE_EFFORT=xhigh
# CLAUDE_CODE_EFFORTS=low,medium,high,xhigh,max

# Codex CLI model (only used when AI_PROVIDER=codex). Blank uses Codex's configured default.
# CODEX_MODEL=gpt-5.5
# CODEX_MODELS=gpt-5.5,gpt-5.6
# CODEX_MODEL_REASONING_EFFORT=xhigh
# CODEX_MODEL_REASONING_EFFORTS=low,medium,high,xhigh,max

# Totally-local inference (only used when AI_PROVIDER=local). Point Sotto at any
# OpenAI-compatible local server — no cloud key required. Set BOTH:
#   AI_BASE_URL — the server's OpenAI-compatible endpoint
#   AI_MODEL    — the model name the server serves (multilingual recommended for
#                 language learning: qwen3, gemma3, llama3.3, mistral-small)
# Examples:  Ollama  http://localhost:11434/v1   |  vLLM  http://localhost:8000/v1
#            LM Studio http://localhost:1234/v1
# AI_BASE_URL=http://localhost:11434/v1   # host;  Docker: http://ollama:11434/v1
# AI_MODEL=qwen3
# Optional — only if your local server is behind auth (defaults to "local").
# AI_API_KEY=
# Tip: `docker compose --profile local up` starts Ollama + Whisper + Kokoro.

# Claude Code CLI credentials (JSON from ~/.claude/.credentials.json).
# Required for claude-code:* models to work in Docker — no volume mount needed.
# Obtain: cat ~/.claude/.credentials.json
# Store in your secret manager for containerized deployments.
# CLAUDE_CODE_CREDENTIALS_JSON=

# Codex CLI home for local-agent ingestion from hosted workers.
# CODEX_HOME=/var/lib/sotto/codex

# TTS Provider: elevenlabs (default) | openai | cartesia | fal | replicate | kokoro (bundled local) | local (custom sidecar)
# TTS_PROVIDER=elevenlabs

# Totally-local, keyless TTS. Use kokoro for the bundled sidecar or local for
# any custom Sotto-compatible sidecar. See docs/06-provider-extension-guide.md.
# TTS_PROVIDER=kokoro
# TTS_PROVIDER=local
# TTS_BASE_URL=http://localhost:8000     # local dev outside Docker
# TTS_BASE_URL=http://local-tts:8000     # inside Docker Compose (service name)
# TTS_MODEL=local                        # optional model hint for TTS_PROVIDER=local
# TTS_VOICES=default,alternate           # optional comma-separated local voice IDs
# TTS_HOST_VOICE=default                 # optional host voice override
# TTS_EXPERT_VOICE=alternate             # optional expert voice override
# Optional — only if the sidecar is behind auth (the sidecar itself is keyless).
# TTS_API_KEY=

# Cartesia (Sonic 3) - Premium low-latency TTS with emotion support
# Get yours at: https://play.cartesia.ai/keys
# CARTESIA_API_KEY=sk_car_xxxxxxxxxxxxxxxxxxxxx
# Optional usage widget settings for env-configured Cartesia accounts.
# CARTESIA_ADMIN_API_KEY=sk_car_admin_xxxxxxxxxxxxxxxxxxxxx
# CARTESIA_USAGE_PLAN=free                  # free | pro | startup | scale | custom
# CARTESIA_MONTHLY_CREDIT_LIMIT=20000       # optional; overrides plan preset
# CARTESIA_BILLING_RESET_DAY=1              # optional, 1-31

# Fal.ai (Qwen3-TTS) — Open-source TTS via Fal serverless
# Also powers MiniMax Speech-02 HD (minimax provider)
# Get yours at: https://fal.ai/dashboard/keys
# FAL_KEY=fal_sk_xxxxxxxxxxxxxxxxxxxxx

# Replicate - Open-source TTS via Replicate
# Get yours at: https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=r8_xxxxxxxxxxxxxxxxxxxxx

# Mistral (Voxtral) - Premium neural TTS with voice cloning
# Get yours at: https://console.mistral.ai/api-keys
# MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Deepgram Aura - real-time voice-agent TTS (also serves Deepgram Nova STT above)
# Get yours at: https://console.deepgram.com/  — reuses DEEPGRAM_API_KEY

# Rime (Arcana) - natural conversational TTS
# Get yours at: https://app.rime.ai/tokens
# RIME_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# PlayHT (Play3.0-mini) - multilingual TTS; requires BOTH a user id and an API key
# Get yours at: https://play.ht/studio/api-access
# PLAYHT_USER_ID=xxxxxxxxxxxxxxxxxxxxx
# PLAYHT_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Storage Provider: r2 (default) | s3 | local
# STORAGE_PROVIDER=r2


# ============================================
# VOICE VERIFICATION [OPTIONAL]
# ============================================

# [OPTIONAL] Path to sherpa-onnx speaker recognition model
# Download with: bash scripts/download-speaker-model.sh
SHERPA_ONNX_MODEL_PATH=./models/wespeaker_en_voxceleb_CAM++_LM.onnx


# ============================================
# AI SERVICES [REQUIRED for episode generation]
# ============================================

# Anthropic Claude (default AI_PROVIDER) - Discovery chat, script generation, Q&A
# Get yours at: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# OpenAI (alternative AI_PROVIDER) - GPT-5 for script generation
# Get yours at: https://platform.openai.com/
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx
# OPENAI_MODEL=gpt-5

# Google Gemini (alternative AI_PROVIDER) - Gemini models with 1M context
# Get yours at: https://aistudio.google.com/apikey
# GOOGLE_AI_API_KEY=AIza...

# xAI Grok (alternative AI_PROVIDER) - Grok 4, 1M context (OpenAI-compatible)
# Get yours at: https://console.x.ai/
# XAI_API_KEY=xai-xxxxxxxxxxxxxxxxxxxxx

# DeepSeek (alternative AI_PROVIDER) - V4 family, ~1/10 the cost (OpenAI-compatible)
# Get yours at: https://platform.deepseek.com/api_keys
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# NVIDIA NIM (alternative AI_PROVIDER) - hosted Nemotron models (OpenAI-compatible)
# Get yours at: https://build.nvidia.com/
# NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxx

# Note: MISTRAL_API_KEY (above) and GROQ_API_KEY (in the STT section) also serve
# as LLM providers — Mistral chat models and Groq's Llama/GPT-OSS models.

# Live conversation (/learn/live) - real-time spoken translation via the Gemini
# Live API. Needs a per-learner Google (Gemini) key added in Settings > API (BYOK),
# not this server key; the feature stays hidden until a learner adds one. Optionally
# pin a different Live model (e.g. a translation-tuned preview the key can access).
# GEMINI_LIVE_MODEL=gemini-live-2.5-flash-preview

# Visual learning cues (optional): platform fallback for contextual images on
# learner-marked words/sentences. Self-hosted learners can also save an encrypted
# Pexels key from the welcome wizard.
# Get a key at: https://www.pexels.com/api/
# PEXELS_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# ============================================
# CONTENT SAFETY [OPTIONAL]
# ============================================
# OpenAI Moderation API key — screens user input/output for policy violations.
# Uses the free omni-moderation-latest model (13 categories).
# Fail-open: if unset or unavailable, content passes through unscreened.
# Get yours at: https://platform.openai.com/
# OPENAI_MODERATION_KEY=sk-xxxxxxxxxxxxxxxxxxxxx


# ElevenLabs (default TTS_PROVIDER) - Multi-voice TTS for episode audio
# Get yours at: https://elevenlabs.io/
# ELEVENLABS_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Voice IDs for episode speakers (overrides voice pool selection)
# Browse voices at: https://elevenlabs.io/voice-library
# ELEVENLABS_HOST_VOICE_ID=xxxxxxxxxxxxx
# ELEVENLABS_EXPERT_VOICE_ID=xxxxxxxxxxxxx

# Hume AI (Octave) — Ultra-quality expressive TTS with emotional intelligence
# Get yours at: https://platform.hume.ai/settings/keys
# HUME_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# yt-dlp — Path to yt-dlp binary for YouTube/Twitter video download fallback
# Install: brew install yt-dlp (macOS) or pip install yt-dlp
# YT_DLP_PATH=yt-dlp

# Local Whisper STT (only used when STT_PROVIDER=local). Point at any local
# OpenAI-compatible Whisper server (faster-whisper-server / Speaches / whisper.cpp
# server) — no cloud key required. large-v3-turbo gives the broadest (99+ language)
# coverage; STT_MODEL must match what the server serves. The bundled
# `docker compose --profile local` whisper service uses the model id below.
# STT_PROVIDER=local
# STT_BASE_URL=http://localhost:8001/v1   # host;  Docker: http://whisper:8000/v1
# STT_MODEL=deepdml/faster-whisper-large-v3-turbo-ct2
# Optional — only if the local server is behind auth (defaults to "local").
# STT_API_KEY=

# Together AI — Cheap Whisper STT at $0.0015/min
# Get yours at: https://api.together.xyz/settings/api-keys
# TOGETHER_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Deepgram — Nova-3 STT ($200 free credits)
# Get yours at: https://console.deepgram.com/
# DEEPGRAM_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# AssemblyAI — Universal-2 STT ($50 free credits)
# Get yours at: https://www.assemblyai.com/app
# ASSEMBLYAI_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Groq — Whisper STT (fastest & cheapest); also serves Llama/GPT-OSS LLMs
# Get yours at: https://console.groq.com/keys
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# Gladia — Solaria STT, 140 languages with accurate word timings
# Get yours at: https://app.gladia.io/
# GLADIA_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Speechmatics — Enhanced STT, enterprise accuracy across 80+ languages
# Get yours at: https://portal.speechmatics.com/
# SPEECHMATICS_API_KEY=xxxxxxxxxxxxxxxxxxxxx

# Pinchtab — headless Chrome fallback for content extraction (JS-rendered pages)
# Points to the pinchtab container in docker-compose
# PINCHTAB_URL=http://localhost:9867
# PINCHTAB_TOKEN=

# OpenAlex polite pool email — provides higher rate limits for reference verification
# OPENALEX_EMAIL=admin@example.com


# ============================================
# PRIVATE SOURCE CONNECTORS [OPTIONAL]
# ============================================
# Slack workspace connector. Use a user-owned Slack app and grant only the
# channels/DMs that should appear in private briefings.
# SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxx
# SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxx
# SLACK_APP_TOKEN=xapp-xxxxxxxxxxxxxxxxxxxxx

# Gmail connector via Google Workspace CLI (gws).
# Local use: run `gws auth login` on the host that runs ingestion.
# Hosted/headless use: `gws auth export --unmasked > credentials.json`, then set:
# GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE=/run/secrets/google-workspace-credentials.json
# Or provide a short-lived token minted elsewhere:
# GOOGLE_WORKSPACE_CLI_TOKEN=ya29.xxxxxxxxxxxxxxxxxxxxx


# ElevenLabs pricing tier for cost tracking: free | starter | creator | scale (default)
# ELEVENLABS_TIER=scale


# ============================================
# CLOUDFLARE R2 STORAGE [OPTIONAL]
# ============================================
# Episode audio file storage.

# Cloudflare R2 (default STORAGE_PROVIDER)
# R2_ACCOUNT_ID=xxxxxxxxxxxxx
# R2_ACCESS_KEY_ID=xxxxxxxxxxxxx
# R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxx
# R2_BUCKET_NAME=sotto-storage
# R2_PUBLIC_URL=https://pub-xxxxx.r2.dev

# Cloudflare API token for R2 usage monitoring (Workers R2 Storage: Read + Account Analytics: Read)
# CF_API_TOKEN=xxxxxxxxxxxxx

# AWS S3 (alternative STORAGE_PROVIDER)
# AWS_ACCESS_KEY_ID=xxxxxxxxxxxxx
# AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxx
# AWS_S3_BUCKET=sotto-storage
# AWS_S3_REGION=us-east-1

# Local filesystem (development STORAGE_PROVIDER)
# LOCAL_STORAGE_DIR=/tmp/sotto-storage


# ============================================
# WEB PUSH NOTIFICATIONS [OPTIONAL]
# ============================================
# Generate VAPID keys with: npx web-push generate-vapid-keys

# NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxxxxxxx
# VAPID_PRIVATE_KEY=xxxxxxxxxxxxx
# VAPID_SUBJECT=mailto:admin@example.com



# ============================================
# MCP SERVER [OPTIONAL]
# ============================================
# Used by @sotto/mcp — the MCP server that lets AI assistants
# create and manage episodes via Claude Desktop, Claude Code, etc.

# [REQUIRED for MCP] Sotto API key (create at ${NEXT_PUBLIC_APP_URL}/settings/api)
# SOTTO_API_KEY=sk_sotto_xxxxxxxxxxxxxxxxxxxxx

# [REQUIRED for MCP] API base URL for this deployment
# SOTTO_API_URL=http://localhost:3000


# ============================================
# E2E TESTING [LOCAL ONLY]
# ============================================
# Set these to redirect AI SDK calls to the LLMock server during E2E tests.
# Never set in shared or production configs — local-only test vars.
# ANTHROPIC_BASE_URL=http://localhost:4100
# OPENAI_BASE_URL=http://localhost:4100
# GOOGLE_AI_BASE_URL=http://localhost:4100


# ============================================
# ERROR TRACKING & ANALYTICS [OPTIONAL]
# ============================================

# Sentry - https://sentry.io/
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx

# PostHog - https://posthog.com/
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
