# Sotto runtime environment. Configure providers, models, credentials, and
# local/R2/S3 storage in /welcome or Admin. Sidedoor stores that configuration.

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sotto?schema=public"
DIRECT_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sotto?schema=public"
REDIS_URL="redis://localhost:6379"

# Production container credentials.
# POSTGRES_USER=sotto
# POSTGRES_PASSWORD=generate-with-openssl-rand-hex-32
# POSTGRES_DB=sotto
# REDIS_PASSWORD=generate-with-openssl-rand-hex-32

# Encrypts saved provider credentials. Generate with: openssl rand -hex 32
BYOK_ENCRYPTION_KEY=""

NEXT_PUBLIC_APP_URL="http://localhost:3000"
# SELF_HOSTED=true

# Durable execution recovery directory shared by web and workers.
SIDEDOOR_EXECUTION_DIR="./.sotto/executions"

# Worker profile: all | heavy | pipeline | light
# WORKER_PROFILE=all

# Local agent runtime. Provider and model selection stay in Sotto.
# CLAUDE_CODE_CREDENTIALS_JSON=
# CLAUDE_AUTH_DIR=/home/you/.claude
# CODEX_AUTH_DIR=/home/you/.codex
# CODEX_HOME=/var/lib/sotto/codex
# SOTTO_CREDENTIAL_SYNC_DIR=/run/cli-credentials
# CLAUDE_CODE_SSH_HOST=you@your-vps
# CODEX_SSH_HOST=you@your-vps
# SOTTO_AGENT_SSH_KEY_PATH=/home/sotto/.ssh/id_ed25519
# SOTTO_AGENT_SSH_KNOWN_HOSTS_PATH=/home/sotto/.ssh/known_hosts

# Private source connectors.
# SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxx
# SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxx
# SLACK_APP_TOKEN=xapp-xxxxxxxxxxxxxxxxxxxxx
# GOOGLE_WORKSPACE_CLI_CREDENTIALS_FILE=/run/secrets/google-workspace-credentials.json
# GOOGLE_WORKSPACE_CLI_TOKEN=ya29.xxxxxxxxxxxxxxxxxxxxx

# Extraction and reference tooling.
# YT_DLP_PATH=yt-dlp
# PINCHTAB_URL=http://localhost:9867
# PINCHTAB_TOKEN=
# OPENALEX_EMAIL=admin@example.com

# Optional speaker verification model.
SHERPA_ONNX_MODEL_PATH=./models/wespeaker_en_voxceleb_CAM++_LM.onnx

# Optional public links.
NEXT_PUBLIC_GITHUB_URL=""
NEXT_PUBLIC_DISCORD_URL=""
NEXT_PUBLIC_VERIFICATION_STANDARD_URL=""

# Web push notifications.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY=xxxxxxxxxxxxx
# VAPID_PRIVATE_KEY=xxxxxxxxxxxxx
# VAPID_SUBJECT=mailto:admin@example.com

# MCP client configuration.
# SOTTO_API_KEY=sk_sotto_xxxxxxxxxxxxxxxxxxxxx
# SOTTO_API_URL=http://localhost:3000

# Local E2E interception only.
# ANTHROPIC_BASE_URL=http://localhost:4100
# OPENAI_BASE_URL=http://localhost:4100
# GOOGLE_AI_BASE_URL=http://localhost:4100

# Error tracking and product analytics.
# SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Multi-stack deployment.
# SOTTO_STACK=sotto
# SOTTO_WEB_PORT_BLUE=3000
# SOTTO_WEB_PORT_GREEN=3010

# Production release metadata.
# SOTTO_RELEASE_SHA=
# SOTTO_WEB_IMAGE_REF=
# SOTTO_WORKERS_IMAGE_REF=
# SOTTO_WEB_IMAGE_BYTES=
# SOTTO_WEB_TRANSFER_BYTES=
# SOTTO_WORKERS_IMAGE_BYTES=
# SOTTO_WORKERS_TRANSFER_BYTES=
# SOTTO_BACKUP_BYTES=
# SOTTO_BACKUP_DIR=
# SOTTO_WORKERS_ROLLBACK_TAG=
# SOTTO_WEB_ROLLBACK_TAG=
# PRODUCTION_CAPACITY_CHECKER=/usr/local/lib/production/production_capacity.py
# PRODUCTION_IMAGE_RETENTION_DIR=
