# ============================================
# SOTTO MOBILE — ENVIRONMENT CONFIGURATION
# ============================================
#
# Copy this file to .env and fill in values.
# Expo loads .env automatically via expo-constants.
#
# ============================================

# API base URL — where the Sotto web backend lives
# Development: your local machine's IP (NOT localhost — the simulator needs a routable IP)
# Production: https://sotto.fm/api
EXPO_PUBLIC_API_URL=http://192.168.1.XXX:3000/api

# EAS Project ID — assigned when you run `eas init`
# EXPO_PUBLIC_EAS_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Expo Push Notifications — project ID for push tokens
# Same as EAS project ID in most cases
# EXPO_PUBLIC_PROJECT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
