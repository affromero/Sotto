{
  "expo": {
    "name": "Sotto",
    "slug": "sotto",
    "scheme": "sotto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEFCF8"
    },
    "ios": {
      "bundleIdentifier": "fm.sotto.app",
      "supportsTablet": true,
      "buildNumber": "1",
      "associatedDomains": [
        "applinks:sotto.fm"
      ],
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fm.sotto.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEFCF8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#D97706"
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf22d36f-0056-4fd7-a213-81bb82aed1a4"
      }
    },
    "owner": "affromero"
  }
}
