{
  "expo": {
    "name": "Sotto",
    "slug": "sotto",
    "scheme": "sotto",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEFCF8"
    },
    "ios": {
      "bundleIdentifier": "fm.sotto.app",
      "supportsTablet": true,
      "buildNumber": "4",
      "infoPlist": {
        "UIBackgroundModes": ["audio"],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "fm.sotto.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#D97706"
      },
      "permissions": ["FOREGROUND_SERVICE", "FOREGROUND_SERVICE_MEDIA_PLAYBACK", "WAKE_LOCK"]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D97706"
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      "@react-native-google-signin/google-signin",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Sotto to access your microphone for speaking practice."
        }
      ],
      "./modules/sotto-pencilkit/app.plugin.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cf22d36f-0056-4fd7-a213-81bb82aed1a4"
      }
    },
    "owner": "affromero"
  }
}
