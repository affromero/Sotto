{
  "expo": {
    "name": "Sotto",
    "slug": "sotto",
    "scheme": "sotto",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FEFCF8"
    },
    "ios": {
      "bundleIdentifier": "fm.sotto.app",
      "supportsTablet": true,
      "associatedDomains": ["applinks:sotto.fm"],
      "infoPlist": {
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "fm.sotto.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FEFCF8"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#D97706"
        }
      ]
    ]
  }
}
