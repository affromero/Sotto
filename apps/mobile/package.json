{
  "name": "@sotto/mobile",
  "version": "1.0.0",
  "license": "AGPL-3.0-only",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "ios": "expo run:ios",
    "ios:open": "expo prebuild --platform ios --no-install && open ios/*.xcodeproj",
    "ios:build": "eas build --platform ios --profile development",
    "ios:build:preview": "eas build --platform ios --profile preview",
    "ios:build:production": "eas build --platform ios --profile production",
    "ios:submit": "eas submit --platform ios --latest",
    "ios:update": "eas update --branch production",
    "android": "expo run:android",
    "android:build": "eas build --platform android --profile development",
    "android:build:preview": "eas build --platform android --profile preview",
    "android:build:production": "eas build --platform android --profile production",
    "android:submit": "eas submit --platform android --latest",
    "type-check": "tsc --noEmit",
    "lint": "eslint app/ components/ lib/"
  },
  "dependencies": {
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@sotto/shared": "*",
    "@tanstack/react-query": "^5.101.0",
    "axios": "^1.17.0",
    "expo": "~56.0.8",
    "expo-apple-authentication": "~56.0.4",
    "expo-audio": "~56.0.11",
    "expo-auth-session": "~56.0.13",
    "expo-blur": "~56.0.3",
    "expo-constants": "~56.0.16",
    "expo-crypto": "~56.0.4",
    "expo-dev-client": "~56.0.18",
    "expo-font": "^56.0.5",
    "expo-haptics": "~56.0.3",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "^56.0.13",
    "expo-notifications": "~56.0.15",
    "expo-router": "^56.2.8",
    "expo-secure-store": "^56.0.4",
    "expo-status-bar": "~56.0.4",
    "expo-web-browser": "~56.0.5",
    "react": "19.2.7",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~3.0.0",
    "react-native-reanimated": "4.4.1",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "~4.25.2",
    "react-native-track-player": "^4.1.2",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.9.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.16",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-reanimated": "4.4.1",
    "react-native-worklets": "0.9.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-track-player"
        ]
      }
    },
    "install": {
      "exclude": [
        "react",
        "react-native-screens",
        "react-native-worklets"
      ]
    }
  }
}
