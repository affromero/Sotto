{
  "name": "@sotto/mobile",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:clear": "expo start --clear",
    "ios": "expo run:ios",
    "ios:open": "expo prebuild --platform ios --no-install && open ios/*.xcodeproj",
    "ios:build": "eas build --platform ios --profile development",
    "ios:build:preview": "eas build --platform ios --profile preview",
    "ios:build:production": "eas build --platform ios --profile production",
    "ios:submit": "eas submit --platform ios --latest",
    "ios:update": "eas update --branch production",
    "android": "expo run:android",
    "type-check": "tsc --noEmit",
    "lint": "eslint app/ components/ lib/"
  },
  "dependencies": {
    "@expo-google-fonts/dm-serif-display": "^0.4.2",
    "@expo-google-fonts/inter": "^0.4.2",
    "@react-native-google-signin/google-signin": "^16.1.1",
    "@sotto/shared": "*",
    "@tanstack/react-query": "^5.62.0",
    "axios": "^1.7.9",
    "expo": "~54.0.33",
    "expo-apple-authentication": "~8.0.8",
    "expo-auth-session": "~7.0.10",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.8",
    "expo-dev-client": "~6.0.20",
    "expo-font": "^14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-linking": "^8.0.11",
    "expo-notifications": "~0.32.16",
    "expo-router": "^6.0.23",
    "expo-secure-store": "^15.0.8",
    "expo-status-bar": "~3.0.9",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "4.1.1",
    "react-native-safe-area-context": "^5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-track-player": "^4.1.2",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "typescript": "~5.9.2"
  },
  "overrides": {
    "react-native-reanimated": "4.1.1",
    "react-native-worklets": "0.5.1"
  },
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-track-player"
        ]
      }
    },
    "install": {
      "exclude": [
        "react",
        "react-native-screens",
        "react-native-worklets"
      ]
    }
  }
}
