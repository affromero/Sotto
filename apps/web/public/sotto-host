#!/usr/bin/env bash
# sotto-host — move a self-hosted Sotto to newer images and report what it runs.
#
# A self-host install has no clone: install.sh writes ~/.sotto/docker-compose.yml
# and ~/.sotto/.env, and the stack runs pre-built images from GHCR. Updating is
# therefore repointing SOTTO_IMAGE_TAG, refreshing the compose file, pulling,
# and restarting -- never a git operation.
#
# Install:  curl -fsSL https://sotto.fm/sotto-host -o ~/.local/bin/sotto-host && chmod +x ~/.local/bin/sotto-host
set -euo pipefail
umask 077

SOTTO_DIR="${SOTTO_DIR:-$HOME/.sotto}"
SOTTO_REPOSITORY="${SOTTO_REPOSITORY:-affromero/Sotto}"
SOTTO_REF="${SOTTO_REF:-main}"
RAW_BASE="${SOTTO_RAW_BASE:-https://raw.githubusercontent.com/${SOTTO_REPOSITORY}/${SOTTO_REF}}"
API_BASE="${SOTTO_API_BASE:-https://api.github.com/repos/${SOTTO_REPOSITORY}}"
STAGING_DIR=""
cleanup() {
  [ -z "${INSTALL_LOCK_DIR:-}" ] || rmdir "$INSTALL_LOCK_DIR"
  [ -z "$STAGING_DIR" ] || rm -rf "$STAGING_DIR"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM

load_image_helper() {
  STAGING_DIR=$(mktemp -d)
  if [ -f "$SOTTO_DIR/images.sh" ]; then
    cp "$SOTTO_DIR/images.sh" "$STAGING_DIR/images.sh"
  else
    curl -fsSL "$RAW_BASE/scripts/selfhost/images.sh" -o "$STAGING_DIR/images.sh" ||
      fail "Could not download the image verification helper. Configuration has not changed."
  fi
  . "$STAGING_DIR/images.sh"
}

BOLD=$(printf '\033[1m'); DIM=$(printf '\033[2m'); RESET=$(printf '\033[0m')
CYAN=$(printf '\033[36m'); GREEN=$(printf '\033[32m'); YELLOW=$(printf '\033[33m'); RED=$(printf '\033[31m')
info() { printf "${CYAN}${BOLD}>${RESET} %b\n" "$1"; }
ok()   { printf "${GREEN}${BOLD}✓${RESET} %b\n" "$1"; }
warn() { printf "${YELLOW}${BOLD}!${RESET} %b\n" "$1"; }
fail() { printf "${RED}${BOLD}✗${RESET} %b\n" "$1" >&2; exit 1; }

usage() {
  cat <<'USAGE'
sotto-host — manage a self-hosted Sotto

  sotto-host update [--to REF] [--check] [--no-backup]
      Move the stack to newer images and restart it.
      --to REF     a released version (v0.3.1), a commit (2ce63555), or
                   "latest"; defaults to the newest published image
      --check      report what an update would do, change nothing
      --no-backup  skip the database dump taken before restarting

  sotto-host status
      Show the pinned image tag, what the stack reports, and its health.

  sotto-host rollback
      Return to the tag the last update replaced.

  sotto-host help

  Environment:
    SOTTO_DIR   install directory (default ~/.sotto)
USAGE
}

compose() {
  if docker compose version >/dev/null 2>&1; then
    docker compose "$@"
  elif command -v docker-compose >/dev/null 2>&1; then
    docker-compose "$@"
  else
    fail "Docker Compose v2 is required.\n  Install: ${BOLD}https://docs.docker.com/compose/install/${RESET}"
  fi
}

candidate_compose() {
  local arguments=(--project-directory "$install_dir" --env-file "$STAGING_DIR/.env" -f "$STAGING_DIR/docker-compose.yml")
  arguments+=(-f "$STAGING_DIR/candidate-env.yml")
  if [ -f "$STAGING_DIR/docker-compose.override.yml" ]; then
    arguments+=(-f "$STAGING_DIR/docker-compose.override.yml")
  fi
  compose "${arguments[@]}" "$@"
}

require_install() {
  [ -f "$SOTTO_DIR/docker-compose.yml" ] ||
    fail "No Sotto install at ${SOTTO_DIR}.\n  Install it first: ${BOLD}curl -fsSL https://sotto.fm/install.sh | bash${RESET}\n  Or point at another directory: ${BOLD}SOTTO_DIR=/path sotto-host ...${RESET}"
}

# Read one key from .env without sourcing it, which would pull every secret in
# the file into this process's environment.
env_value() {
  [ -f "$SOTTO_DIR/.env" ] || return 0
  sed -n "s/^${1}=//p" "$SOTTO_DIR/.env" | tail -n 1 | tr -d '"'"'"''
}

set_env_value() {
  local key=$1 value=$2 tmp
  tmp=$(mktemp "$SOTTO_DIR/.env.XXXXXX")
  if [ -f "$SOTTO_DIR/.env" ]; then
    awk -v key="$key" '$0 !~ ("^" key "=") { print }' "$SOTTO_DIR/.env" > "$tmp"
  fi
  printf '%s=%s\n' "$key" "$value" >> "$tmp"
  chmod 600 "$tmp"
  mv "$tmp" "$SOTTO_DIR/.env"
}

web_port() {
  local port
  port=$(env_value WEB_PORT)
  echo "${port:-3000}"
}

health() {
  curl -fsS --max-time 5 "http://localhost:$(web_port)/api/v1/health" 2>/dev/null
}

current_tag() {
  local tag
  tag=$(env_value SOTTO_IMAGE_TAG)
  echo "${tag:-latest}"
}

# The published images carry `latest` and 8-character commit shas; git version
# tags never reach the registry. So a version has to be resolved to the commit
# it points at before it can name an image.
resolve_ref() {
  local ref=$1 sha
  case "$ref" in
    latest) echo latest; return 0 ;;
  esac

  if printf '%s' "$ref" | grep -Eq '^[0-9a-f]{8}$'; then
    echo "$ref"
    return 0
  fi

  sha=$(curl -fsSL "${API_BASE}/commits/${ref}" 2>/dev/null |
    sed -n 's/^  "sha": "\([0-9a-f]\{40\}\)",$/\1/p' | head -1)
  [ -n "$sha" ] ||
    fail "Could not resolve '${ref}' in ${SOTTO_REPOSITORY}.\n  Use a version (v0.3.1), an 8-character commit, or 'latest'."
  printf '%s\n' "${sha:0:8}"
}

running_version() {
  local response
  response=$(health) || return 1
  printf '%s' "$response" | sed -n 's/.*"version"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' | cut -c1-8
}

cmd_status() {
  require_install
  echo "install:  ${SOTTO_DIR}"
  echo "pinned:   $(current_tag)"

  local running
  if running=$(running_version); then
    echo "running:  ${running}"
  else
    echo "running:  unreachable at http://localhost:$(web_port)"
  fi

  echo "updates:  run 'sotto-host update' to resolve the newest published release"

  local response
  if response=$(health); then
    echo "health:   ${response}"
  fi
}

backup_database() {
  local dir file
  dir="${SOTTO_BACKUP_DIR:-$SOTTO_DIR/backups}"
  mkdir -p "$dir"
  file="${dir}/sotto_$(date +%Y%m%d_%H%M%S).sql.gz"

  # Nothing to dump before the first successful start.
  if ! compose ps --status running postgres 2>/dev/null | grep -q postgres; then
    warn "Postgres is not running; skipping the backup"
    return 0
  fi

  info "Backing up the database..."
  if compose exec -T postgres pg_dump -U sotto sotto 2>/dev/null | gzip > "$file"; then
    ok "Backup written to ${file}"
  else
    rm -f "$file"
    fail "Backup failed; not touching a running install.\n  Skip it with ${BOLD}--no-backup${RESET} if that is deliberate."
  fi
}

cmd_update() {
  require_install
  cd "$SOTTO_DIR"

  local target from revision source_base install_dir previous_revision
  from=$(current_tag)
  if [ -n "$TO_REF" ]; then
    target=$(resolve_ref "$TO_REF")
  else
    target=latest
  fi

  local running
  running=$(running_version || true)

  echo "install:  ${SOTTO_DIR}"
  echo "pinned:   ${from}"
  if [ -n "$running" ]; then
    echo "running:  ${running}"
  fi
  echo "update:   ${from} → ${target}"

  if [ "$from" = "$target" ] && [ "${running:-}" = "$target" ]; then
    ok "Already running ${target}; nothing to do."
    return 0
  fi

  if [ "$CHECK_ONLY" = "1" ]; then
    printf "${DIM}(--check: nothing changed; image availability and revision are verified when updating)${RESET}\n"
    return 0
  fi

  load_image_helper
  acquire_install_lock "$SOTTO_DIR" || fail "Update is locked. Configuration has not changed."
  revision=$(resolve_images "$target") || fail "Could not verify the requested release. Configuration has not changed."
  target="${revision:0:8}"
  # Old installers pinned latest. Record the running immutable revision so a
  # rollback cannot accidentally pull the newly published release again.
  if [ "$from" = latest ]; then
    previous_revision=$(docker inspect --format '{{index .Config.Labels "org.opencontainers.image.revision"}}' "$(compose ps -q web)") ||
      fail "Cannot identify the previous release. Start the existing web container before updating."
    [[ "$previous_revision" =~ ^[0-9a-f]{8}([0-9a-f]{32})?$ ]] || fail "The previous release has no valid revision."
    from="${previous_revision:0:8}"
  fi
  if [ "$from" = "$target" ] && [ "${running:-}" = "$target" ]; then
    ok "Already running ${target}; nothing to do."
    return 0
  fi

  if [ "$BACKUP" = "1" ]; then
    backup_database
  fi

  info "Downloading configuration for release ${target}..."
  source_base="${SOTTO_RAW_BASE:-https://raw.githubusercontent.com/${SOTTO_REPOSITORY}/${revision}}"
  curl -fsSL "$source_base/docker-compose.selfhost.yml" -o "$STAGING_DIR/docker-compose.yml" || fail "Could not download release Compose configuration."
  curl -fsSL "$source_base/scripts/agent/sync-cli-credentials.sh" -o "$STAGING_DIR/sync-cli-credentials.sh" || fail "Could not download release credential synchronization."
  curl -fsSL "$source_base/scripts/selfhost/images.sh" -o "$STAGING_DIR/images.sh" || fail "Could not download release image verification helper."
  cp "$SOTTO_DIR/.env" "$STAGING_DIR/.env"
  [ ! -f "$SOTTO_DIR/docker-compose.override.yml" ] || cp "$SOTTO_DIR/docker-compose.override.yml" "$STAGING_DIR/docker-compose.override.yml"
  install_dir="$SOTTO_DIR"
  SOTTO_DIR="$STAGING_DIR"
  set_env_value SOTTO_IMAGE_TAG "$target"
  set_env_value SOTTO_PREVIOUS_IMAGE_TAG "$from"
  # --env-file controls interpolation; service env_file paths still resolve
  # relative to --project-directory. Add the staged base environment before
  # user overrides so their env_file and environment settings retain priority.
  local staged_env_path="$STAGING_DIR/.env"
  staged_env_path=${staged_env_path//\'/\'\'}
  printf "services:\n  web:\n    env_file: ['%s']\n  workers:\n    env_file: ['%s']\n" \
    "$staged_env_path" "$staged_env_path" > "$STAGING_DIR/candidate-env.yml"
  cd "$STAGING_DIR"
  candidate_compose config --quiet || fail "Release configuration is invalid. Existing configuration has not changed."
  info "Pulling images..."
  candidate_compose pull || fail "Could not pull images tagged ${target}. Existing configuration has not changed.\n  Published tags: ${BOLD}https://github.com/${SOTTO_REPOSITORY}/pkgs/container/sotto-web${RESET}"

  info "Applying database migrations and updating the language curriculum..."
  candidate_compose run --rm --no-deps workers sh -c \
    "cd /app && npx --no-install prisma migrate deploy --config=/app/prisma.config.ts && npx --no-install tsx apps/web/prisma/seed-curriculum.ts" ||
    fail "Database initialization failed. Existing configuration and rollback history have not changed. Inspect the migration or curriculum error before retrying."

  SOTTO_DIR="$install_dir"
  cd "$SOTTO_DIR"
  mkdir -p "$SOTTO_DIR/previous"
  for file in .env docker-compose.yml sync-cli-credentials.sh images.sh docker-compose.override.yml; do
    rm -f "$SOTTO_DIR/previous/$file"
    [ ! -f "$SOTTO_DIR/$file" ] || cp "$SOTTO_DIR/$file" "$SOTTO_DIR/previous/$file"
  done
  # Keep rollback immutable even when upgrading a legacy latest installation.
  SOTTO_DIR="$install_dir/previous"
  set_env_value SOTTO_IMAGE_TAG "$from"
  SOTTO_DIR="$install_dir"
  for file in .env docker-compose.yml sync-cli-credentials.sh images.sh; do
    mv "$STAGING_DIR/$file" "$SOTTO_DIR/$file"
  done

  info "Restarting Sotto..."
  compose up -d

  printf "${CYAN}${BOLD}>${RESET} Waiting for health"
  local response=""
  for _ in $(seq 1 45); do
    if response=$(health) && release_healthy "$response" "$target"; then break; fi
    response=""
    printf '.'
    sleep 2
  done
  printf '\n'

  if [ -n "$response" ]; then
    ok "Sotto is up on ${target}: ${response}"
  else
    fail "Sotto did not report healthy at http://localhost:$(web_port)\n  Logs:     ${BOLD}cd ${SOTTO_DIR} && docker compose logs --tail 50 web${RESET}\n  Roll back: ${BOLD}sotto-host rollback${RESET}"
  fi
}

cmd_rollback() {
  require_install
  cd "$SOTTO_DIR"

  local previous
  previous=$(env_value SOTTO_PREVIOUS_IMAGE_TAG)
  [ -n "$previous" ] || fail "No previous tag recorded; nothing to roll back to.\n  Pin one yourself: ${BOLD}sotto-host update --to <commit>${RESET}"

  info "Rolling back $(current_tag) → ${previous}"
  load_image_helper
  acquire_install_lock "$SOTTO_DIR" || fail "Rollback is locked. Configuration has not changed."
  resolve_images "$previous" >/dev/null || fail "Cannot pull the previous release. Configuration has not changed."
  if [ -f "$SOTTO_DIR/previous/docker-compose.yml" ]; then
    for file in .env docker-compose.yml sync-cli-credentials.sh images.sh docker-compose.override.yml; do
      if [ -f "$SOTTO_DIR/previous/$file" ]; then
        cp "$SOTTO_DIR/previous/$file" "$SOTTO_DIR/$file"
      elif [ "$file" = docker-compose.override.yml ]; then
        rm -f "$SOTTO_DIR/$file"
      fi
    done
  else
    set_env_value SOTTO_IMAGE_TAG "$previous"
  fi
  compose up -d

  # A rollback does not undo migrations: Prisma migrations are forward-only, so
  # the older image runs against the newer schema. Say so rather than imply the
  # database moved back too.
  warn "Images rolled back. Database migrations are forward-only and were not reverted."
  for _ in $(seq 1 45); do
    if response=$(health) && release_healthy "$response" "$previous"; then
      set_env_value SOTTO_PREVIOUS_IMAGE_TAG ""
      ok "Sotto is on ${previous}."
      return 0
    fi
    sleep 2
  done
  fail "The previous release did not become healthy. Inspect docker compose logs."
}

CHECK_ONLY=0
BACKUP=1
TO_REF=""
command=${1:-help}
shift || true
while [ $# -gt 0 ]; do
  argument=$1
  shift
  case "$argument" in
    --check) CHECK_ONLY=1 ;;
    --no-backup) BACKUP=0 ;;
    --to)
      TO_REF=${1:?--to needs a version, commit, or 'latest'}
      shift
      ;;
    --to=*) TO_REF=${argument#--to=} ;;
    *) fail "unknown option ${argument}" ;;
  esac
done

case "$command" in
  update) cmd_update ;;
  status) cmd_status ;;
  rollback) cmd_rollback ;;
  help | -h | --help) usage ;;
  *)
    printf "sotto-host: unknown command %s\n" "$command" >&2
    usage >&2
    exit 1
    ;;
esac
