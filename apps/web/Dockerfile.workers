# ============================================
# Sotto — Production Workers Container
# Multi-stage build: deps → runner
# Build context: repo root (.)
# ============================================

ARG WORKER_BASE_IMAGE

# ---- Stage 1: Install dependencies ----
FROM node:22-slim AS deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    g++ make openssl python3 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/groundcheck/package.json ./packages/groundcheck/
COPY packages/learning-model/package.json ./packages/learning-model/
COPY apps/web/prisma ./apps/web/prisma/

RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --ignore-scripts \
    && npm rebuild thesidedoor-flock \
    && mkdir -p apps/web/node_modules
RUN npm rebuild esbuild
RUN npx --no-install prisma generate --schema=apps/web/prisma/schema.prisma

# ---- Stage 2: Production runner ----
FROM ${WORKER_BASE_IMAGE} AS runner
ARG RUNTIME_UID=1001

ENV NODE_ENV=production
ARG COMMIT_SHA=dev
LABEL org.opencontainers.image.revision=${COMMIT_SHA}
LABEL org.opencontainers.image.source="https://github.com/affromero/Sotto"
ENV COMMIT_SHA=${COMMIT_SHA}

# Match the web image and the shared CLI home owner.
RUN case "$RUNTIME_UID" in \
      1000) ;; \
      1001) addgroup --system --gid 1001 sotto && adduser --system --uid 1001 sotto ;; \
      *) echo 'RUNTIME_UID must be 1000 or 1001' >&2; exit 1 ;; \
    esac
RUN mkdir -p /home/sotto/.codex /home/sotto/.claude /home/sotto/.ssh \
    && chown -R "$RUNTIME_UID:$RUNTIME_UID" /home/sotto

ENV HOME=/home/sotto

# Copy dependencies with Prisma client (root + workspace-specific node_modules)
COPY --from=deps --chown=${RUNTIME_UID}:${RUNTIME_UID} /app/node_modules ./node_modules
COPY --from=deps --chown=${RUNTIME_UID}:${RUNTIME_UID} /app/apps/web/node_modules ./apps/web/node_modules

# Copy workspace structure (workers need full src/ for tsx runtime compilation)
COPY --chown=${RUNTIME_UID}:${RUNTIME_UID} apps/web/package.json ./apps/web/
COPY --chown=${RUNTIME_UID}:${RUNTIME_UID} apps/web/tsconfig.json ./apps/web/
COPY --chown=${RUNTIME_UID}:${RUNTIME_UID} tsconfig.base.json ./
COPY --chown=${RUNTIME_UID}:${RUNTIME_UID} prisma.config.ts ./
COPY --chown=${RUNTIME_UID}:${RUNTIME_UID} apps/web/prisma ./apps/web/prisma/
COPY --chown=${RUNTIME_UID}:${RUNTIME_UID} packages/shared ./packages/shared/
COPY --chown=${RUNTIME_UID}:${RUNTIME_UID} packages/groundcheck ./packages/groundcheck/
COPY --chown=${RUNTIME_UID}:${RUNTIME_UID} packages/learning-model ./packages/learning-model/
COPY --chown=${RUNTIME_UID}:${RUNTIME_UID} apps/web/src ./apps/web/src/
# The host copy above omits the gitignored Prisma 7 generated client; bring it
# from the deps stage (where `prisma generate` ran) so tsx can resolve it.
COPY --from=deps --chown=${RUNTIME_UID}:${RUNTIME_UID} /app/apps/web/src/generated ./apps/web/src/generated/
COPY --chown=${RUNTIME_UID}:${RUNTIME_UID} apps/web/models ./apps/web/models/
COPY --chown=${RUNTIME_UID}:${RUNTIME_UID} apps/web/prompts ./apps/web/prompts/

# Default local-storage root (STORAGE_PROVIDER=local). It must exist in the
# image and be owned by the runtime user: Docker seeds a fresh named volume
# from the image path it covers, so if the path is missing the volume is
# created root-owned and every write fails with EACCES.
RUN mkdir -p /app/apps/web/.sotto/storage /app/apps/web/.sotto/runtime \
    && chown -R "$RUNTIME_UID:$RUNTIME_UID" /app/apps/web/.sotto \
    && chmod 0700 /app/apps/web/.sotto/runtime

USER ${RUNTIME_UID}

WORKDIR /app/apps/web
CMD ["node", "--max-old-space-size=1536", "--import", "tsx", "src/workers/index.ts"]
