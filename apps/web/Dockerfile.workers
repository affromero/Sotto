# ============================================
# Sotto — Production Workers Container
# Multi-stage build: deps → runner
# Build context: repo root (.)
# ============================================

# ---- Stage 1: Install dependencies ----
FROM node:22-slim AS deps
RUN apt-get update && apt-get install -y openssl && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY package.json package-lock.json ./
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
COPY packages/video/package.json ./packages/video/
COPY packages/verification-standard/package.json ./packages/verification-standard/
COPY packages/maps/package.json ./packages/maps/
COPY apps/web/prisma ./apps/web/prisma/

RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts
RUN npx prisma generate --schema=apps/web/prisma/schema.prisma

# ---- Stage 2: Production runner ----
FROM node:22-slim AS runner
RUN apt-get update && apt-get install -y \
    openssl ffmpeg libchromaprint-tools python3 python3-pip wget \
    && (wget -qO /usr/local/bin/yt-dlp https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp \
        && chmod +x /usr/local/bin/yt-dlp \
    || pip install --break-system-packages yt-dlp) \
    && rm -rf /var/lib/apt/lists/*
# Install Playwright Chromium (must be before USER sotto — needs root for system deps)
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx playwright install --with-deps chromium
# Install Claude Code CLI so claude-code:* models can spawn the claude binary
RUN npm install -g @anthropic-ai/claude-code
WORKDIR /app

ENV NODE_ENV=production

# Create non-root user
RUN addgroup --system --gid 1001 sotto
RUN adduser --system --uid 1001 sotto

# Copy dependencies with Prisma client (root + workspace-specific node_modules)
COPY --from=deps --chown=sotto:sotto /app/node_modules ./node_modules
COPY --from=deps --chown=sotto:sotto /app/apps/web/node_modules ./apps/web/node_modules

# Copy workspace structure (workers need full src/ for tsx runtime compilation)
COPY --chown=sotto:sotto apps/web/package.json ./apps/web/
COPY --chown=sotto:sotto apps/web/tsconfig.json ./apps/web/
COPY --chown=sotto:sotto tsconfig.base.json ./
COPY --chown=sotto:sotto apps/web/prisma ./apps/web/prisma/
COPY --chown=sotto:sotto packages/shared ./packages/shared/
COPY --chown=sotto:sotto packages/video ./packages/video/
COPY --chown=sotto:sotto packages/verification-standard ./packages/verification-standard/
COPY --chown=sotto:sotto packages/maps ./packages/maps/
COPY --chown=sotto:sotto apps/web/src ./apps/web/src/
COPY --chown=sotto:sotto apps/web/models ./apps/web/models/
COPY --chown=sotto:sotto apps/web/prompts ./apps/web/prompts/

USER sotto

WORKDIR /app/apps/web
CMD ["node", "--max-old-space-size=1536", "--import", "tsx", "src/workers/index.ts"]
