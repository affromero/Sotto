{
  "$schema": "./speech-language-support.schema.json",
  // Sotto course languages. Every provider/model support pack below must use
  // these normalized ISO 639-1 codes. Provider-specific API aliases belong in
  // sttProviderLanguageCodeOverrides/languageAliasesToSotto, not in these lists.
  "sottoLanguageCodes": [
    "en",
    "es",
    "fr",
    "de",
    "pt",
    "it",
    "ja",
    "ko",
    "zh",
