      "th",
      "vi",
      "id",
      "ms",
      "uk",
      "ca",
    ],
    "gladiaSolaria3": ["en", "fr", "de", "es", "it"],
  },
  // Welcome cards map provider ids to pack names. Use "all" for every Sotto
  // language, "en" for English-only, or a named pack above.
  "welcomeProviderLanguageSupport": {
    "tts": {
      "elevenlabs": "all",
      "hume": "humeV2",
      "openai": "all",
      "cartesia": "cartesiaSonic3",
      "deepgram": "deepgramAura",
      "rime": "rimeArcana",
      "playht": "playhtPlay3Mini",
      "kokoro": "kokoro",
      "local": "all",
    },
    "stt": {
      "whisper": "all",
      "local": "all",
      "deepgram": "all",
      "elevenlabs": "all",
      "assembly": "all",
      "assemblyai": "all",
      "openai": "all",
      "together": "all",
      "cartesia": "all",
      "groq": "all",
      "gladia": "all",
      "speechmatics": "all",
    },
  },
  // Outbound STT API language-code overrides. Example: Sotto stores Mandarin as
  // "zh", but Speechmatics expects "cmn" in transcription_config.language.
  "sttProviderLanguageCodeOverrides": {
    "speechmatics": {
      "zh": "cmn",
    },
  },
  // Inbound aliases normalized back to Sotto language codes from provider
  // responses. These are merged with standard ISO 639-3 aliases in code.
  "languageAliasesToSotto": {
    "cmn": "zh",
  },
}
