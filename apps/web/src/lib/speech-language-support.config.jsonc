  // Named STT support packs referenced by providers/stt-registry.ts and the
  // welcome provider badges. Keep these model-specific: "ready" means the
  // selected provider has a configured model that supports the selected language.
  "sttLanguageSupport": {
    "assemblyUniversal3Pro": ["en", "es", "fr", "de", "pt", "it"],
    // Cartesia ink-2 (May 2026) is English-only; ink-whisper stays the
    // multilingual default.
    "inkTwo": ["en"],
    "deepgramNova2": [
      "en",
      "es",
      "fr",
      "de",
      "pt",
      "it",
      "ja",
      "ko",
      "zh",
      "hi",
