# ============================================
# Sotto — Production Workers Base Container
# Heavy runtime dependencies shared by worker images
# ============================================

FROM node:22-slim

RUN apt-get update && apt-get install -y \
    openssl ffmpeg libchromaprint-tools python3 python3-pip wget \
    && (wget -qO /usr/local/bin/yt-dlp https://github.com/yt-dlp/yt-dlp/releases/latest/download/yt-dlp \
        && chmod +x /usr/local/bin/yt-dlp \
    || pip install --break-system-packages yt-dlp) \
    && rm -rf /var/lib/apt/lists/*

ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN npx playwright@1.61.0 install --with-deps chromium

# Install Claude Code CLI so claude-code:* models can spawn the claude binary.
RUN npm install -g @anthropic-ai/claude-code

WORKDIR /app
