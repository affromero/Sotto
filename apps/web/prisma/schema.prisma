// Sotto Database Schema
// Interactive Podcast Platform

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============ USER ROLES ============

enum UserRole {
  USER
  CREATOR
  ADMIN
  SYSTEM
}

// ============ USERS & AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  handle        String?   @unique
  image         String?
  bio           String?   @db.Text
  role          UserRole  @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Usage tracking
  podcastsUsed    Int @default(0)
  podcastsAllowed Int @default(2) // 2 free podcasts for all users

  // Twitter integration
  twitterHandle          String?   @unique
  twitterEnabled         Boolean   @default(false)
  preferredHostVoiceId   String?
  preferredExpertVoiceId String?

  // BYOK (Bring Your Own Key) — encrypted ElevenLabs API key (legacy, migrated to UserTtsKey)
  elevenLabsApiKey String? @db.Text

  // Team membership (dormant — kept for future use)
  teamId String?
  team   Team?   @relation(fields: [teamId], references: [id])

  // Relations
  accounts           Account[]
  sessions           Session[]
  podcasts           Podcast[]
  discoveries        Discovery[]
  interactions       Interaction[]
  subscription       Subscription?
  notifications      Notification[]
  subscriptionEvents SubscriptionEvent[]
  ownedTeams         Team[]              @relation("TeamOwner")
  apiUsageLogs       ApiUsageLog[]
  pushSubscriptions  PushSubscription[]
  expoPushTokens     ExpoPushToken[]
  voiceClones        VoiceClone[]

  // Social
  likes     Like[]
  saves     Save[]
  followers Follow[] @relation("Following")
  following Follow[] @relation("Follower")

  // API Keys
  apiKeys ApiKey[]

  // Twitter mentions
  tweetMentions TweetMention[]

  // Credit transactions
  creditTransactions CreditTransaction[]

  // BYOK TTS keys (multi-provider)
  userTtsKeys UserTtsKey[]

  // Interests (onboarding + settings)
  interests             UserInterest[]
  hasCompletedOnboarding Boolean @default(false)

  // Voice requests
  voiceRequestsSent     VoiceRequest[] @relation("VoiceRequester")
  voiceRequestsReceived VoiceRequest[] @relation("VoiceOwner")

  // Voice allowlist
  voiceAllowlistEntries VoiceAllowlist[] @relation("VoiceAllowlisted")

  @@index([teamId])
  @@index([role])
  @@index([handle])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ SOCIAL: FOLLOW ============

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ============ SUBSCRIPTIONS ============

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String             @unique
  stripePriceId        String
  status               SubscriptionStatus @default(PENDING)
  tier                 SubscriptionTier   @default(FREE)
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  premiumCreditsUsed   Int                @default(0)
  creditsBalance       Float              @default(0)
  creditsMonthly       Int                @default(2)
  rolloverCredits      Int                @default(0)
  maxRollover          Int                @default(0)
  voiceCreatorAddonActive               Boolean @default(false)
  voiceCreatorAddonStripeSubscriptionId String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([tier])
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
}

enum SubscriptionTier {
  FREE
  STARTER
  PRO
  STUDIO
  POWER
}

model SubscriptionEvent {
  id            String   @id @default(cuid())
  userId        String
  type          String
  stripeEventId String   @unique
  data          Json
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

// ============ CREDIT TRANSACTIONS ============

model CreditTransaction {
  id              String   @id @default(cuid())
  userId          String
  amount          Float    // positive = add, negative = consume
  balanceBefore   Float
  balanceAfter    Float
  type            String   // 'monthly_grant' | 'generation' | 'refund' | 'purchase' | 'admin'
  description     String
  podcastId       String?
  stripePaymentId String?
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type])
}

// ============ TEAMS ============

model Team {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  seats     Int      @default(10)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner   User         @relation("TeamOwner", fields: [ownerId], references: [id])
  members User[]
  invites TeamInvite[]

  @@index([ownerId])
}

model TeamInvite {
  id        String           @id @default(cuid())
  teamId    String
  email     String
  token     String           @unique
  status    TeamInviteStatus @default(PENDING)
  invitedBy String
  expiresAt DateTime
  createdAt DateTime         @default(now())

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@index([email])
  @@index([token])
}

enum TeamInviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

// ============ PODCASTS ============

model Podcast {
  id        String        @id @default(cuid())
  userId    String
  title     String
  topic     String        @db.Text
  status    PodcastStatus @default(PENDING)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  // Audio
  audioUrl  String?
  duration  Int?    // seconds
  fileSize  Int?    // bytes

  // Voice selection
  hostVoiceId     String?
  expertVoiceId   String?
  usePremiumVoice Boolean @default(false)
  ttsProvider     String? // null = auto; 'elevenlabs' | 'openai' | 'playht' | 'cartesia' | 'hume'
  creditCost      Float?

  // Source tracking (web, twitter, api)
  source        PodcastSource @default(WEB)
  sourceTweetId String?

  // Visibility
  visibility PodcastVisibility @default(PUBLIC)

  // Fork tracking
  forkedFromId     String?
  forkedFrom       Podcast?  @relation("Forks", fields: [forkedFromId], references: [id])
  forks            Podcast[] @relation("Forks")
  remixNote        String?   @db.Text
  parentDiscovery  Json?

  // Versioning
  currentVersion Int @default(1)

  // Counters (denormalized for performance)
  playCount Int @default(0)
  likeCount Int @default(0)
  forkCount Int @default(0)
  saveCount Int @default(0)

  // PDF export
  pdfUrl String?

  // Import fields
  importedAudioKey    String?
  originalFormat      String?
  transcriptProvided  Boolean @default(false)
  isHumanContent      Boolean @default(false)

  // Relations
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  discovery    Discovery?
  script       Script?
  segments     Segment[]
  interactions Interaction[]
  likes        Like[]
  saves        Save[]
  tags         PodcastTag[]
  jobs         Job[]
  references   Reference[]
  versions     PodcastVersion[]
  tweetMention     TweetMention?
  playbackSessions PlaybackSession[]
  podcastFeature   PodcastFeature?
  listeningQueues  ListeningQueue[]

  @@index([userId])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
  @@index([playCount])
  @@index([likeCount])
}

enum PodcastStatus {
  PENDING
  DISCOVERING
  EXTRACTING
  SCRIPTING
  VERIFYING_SCRIPT
  VALIDATING_REFERENCES
  GENERATING_AUDIO
  STITCHING
  READY
  UPDATING
  FAILED
  IMPORTING
  TRANSCRIBING
}

enum PodcastVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum PodcastSource {
  WEB
  TWITTER
  API
  IMPORT
}

// ============ DISCOVERY (Chat-Based) ============

model Discovery {
  id        String   @id @default(cuid())
  podcastId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Extracted metadata from chat
  topic          String?  @db.Text
  depth          String?  // quick_overview, standard, deep_dive
  audienceLevel  String?  // beginner, intermediate, expert
  audience       String?  // kids, teens, family, general, mature
  focusAreas     String[] // array of focus topics
  tone           String?  // casual, professional, socratic
  durationTarget Int?     // minutes
  priorKnowledge String?  @db.Text
  sourceUrl      String?
  sourceContent  String?  @db.Text

  // Relations
  podcast  Podcast            @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  messages DiscoveryMessage[]
  user     User               @relation(fields: [userId], references: [id])
  userId   String

  @@index([userId])
}

model DiscoveryMessage {
  id          String   @id @default(cuid())
  discoveryId String
  role        String   // user, assistant, system
  content     String   @db.Text
  chips       Json?    // suggested chip options [{label, value}]
  createdAt   DateTime @default(now())

  discovery Discovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)

  @@index([discoveryId])
}

// ============ SCRIPTS ============

model Script {
  id        String   @id @default(cuid())
  podcastId String   @unique
  turns     Json     // [{speaker: "HOST"|"EXPERT", text: "..."}]
  soundCues Json?    // [{type, prompt, durationSeconds, insertAfterTurn}]
  markdown  String   @db.Text
  context   String?  @db.Text // source context used for generation
  version   Int      @default(1)
  verificationAttempts Int      @default(0)
  verificationFeedback String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
}

// ============ AUDIO SEGMENTS ============

model Segment {
  id        String  @id @default(cuid())
  podcastId String
  speaker   Speaker
  text      String  @db.Text
  audioUrl  String?
  order     Int
  startTime Float?  // seconds
  duration  Float?  // seconds
  version   Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([podcastId])
  @@index([order])
}

enum Speaker {
  HOST
  EXPERT
}

// ============ PODCAST VERSIONS ============

model PodcastVersion {
  id            String   @id @default(cuid())
  podcastId     String
  version       Int
  audioUrl      String
  duration      Int?
  changeType    String   // 'initial' | 'incorporation' | 'regeneration'
  changeSummary String?  @db.Text
  interactionId String?
  createdAt     DateTime @default(now())

  podcast     Podcast      @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  interaction Interaction? @relation(fields: [interactionId], references: [id])
  segments    PodcastVersionSegment[]

  @@unique([podcastId, version])
  @@index([podcastId])
}

model PodcastVersionSegment {
  id        String @id @default(cuid())
  versionId String
  segmentId String
  order     Int
  startTime Float?

  version PodcastVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

// ============ INTERACTIONS (Q&A during playback) ============

model Interaction {
  id        String            @id @default(cuid())
  podcastId String
  userId    String
  status    InteractionStatus @default(PENDING)

  // Question context
  question  String @db.Text
  timestamp Float  // playback position in seconds

  // Answer
  answer String? @db.Text

  // Resolution
  resolved     Boolean @default(false)
  incorporated Boolean @default(false) // baked into podcast
  helpful      Boolean? // null = no feedback, true/false = user response
  segmentOrder Int?     // computed by worker: which segment the question maps to

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  podcast  Podcast          @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions PodcastVersion[]

  @@index([podcastId])
  @@index([userId])
  @@index([status])
}

enum InteractionStatus {
  PENDING
  ANSWERING
  ANSWERED
  RESOLVED
  INCORPORATING
  INCORPORATED
}

// ============ SOCIAL: LIKES & SAVES ============

model Like {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([podcastId])
}

model Save {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([podcastId])
}

// ============ TAGS ============

model Tag {
  id            String         @id @default(cuid())
  name          String         @unique
  slug          String         @unique
  podcasts      PodcastTag[]
  userInterests UserInterest[]

  @@index([slug])
}

model PodcastTag {
  id        String @id @default(cuid())
  podcastId String
  tagId     String

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([podcastId, tagId])
  @@index([tagId])
}

// ============ USER INTERESTS ============

model UserInterest {
  id        String   @id @default(cuid())
  userId    String
  tagId     String
  source    String   @default("onboarding") // "onboarding" | "behavioral" | "manual"
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([userId])
  @@index([tagId])
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  data      Json?
  read      Boolean          @default(false)
  pushed    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

enum NotificationType {
  PODCAST_READY
  PODCAST_LIKED
  PODCAST_FORKED
  NEW_FOLLOWER
  SIMILAR_PODCAST_CREATED
  TEAM_INVITE
  TWITTER_PODCAST_READY
  VOICE_REQUEST_RECEIVED
  VOICE_REQUEST_APPROVED
  VOICE_REQUEST_DENIED
}

// ============ PUSH SUBSCRIPTIONS ============

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ EXPO PUSH TOKENS (mobile) ============

model ExpoPushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   // "ios" | "android"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ JOBS (BullMQ tracking) ============

model Job {
  id        String   @id @default(cuid())
  podcastId String?
  type      String
  payload   Json
  status    String   // pending, processing, complete, failed
  result    Json?
  error     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  podcast Podcast? @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([type, status])
  @@index([podcastId])
  @@index([status])
  @@index([createdAt])
}

// ============ API USAGE TRACKING ============

model ApiUsageLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  podcastId String?
  userId    String?
  service   String   // claude, elevenlabs, ffmpeg
  category  String   // discovery, script_generation, audio_generation, interaction

  // Cost tracking
  inputTokens  Int?
  outputTokens Int?
  totalCost    Float

  // Performance
  durationMs Int?

  metadata Json @default("{}")

  user User? @relation(fields: [userId], references: [id])

  @@index([podcastId])
  @@index([userId])
  @@index([createdAt])
  @@index([service])
}

// ============ FEEDBACK (Early Access) ============

model Feedback {
  id        String         @id @default(cuid())
  userId    String?
  email     String?
  name      String?
  type      FeedbackType
  rating    Int?           // 1-5 stars
  subject   String
  message   String         @db.Text
  context   String?        // page/feature where feedback was given
  status    FeedbackStatus @default(NEW)
  response  String?        @db.Text // admin response
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  GENERAL
  PRAISE
  CONCERN
}

enum FeedbackStatus {
  NEW
  REVIEWED
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

// ============ TWITTER MENTIONS ============

model TweetMention {
  id            String             @id @default(cuid())
  tweetId       String             @unique
  authorId      String             // Twitter numeric user ID
  text          String             @db.Text
  parsedTopic   String?            @db.Text
  status        TweetMentionStatus @default(PENDING)
  userId        String?
  podcastId     String?            @unique
  replyTweetId  String?
  parentTweetId String?
  errorMessage  String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  podcast Podcast? @relation(fields: [podcastId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

enum TweetMentionStatus {
  PENDING
  PARSING
  GENERATING
  READY
  REPLIED
  FAILED
  IGNORED
}

// ============ RECOMMENDATION ENGINE ============

model RecommendationLog {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  surface   String   // picks, explore, trending
  position  Int
  score     Float
  signals   Json     // {relevance, collaborative, quality, freshness, novelty}
  explanation String @db.Text
  impressed   Boolean @default(false)
  clicked     Boolean @default(false)
  queued      Boolean @default(false)
  listenedPercent Float?
  refreshBatch Int   @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([podcastId, createdAt])
  @@index([surface, createdAt])
}

model ListeningQueue {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  position  Int
  addedAt   DateTime @default(now())
  source    String   // picks, explore, following, search

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([userId, position])
}

// ============ ML FEATURE STORE ============

model UserFeature {
  id     String @id @default(cuid())
  userId String @unique

  // Engagement
  totalListenMinutes      Float @default(0)
  totalPodcastsListened   Int   @default(0)
  avgCompletionRate       Float @default(0)
  avgListenSpeed          Float @default(1)

  // Abandonment
  avgAbandonPercent Float @default(0)
  optimalDuration   Float @default(10) // minutes where highest completion

  // Preferences (inferred from behavior)
  preferredDepth         String? // quick_overview, standard, deep_dive
  preferredTone          String? // casual, professional, socratic
  preferredAudienceLevel String? // beginner, intermediate, expert
  preferredDuration      Float?  // minutes

  // Affinities
  topicAffinity Json? // [{tagId, weight}]
  voiceAffinity Json? // [{voiceId, completionRate}]

  // Social
  followingCount   Int   @default(0)
  followerCount    Int   @default(0)
  likeRate         Float @default(0)
  forkRate         Float @default(0)
  interactionRate  Float @default(0)
  creatorLoyalty   Float @default(0)

  // Behavioral
  archetype         String? // deep_listener, skimmer, explorer, completer, social_learner
  speakerPreference Float   @default(0) // -1 to 1
  noveltyResponseRate Float @default(0)

  // Temporal
  peakListeningHours   Json? // [{hour, listenMinutes}]
  postListenBehavior   Json? // {liked: pct, saved: pct, forked: pct, ...}
  topicProgressionPath Json? // [{topic, depth, timestamp}]

  // Recency
  daysSinceLastListen Float @default(0)
  listenFrequency     Float @default(0)

  // Vector (pgvector)
  embedding Unsupported("vector(384)")?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([archetype])
}

model PodcastFeature {
  id        String @id @default(cuid())
  podcastId String @unique

  // Quality
  avgCompletionRate    Float @default(0)
  medianCompletionRate Float @default(0)
  totalUniqueListeners Int   @default(0)
  totalListenMinutes   Float @default(0)

  // Engagement
  likeToListenRatio  Float @default(0)
  saveToListenRatio  Float @default(0)
  forkToListenRatio  Float @default(0)
  interactionRate    Float @default(0)

  // Abandonment
  abandonmentCurve         Json?  // [{percentBucket, abandonRate}] in 5% increments
  segmentAbandonRates      Json?  // [{segmentOrder, speaker, abandonRate}]
  questionThenAbandonRate  Float  @default(0)

  // Playback
  avgListenSpeed    Float @default(1)
  speedDistribution Json? // {1x: pct, 1.25x: pct, ...}
  dropoffPoints     Json? // [{position, dropoffRate}]
  seekHotspots      Json? // [{position, seekCount}]

  // Re-engagement
  relistenRate       Float @default(0)
  completionBySource Json? // {feed: pct, recommendation: pct, search: pct, direct: pct}

  // Content
  segmentCount          Int   @default(0)
  durationSeconds       Int   @default(0)
  referenceCount        Int   @default(0)
  verifiedReferenceRate Float @default(0)
  questionDensityByPosition Json? // [{percentBucket, questionsPerListener}]

  // Vector (pgvector)
  embedding Unsupported("vector(384)")?

  podcast    Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([podcastId])
  @@index([avgCompletionRate])
}

// ============ BEHAVIORAL EVENTS (ML Data Pipeline) ============

model BehavioralEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String?
  sessionId String
  eventType String   // e.g. playback.play, feed.impression
  eventData Json     // event-specific payload

  podcastId  String?
  pageUrl    String?  @db.Text
  deviceType String?
  userAgent  String?  @db.VarChar(512)
  referrer   String?  @db.Text
  clientTs   DateTime?

  @@index([userId, eventType, createdAt])
  @@index([podcastId, eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
}

model UserSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  userId    String?
  startedAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  deviceType String?
  userAgent  String?  @db.VarChar(512)
  ipHash     String?  @db.VarChar(64) // SHA-256 of IP, never raw
  referrer   String?  @db.Text
  pageCount  Int      @default(1)

  @@index([userId, startedAt])
  @@index([sessionId])
}

model PlaybackSession {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String
  podcastId String
  startedAt DateTime @default(now())
  endedAt   DateTime?

  // Aggregates
  totalListenSeconds Float  @default(0)
  maxPosition        Float  @default(0)
  completionPercent  Float  @default(0)

  // Behavior
  pauseCount     Int    @default(0)
  seekCount      Int    @default(0)
  speedChanges   Int    @default(0)
  lastSpeed      Float  @default(1)
  interruptCount Int    @default(0)

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([userId, podcastId])
  @@index([podcastId, startedAt])
  @@index([userId, startedAt])
}

// ============ WAITLIST ============

model Waitlist {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String?  // "hero", "footer", "cta" — where they signed up
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// ============ API KEYS ============

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  keyPrefix  String    // first 16 chars for display (sk_sotto_XXXX...)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

// ============ VOICE CLONES ============

model VoiceClone {
  id                String           @id @default(cuid())
  userId            String
  name              String
  elevenLabsVoiceId String           @unique
  sourceType        VoiceCloneSource
  sampleUrl         String?
  requestable       Boolean          @default(false)
  createdAt         DateTime         @default(now())

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceRequests VoiceRequest[]
  allowlist     VoiceAllowlist[]

  @@index([userId])
}

enum VoiceCloneSource {
  UPLOAD
  RECORD
}

// ============ VOICE ALLOWLIST ============

model VoiceAllowlist {
  id            String   @id @default(cuid())
  voiceCloneId  String
  allowedUserId String
  createdAt     DateTime @default(now())

  voiceClone  VoiceClone @relation(fields: [voiceCloneId], references: [id], onDelete: Cascade)
  allowedUser User       @relation("VoiceAllowlisted", fields: [allowedUserId], references: [id], onDelete: Cascade)

  @@unique([voiceCloneId, allowedUserId])
  @@index([allowedUserId])
}

// ============ REFERENCES (Citations) ============

model Reference {
  id        String        @id @default(cuid())
  podcastId String
  number    Int
  title     String        @db.Text
  authors   String[]
  year      Int?
  url       String?       @db.Text
  type      ReferenceType @default(WEB)
  publisher String?
  doi       String?
  createdAt DateTime      @default(now())

  // Verification
  verificationStatus  VerificationStatus @default(PENDING)
  verificationDetails Json?
  originalTitle       String?            @db.Text

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([podcastId, number])
  @@index([podcastId])
}

enum ReferenceType {
  WEB
  PAPER
  BOOK
  ARTICLE
  VIDEO
  REPORT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  REPLACED
  REMOVED
}

// ============ RESERVED HANDLES ============

model ReservedHandle {
  id        String   @id @default(cuid())
  handle    String   @unique
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())
}

// ============ VOICE REQUESTS ============

model VoiceRequest {
  id           String             @id @default(cuid())
  requesterId  String
  voiceOwnerId String
  voiceCloneId String
  status       VoiceRequestStatus @default(PENDING)
  message      String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  requester  User       @relation("VoiceRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  voiceOwner User       @relation("VoiceOwner", fields: [voiceOwnerId], references: [id], onDelete: Cascade)
  voiceClone VoiceClone @relation(fields: [voiceCloneId], references: [id], onDelete: Cascade)

  @@unique([requesterId, voiceCloneId])
  @@index([voiceOwnerId])
  @@index([status])
}

enum VoiceRequestStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
}

// ============ USER TTS KEYS (Multi-Provider BYOK) ============

model UserTtsKey {
  id           String    @id @default(cuid())
  userId       String
  provider     String    // 'elevenlabs' | 'openai' | 'playht' | 'cartesia' | 'hume'
  encryptedKey String    @db.Text
  extraData    String?   @db.Text // encrypted JSON for multi-field auth (e.g. PlayHT userId)
  isValid      Boolean   @default(true)
  label        String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}
