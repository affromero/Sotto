  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  podcast Podcast? @relation(fields: [podcastId], references: [id], onDelete: SetNull)

  @@index([telegramUserId])
  @@index([chatId])
  @@index([status])
  @@index([createdAt])
}

enum TelegramMessageStatus {
  PENDING
  DISCOVERING
  GENERATING
  READY
  REPLIED
  FAILED
  IGNORED
}

// ============ PODCAST IDEAS (Telegram Save-for-Later) ============

model PodcastIdea {
  id        String   @id @default(cuid())
  userId    String
  text      String   @db.Text
  sourceUrl String?
  source    String   @default("telegram")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============ RECOMMENDATION ENGINE ============

model RecommendationLog {
  id              String   @id @default(cuid())
  userId          String
  podcastId       String
  surface         String // picks, explore, trending
  position        Int
  score           Float
  signals         Json // {relevance, collaborative, quality, freshness, novelty}
  explanation     String   @db.Text
  impressed       Boolean  @default(false)
  clicked         Boolean  @default(false)
  queued          Boolean  @default(false)
  listenedPercent Float?
  refreshBatch    Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
  @@index([podcastId, createdAt])
  @@index([surface, createdAt])
}

model ListeningQueue {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  position  Int
  addedAt   DateTime @default(now())
  source    String // picks, explore, search

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([userId, position])
}

// ============ ML FEATURE STORE ============

model UserFeature {
  id     String @id @default(cuid())
  userId String @unique

  // Engagement
  totalListenMinutes    Float @default(0)
  totalPodcastsListened Int   @default(0)
  avgCompletionRate     Float @default(0)
  avgListenSpeed        Float @default(1)

  // Abandonment
  avgAbandonPercent Float @default(0)
  optimalDuration   Float @default(10) // minutes where highest completion

  // Preferences (inferred from behavior)
  preferredDepth         String? // eli5, quick_overview, standard, deep_dive
  preferredTone          String? // casual, professional, socratic
  preferredAudienceLevel String? // beginner, intermediate, expert
  preferredDuration      Float? // minutes

  // Affinities
  topicAffinity Json? // [{tagId, weight}]
  voiceAffinity Json? // [{voiceId, completionRate}]

  // Private activity
  interactionRate Float @default(0)
  creatorLoyalty  Float @default(0)

  // Behavioral
  archetype           String? // deep_listener, skimmer, explorer, completer, active_learner
  speakerPreference   Float   @default(0) // -1 to 1
  noveltyResponseRate Float   @default(0)

  // Temporal
  peakListeningHours   Json? // [{hour, listenMinutes}]
  postListenBehavior   Json? // {saved: pct, asked: pct, rated: pct, ...}
  topicProgressionPath Json? // [{topic, depth, timestamp}]

  // Recency
  daysSinceLastListen Float @default(0)
  listenFrequency     Float @default(0)

  // Vector (pgvector)
  embedding Unsupported("vector(384)")?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([archetype])
}

model PodcastFeature {
  id        String @id @default(cuid())
  podcastId String @unique

  // Quality
  avgCompletionRate    Float @default(0)
  medianCompletionRate Float @default(0)
  totalUniqueListeners Int   @default(0)
  totalListenMinutes   Float @default(0)

  // Private activity
  saveToListenRatio Float @default(0)
  interactionRate   Float @default(0)

  // Abandonment
  abandonmentCurve        Json? // [{percentBucket, abandonRate}] in 5% increments
  segmentAbandonRates     Json? // [{segmentOrder, speaker, abandonRate}]
  questionThenAbandonRate Float @default(0)

  // Playback
  avgListenSpeed    Float @default(1)
  speedDistribution Json? // {1x: pct, 1.25x: pct, ...}
  dropoffPoints     Json? // [{position, dropoffRate}]
  seekHotspots      Json? // [{position, seekCount}]

  // Re-engagement
  relistenRate       Float @default(0)
  completionBySource Json? // {feed: pct, recommendation: pct, search: pct, direct: pct}

  // Content
  segmentCount              Int   @default(0)
  durationSeconds           Int   @default(0)
  referenceCount            Int   @default(0)
  verifiedReferenceRate     Float @default(0)
  questionDensityByPosition Json? // [{percentBucket, questionsPerListener}]

  // Vector (pgvector)
  embedding Unsupported("vector(384)")?

  podcast    Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([podcastId])
  @@index([avgCompletionRate])
}

// ============ BEHAVIORAL EVENTS (ML Data Pipeline) ============

model BehavioralEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String?
  sessionId String
  eventType String // e.g. playback.play, feed.impression
  eventData Json // event-specific payload

  podcastId  String?
  pageUrl    String?   @db.Text
  deviceType String?
  userAgent  String?   @db.VarChar(512)
  referrer   String?   @db.Text
  clientTs   DateTime?

  @@index([userId, eventType, createdAt])
  @@index([podcastId, eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
}

model UserSession {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  userId     String?
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  deviceType String?
  userAgent  String? @db.VarChar(512)
  ipHash     String? @db.VarChar(64) // SHA-256 of IP, never raw
  country    String? @db.VarChar(2) // ISO 3166-1 alpha-2 (e.g. "US")
  referrer   String? @db.Text
  pageCount  Int     @default(1)

  @@index([userId, startedAt])
  @@index([sessionId])
  @@index([country])
}

model PlaybackSession {
  id        String    @id @default(cuid())
  userId    String?
  sessionId String
  podcastId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Aggregates
  totalListenSeconds Float @default(0)
  maxPosition        Float @default(0)
  completionPercent  Float @default(0)

  // Behavior
  pauseCount     Int   @default(0)
  seekCount      Int   @default(0)
  speedChanges   Int   @default(0)
  lastSpeed      Float @default(1)
  interruptCount Int   @default(0)

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([userId, podcastId])
  @@index([podcastId, startedAt])
  @@index([userId, startedAt])
}

// ============ WAITLIST ============

enum WaitlistStatus {
  PENDING
  APPROVED
  REJECTED
}

model Waitlist {
  id            String         @id @default(cuid())
  email         String         @unique
  twitterHandle String?
  source        String?
  wishlist      String?
  referralCode  String?
  status        WaitlistStatus @default(PENDING)
  unsubscribed  Boolean        @default(false)
  approvedAt    DateTime?
  approvedBy    String?
  signedUpAt    DateTime?
  createdAt     DateTime       @default(now())

  @@index([createdAt])
  @@index([status])
}

// ============ INVITATION LINKS ============

model InvitationLink {
  id        String    @id @default(cuid())
  code      String    @unique
  createdBy String
  email     String?
  enabled   Boolean   @default(true)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  creator User @relation("InvitationLinksCreated", fields: [createdBy], references: [id])

  @@index([code])
  @@index([createdBy])
}

// ============ API KEYS ============

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  keyPrefix  String // first 16 chars for display (sk_sotto_XXXX...)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

// ============ PRIVATE RSS FEEDS ============

model PrivateFeedToken {
  id         String    @id @default(cuid())
  userId     String
  name       String    @default("Private Sotto Feed")
  tokenHash  String    @unique
  feedType   String    @default("all")
  lastUsedAt DateTime?
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
}

// ============ VOICE CLONES ============

model VoiceClone {
  id                 String                  @id @default(cuid())
  userId             String
  name               String
  provider           String                  @default("elevenlabs")
  externalVoiceId    String
  sourceType         VoiceCloneSource
  sampleUrl          String?
  description        String?                 @db.VarChar(200)
  requestable        Boolean                 @default(false)
  priceInCents       Int? // null = free, 0+ = paid per-podcast
  verificationStatus VoiceVerificationStatus @default(PENDING_VERIFICATION)
  createdAt          DateTime                @default(now())

  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceRequests          VoiceRequest[]
  allowlist              VoiceAllowlist[]
  voicePurchases         VoicePurchase[]
  fingerprint            VoiceFingerprint?
  verificationChallenges VoiceVerificationChallenge[]
  similarityMatchesAs    VoiceSimilarityMatch[]       @relation("MatchedVoice")
  blockedMatchesAs       VoiceSimilarityMatch[]       @relation("BlockedVoice")

  @@unique([userId, provider, externalVoiceId])
  @@index([userId])
  @@index([verificationStatus])
}

enum VoiceCloneSource {
  UPLOAD
  RECORD
  IMPORT
}

enum VoiceVerificationStatus {
  PENDING_VERIFICATION
  AWAITING_CHALLENGE
  CHALLENGE_SUBMITTED
  VERIFIED
  BLOCKED
  REJECTED
  ADMIN_VERIFIED
  ADMIN_BLOCKED
  PROTECTED
}

// ============ VOICE ALLOWLIST ============

model VoiceAllowlist {
  id            String   @id @default(cuid())
  voiceCloneId  String
  allowedUserId String
  createdAt     DateTime @default(now())

  voiceClone  VoiceClone @relation(fields: [voiceCloneId], references: [id], onDelete: Cascade)
  allowedUser User       @relation("VoiceAllowlisted", fields: [allowedUserId], references: [id], onDelete: Cascade)

  @@unique([voiceCloneId, allowedUserId])
  @@index([allowedUserId])
}

// ============ VOICE FINGERPRINTS ============

model VoiceFingerprint {
  id           String   @id @default(cuid())
  voiceCloneId String   @unique
  embedding    Float[]
  modelVersion String
  audioUrl     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  voiceClone VoiceClone @relation(fields: [voiceCloneId], references: [id], onDelete: Cascade)
}

// ============ VOICE VERIFICATION CHALLENGES ============

model VoiceVerificationChallenge {
  id            String   @id @default(cuid())
  voiceCloneId  String
  phrase        String
  recordingUrl  String?
  similarity    Float?
  passed        Boolean?
  attemptNumber Int
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  voiceClone VoiceClone @relation(fields: [voiceCloneId], references: [id], onDelete: Cascade)

  @@index([voiceCloneId])
}

// ============ VOICE SIMILARITY MATCHES ============

model VoiceSimilarityMatch {
  id             String   @id @default(cuid())
  matchedVoiceId String
  blockedVoiceId String
  similarity     Float
  resolvedBy     String?
  resolution     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  matchedVoice VoiceClone @relation("MatchedVoice", fields: [matchedVoiceId], references: [id], onDelete: Cascade)
  blockedVoice VoiceClone @relation("BlockedVoice", fields: [blockedVoiceId], references: [id], onDelete: Cascade)

  @@index([matchedVoiceId])
  @@index([blockedVoiceId])
}

// ============ REFERENCES (Citations) ============

model Reference {
  id        String        @id @default(cuid())
  podcastId String
  number    Int
  title     String        @db.Text
  authors   String[]
  year      Int?
  url       String?       @db.Text
  type      ReferenceType @default(WEB)
  publisher String?
  doi       String?
  createdAt DateTime      @default(now())

  // Verification
  verificationStatus  VerificationStatus @default(PENDING)
  verificationDetails Json?
  originalTitle       String?            @db.Text
  contentDomain       String? // 'ACADEMIC' | 'NEWS' | 'GOVERNMENT' | 'EDUCATIONAL' | 'GENERAL'

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([podcastId, number])
  @@index([podcastId])
}

model VocabularyEntry {
  id              String   @id @default(cuid())
  podcastId       String
  number          Int // [V1], [V2] marker index, 1-based
  word            String // target language word/phrase
  translation     String // native language translation
  partOfSpeech    String? // noun, verb, adjective, etc.
  pronunciation   String? // phonetic guide (e.g. "SHPREE-chen")
  exampleSentence String?  @db.Text // usage in context
  difficulty      String? // beginner, intermediate, advanced
  createdAt       DateTime @default(now())

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([podcastId, number])
  @@index([podcastId])
}

enum ReferenceType {
  WEB
  PAPER
  BOOK
  ARTICLE
  VIDEO
  REPORT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  REPLACED
  REMOVED
}

// ============ RESERVED HANDLES ============

model ReservedHandle {
  id        String   @id @default(cuid())
  handle    String   @unique
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())
}

// ============ VOICE REQUESTS ============

model VoiceRequest {
  id           String             @id @default(cuid())
  requesterId  String
  voiceOwnerId String
  voiceCloneId String
  status       VoiceRequestStatus @default(PENDING)
  message      String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  requester  User       @relation("VoiceRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  voiceOwner User       @relation("VoiceOwner", fields: [voiceOwnerId], references: [id], onDelete: Cascade)
  voiceClone VoiceClone @relation(fields: [voiceCloneId], references: [id], onDelete: Cascade)

  @@unique([requesterId, voiceCloneId])
  @@index([voiceOwnerId])
  @@index([status])
}

enum VoiceRequestStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
}

// ============ USER TTS KEYS (Multi-Provider BYOK) ============

model UserTtsKey {
  id           String    @id @default(cuid())
  userId       String
  provider     String // 'elevenlabs' | 'openai' | 'cartesia' | 'hume' | 'fal' | 'replicate'
  encryptedKey String    @db.Text
  extraData    String?   @db.Text // encrypted JSON for multi-field auth
  isValid      Boolean   @default(true)
  label        String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// ============ USER AI KEYS (LLM BYOK) ============

model UserAiKey {
  id           String    @id @default(cuid())
  userId       String
  provider     String // 'anthropic' | 'openai'
  encryptedKey String    @db.Text
  isValid      Boolean   @default(true)
  label        String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// ============ COLLECTIONS (Curated Playlists) ============

model Collection {
  id           String   @id @default(cuid())
  name         String
  description  String?  @db.Text
  userId       String
  isPublic     Boolean  @default(true)
  podcastCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user  User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CollectionItem[]

  @@index([userId])
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  podcastId    String
  order        Int      @default(0)
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  podcast    Podcast    @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([collectionId, podcastId])
  @@index([collectionId])
}

