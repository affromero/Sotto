  twitterHandle String  @default("andres")
  twitterName   String  @default("Andres")
  telegramTopic String? // null = derive from podcast topic

  updatedAt DateTime @updatedAt
  updatedBy String?

  podcast Podcast @relation(fields: [podcastId], references: [id])

  @@index([podcastId])
}

// ============ REPORTS ============

enum ReportReason {
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  SEXUAL_CONTENT
  MISINFORMATION
  SPAM
  IMPERSONATION
  COPYRIGHT
  VOICE_THEFT
  MUSIC_UPLOAD
  FALSE_HUMAN_BADGE
  FALSE_CLAIM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED_ACTIONED
  RESOLVED_DISMISSED
  ASSET_REPLACED
  DELISTED
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  targetType  String // 'podcast' | 'comment' | 'user'
  targetId    String
  reason      ReportReason
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  resolvedBy  String?
  resolution  String?      @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  // Copyright claim fields (used when reason = COPYRIGHT)
  claimantEmail   String?
  claimantName    String?
  evidenceUrl     String?
  segmentVisualId String?
  counterNotice   String? @db.Text

  reporter      User           @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  segmentVisual SegmentVisual? @relation(fields: [segmentVisualId], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ContentFlag {
  id         String   @id @default(cuid())
  targetType String // 'podcast' | 'comment' | 'discovery_message'
  targetId   String
  userId     String?
  categories String[]
  scores     Json
  source     String // 'auto_input' | 'auto_output' | 'worker_scan'
  reviewed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([reviewed, createdAt])
  @@index([targetType, targetId])
}

// ============ CLAIM REPORTS ============

enum ClaimReportStatus {
  PENDING
  REVIEWING
  RESOLVED_VERIFIED
  RESOLVED_INACCURATE
  DISMISSED
}

model ClaimReport {
  id          String            @id @default(cuid())
  reporterId  String
  podcastId   String
  turnIndex   Int
  turnText    String            @db.Text
  description String            @db.Text
  status      ClaimReportStatus @default(PENDING)
  resolvedBy  String?
  resolution  String?           @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())

  reporter User    @relation("ClaimReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  podcast  Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([reporterId, podcastId, turnIndex])
  @@index([podcastId, status])
  @@index([status, createdAt])
}

// ============ VOICE TRACKS ============

enum VoiceTrackStatus {
  PENDING
  GENERATING_AUDIO
  STITCHING
  READY
  FAILED
  STALE
}

enum ProposalStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model VoiceTrack {
  id            String           @id @default(cuid())
  podcastId     String
  name          String
  status        VoiceTrackStatus @default(PENDING)
  audioUrl      String?
  duration      Int?
  fileSize      Int?
  ttsProvider   String?
  ttsModel      String?
  failureReason String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  // Re-voice proposal fields
  contributorId         String?
  proposalStatus        ProposalStatus?
  proposalMessage       String?         @db.Text
  proposedFromPodcastId String?
  reviewedAt            DateTime?
  rejectionReason       String?         @db.Text

  podcast             Podcast             @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  contributor         User?               @relation("VoiceTrackContributions", fields: [contributorId], references: [id], onDelete: SetNull)
  proposedFromPodcast Podcast?            @relation("VoiceTrackProposals", fields: [proposedFromPodcastId], references: [id], onDelete: SetNull)
  voices              VoiceTrackVoice[]
  segments            VoiceTrackSegment[]
  avatarOverlays      AvatarOverlay[]
  videoGenerations    VideoGeneration[]

  @@index([podcastId])
  @@index([status])
  @@index([contributorId])
  @@index([proposalStatus])
}

model VoiceTrackVoice {
  id           String  @id @default(cuid())
  voiceTrackId String
  speaker      String
  voiceId      String
  provider     String? // TTS provider that assigned the voiceId
  ttsModel     String? // TTS model for this speaker's provider

  voiceTrack VoiceTrack @relation(fields: [voiceTrackId], references: [id], onDelete: Cascade)

  @@unique([voiceTrackId, speaker])
}

model VoiceTrackSegment {
  id           String  @id @default(cuid())
  voiceTrackId String
  segmentId    String
  audioUrl     String?
  duration     Float?
  startTime    Float?
  order        Int

  voiceTrack VoiceTrack @relation(fields: [voiceTrackId], references: [id], onDelete: Cascade)
  segment    Segment    @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([voiceTrackId, segmentId])
  @@index([voiceTrackId])
}

// ============ AUDIO FINGERPRINTING & DUPLICATE DETECTION ============

model AudioFingerprint {
  id          String   @id @default(cuid())
  podcastId   String   @unique
  fingerprint Int[]
  duration    Int // seconds
  createdAt   DateTime @default(now())

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([duration])
}

enum DuplicateMatchStatus {
  PENDING
  APPROVED
  REJECTED
}

model DuplicateMatch {
  id               String               @id @default(cuid())
  sourcePodcastId  String
  matchedPodcastId String
  similarity       Float
  status           DuplicateMatchStatus @default(PENDING)
  reviewedBy       String?
  resolution       String?              @db.Text
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  sourcePodcast  Podcast @relation("DuplicateSource", fields: [sourcePodcastId], references: [id], onDelete: Cascade)
  matchedPodcast Podcast @relation("DuplicateMatch", fields: [matchedPodcastId], references: [id], onDelete: Cascade)

  @@unique([sourcePodcastId, matchedPodcastId])
  @@index([status])
}

// ============ R2 USAGE MONITORING ============

model R2UsageSnapshot {
  id                  String   @id @default(cuid())
  bucket              String
  payloadSizeBytes    Float
  metadataSizeBytes   Float
  objectCount         Int
  uploadCount         Int
  classAOps           Int      @default(0)
  classBOps           Int      @default(0)
  freeOps             Int      @default(0)
  storageCostEstimate Float    @default(0)
  classACostEstimate  Float    @default(0)
  classBCostEstimate  Float    @default(0)
  totalCostEstimate   Float    @default(0)
  prefixBreakdown     Json?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([bucket, createdAt])
}

// ============ MODEL PRICING SNAPSHOTS ============

model ModelPricingSnapshot {
  id              String   @id @default(cuid())
  modelId         String
  provider        String
  inputPerMTok    Float
  outputPerMTok   Float
  contextWindow   Int?
  maxOutputTokens Int?
  source          String   @default("registry") // "registry" | "fetched" | "admin"
  createdAt       DateTime @default(now())

  @@index([modelId, createdAt])
  @@index([createdAt])
}

// ============ VIDEO GENERATION ============

model VideoGeneration {
  id             String      @id @default(cuid())
  podcastId      String
  voiceTrackId   String?
  status         VideoStatus @default(PENDING)
  videoUrl       String?
  duration       Int? // seconds
  fileSize       Int? // bytes
  width          Int         @default(1280)
  height         Int         @default(720)
  imageProvider  String? // null = auto (fal)
  imageModel     String? // e.g. 'fal-flux-2-pro', 'fal-recraft-v3'
  videoModel     String? // e.g. 'fal-veo3-1080p', 'fal-kling3-1080p'
  pipelineJson   Json? // Approved pipeline editor state
  avatarsVisible Boolean     @default(true)
  zeroCostVideo  Boolean     @default(false) // no AI illustrations, free visuals only
  failureReason  String?     @db.Text
  technicalError String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  podcast        Podcast             @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  voiceTrack     VoiceTrack?         @relation(fields: [voiceTrackId], references: [id], onDelete: Cascade)
  visuals        SegmentVisual[]
  avatarOverlays AvatarOverlay[]
  transitions    SegmentTransition[]

  @@unique([podcastId, voiceTrackId])
  @@index([podcastId])
}

// ============ MUSIC GENERATION ============

model MusicGeneration {
  id             String      @id @default(cuid())
  podcastId      String
  status         MusicStatus @default(PENDING)
  musicUrl       String?
  duration       Int? // seconds
  fileSize       Int? // bytes
  provider       String? // 'suno' | 'elevenlabs'
  model          String? // e.g., 'suno-v5', 'eleven-music-v1'
  prompt         String?     @db.Text
  externalTaskId String? // Suno taskId for async polling
  failureReason  String?     @db.Text
  selected       Boolean     @default(false)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([podcastId])
  @@index([podcastId, selected])
}

model SegmentTransition {
  id                String  @id @default(cuid())
  videoGenerationId String
  fromSegmentId     String
  toSegmentId       String
  fromSegmentOrder  Int
  toSegmentOrder    Int
  transitionModel   String? // pricetoken model ID (FLF2V-capable video model)
  prompt            String? @db.Text
  assetUrl          String?
  assetType         String? // 'video/mp4'
  status            String  @default("pending") // pending | generating | ready | failed
  failureReason     String? @db.Text
  cost              Float?
  recommended       Boolean @default(false)
  enabled           Boolean @default(true)
  durationSeconds   Float   @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videoGeneration VideoGeneration @relation(fields: [videoGenerationId], references: [id], onDelete: Cascade)
  fromSegment     Segment         @relation("TransitionFrom", fields: [fromSegmentId], references: [id], onDelete: Cascade)
  toSegment       Segment         @relation("TransitionTo", fields: [toSegmentId], references: [id], onDelete: Cascade)

  @@unique([videoGenerationId, fromSegmentId, toSegmentId])
  @@index([videoGenerationId])
}

model SegmentVisual {
  id                String     @id @default(cuid())
  videoGenerationId String
  segmentId         String
  order             Int
  subOrder          Int        @default(0) // ordering within parent segment (0, 1, 2...)
  startOffset       Float      @default(0) // seconds from parent segment start
  subDuration       Float? // seconds; null = full segment duration
  visualType        VisualType
  prompt            String?    @db.Text
  metadata          Json? // type-specific: chart data, quote text, timeline events, etc.
  visualMode        String? // 'image' | 'video' | 'programmatic'
  videoModel        String? // pricetoken model ID for video mode
  endStatePrompt    String?    @db.Text
  firstFrameUrl     String?
  lastFrameUrl      String?
  assetUrl          String? // R2 URL of generated image/video
  assetType         String? // 'image/png' | 'video/mp4'
  motionProvider    String? // 'remotion' | 'hera' — which motion provider rendered this visual
  status            String     @default("pending") // pending | generating | ready | failed
  failureReason     String?    @db.Text
  previewUrl        String? // R2 URL of per-segment preview MP4
  previewStatus     String? // pending | rendering | ready | failed
  previewQuality    String? // 'preview' | 'full'
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  videoGeneration VideoGeneration @relation(fields: [videoGenerationId], references: [id], onDelete: Cascade)
  segment         Segment         @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  reports         Report[]

  @@index([videoGenerationId])
  @@index([segmentId])
  @@index([segmentId, subOrder])
}

model AvatarOverlay {
  id                   String   @id @default(cuid())
  videoGenerationId    String
  speaker              String
  avatarId             String
  avatarName           String?
  previewImageUrl      String?
  heygenVideoId        String?
  videoUrl             String?
  concatAudioUrl       String?
  status               String   @default("pending")
  failureReason        String?  @db.Text
  durationSeconds      Float?
  avatarProvider       String?
  avatarImageUrl       String?
  avatarModelId        String?
  falRequestId         String?
  falChunkIndex        Int?
  falTotalChunks       Int?
  maskShape            String?
  runwaySessionId      String?
  runwayChunkIndex     Int?
  runwayTotalChunks    Int?
  chunkVideoUrl        String?
  chunkDurationSeconds Float?
  enabledSegmentIds    String[] @default([])
  voiceTrackId         String?
  posX                 Float    @default(0.02)
  posY                 Float    @default(0.55)
  width                Float    @default(0.25)
  height               Float    @default(0.35)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  videoGeneration VideoGeneration @relation(fields: [videoGenerationId], references: [id], onDelete: Cascade)
  voiceTrack      VoiceTrack?     @relation(fields: [voiceTrackId], references: [id], onDelete: SetNull)

  @@unique([videoGenerationId, speaker])
  @@index([videoGenerationId])
  @@index([voiceTrackId])
}

enum AvatarImageSource {
  UPLOAD
  GENERATED
  DEFAULT
}

model AvatarImage {
  id                    String            @id @default(cuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  imageUrl              String
  sourceType            AvatarImageSource
  prompt                String?           @db.Text
  consentAcknowledgedAt DateTime?
  shareable             Boolean           @default(false)
  createdAt             DateTime          @default(now())

  shares AvatarImageShare[]

  @@unique([userId, name])
  @@index([userId])
}

enum AvatarImageShareStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
}

model AvatarImageShare {
  id            String                 @id @default(cuid())
  requesterId   String
  imageOwnerId  String
  avatarImageId String
  status        AvatarImageShareStatus @default(PENDING)
  message       String?                @db.Text
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  requester   User        @relation("AvatarShareRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  imageOwner  User        @relation("AvatarShareOwner", fields: [imageOwnerId], references: [id], onDelete: Cascade)
  avatarImage AvatarImage @relation(fields: [avatarImageId], references: [id], onDelete: Cascade)

  @@unique([requesterId, avatarImageId])
  @@index([imageOwnerId])
  @@index([status])
}

// ============ NEWS INGESTION ============

model IngestedArticle {
  id        String    @id @default(cuid())
  title     String
  url       String    @unique
  summary   String?   @db.Text
  source    String
  sourceUrl String?
  category  String?
  pubDate   DateTime?
  fetchedAt DateTime  @default(now())

  @@index([pubDate])
  @@index([category, pubDate])
  @@index([fetchedAt])
}

// ============ DEMO VIDEO STUDIO ============

enum DemoProjectStatus {
  DRAFT
  SCRIPT_READY
  GENERATING_ASSETS
  COMPOSING
  READY
  FAILED
}

enum DemoSceneAssetStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

model DemoProject {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  title        String
  description  String?
  features     String[] // feature slugs to demonstrate
  aiModel      String? // AI model for script generation (e.g. "claude-sonnet-4-20250514")
  status       DemoProjectStatus @default(DRAFT)
  failedReason String?
  videoUrl     String? // final composed video
  audioUrl     String? // final stitched voiceover

  // Default TTS config — applied to all new scenes
  defaultTtsProvider String?
  defaultTtsModel    String?
  defaultTtsVoiceId  String?

  // TTS providers to showcase — voice comparison baked into the creation flow
  showcaseProviders String[]

  // Launch video fields
  backgroundMusicUrl    String?
  backgroundMusicVolume Float?
  podcastId             String? // links to the podcast being showcased
  avatarClipUrl         String? // pre-generated avatar clip R2 URL

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  scenes    DemoScene[]

  @@index([userId])
}

model DemoScene {
  id        String      @id @default(cuid())
  projectId String
  project   DemoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int // 0-indexed scene order
  title     String // "User creates a podcast"
  narration String // voiceover text for this scene
  actions   Json // DemoAction[] — browser automation steps
  duration  Float? // estimated duration in seconds

  // Independent asset URLs — each generated separately
  recordingUrl     String?
  recordingStatus  DemoSceneAssetStatus @default(PENDING)
  voiceoverUrl     String?
  voiceoverStatus  DemoSceneAssetStatus @default(PENDING)
  visualUrl        String?
  visualStatus     DemoSceneAssetStatus @default(PENDING)
  visualType       String? // 'ai_image' | 'ai_video' | 'map' | null
  visualPrompt     String? // editable prompt for AI visual
  compositedUrl    String? // scene-level composite (recording + voiceover + visual)
  compositedStatus DemoSceneAssetStatus @default(PENDING)
  failedReason     String? // last error message from any asset worker

  // Timing — speed zones within the recording
  // TimingSegment[]: [{ start: 0, end: 5, speed: 1 }, { start: 5, end: 25, speed: 8 }, ...]
  // speed: 0 = skip/cut, null = play entire recording at 1x
  timingSegments Json?

  // TTS config per scene (admin picks voice)
  ttsProvider String?
  ttsModel    String?
  ttsVoiceId  String?

  // Transition to next scene
  transitionType   String? // 'fade' | 'dissolve' | 'wipe' | null
  transitionUrl    String? // generated transition clip
  transitionStatus DemoSceneAssetStatus @default(PENDING)

  // Launch video cinematic fields
  sfxConfig       Json? // SceneSfxConfig
  providerBanner  Json? // ProviderBannerConfig
  avatarConfig    Json? // AvatarConfig
  overlays        Json? // TextOverlayConfig[]
  subtitles       Json? // SubtitleConfig
  actionTimingLog Json? // ActionTimingEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, order])
}

// ============ DAILY BRIEFINGS ============

model UserBriefing {
  id        String   @id @default(cuid())
  userId    String
  name      String // "Morning Tech News", "Evening Finance"
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Schedule
  time      String // "HH:mm" (required)
  timezone  String // IANA timezone (required)
  days      Int       @default(127) // bitmask Mon=1..Sun=64
  nextRunAt DateTime? // pre-computed next eligible run time

  // Content
  prompt         String? @db.Text
  depth          String? // eli5, quick_overview, standard, deep_dive
  tone           String? // casual, professional, socratic, etc.
  audienceLevel  String? // beginner, intermediate, expert
  duration       Int? // target minutes 1-40
  format         Int     @default(2) // 1=Solo 2=Dialogue 3=Panel 4=Roundtable
  targetLanguage String? // ISO 639-1 code (e.g. "de") — null = English
  languageMode   String? // vocabulary_intro | conversational_mix | full_immersion

  // Audio
  aiModel       String?
  ttsProvider   String?
  ttsModel      String?
  hostVoiceId   String?
  expertVoiceId String?

  // Continuous Learning
  continuousLearning Boolean @default(false)
  contextEpisodes    Int     @default(3) // 1-5: how many prior episodes to include as context

  // Advanced
  visibility    PodcastVisibility @default(PRIVATE)
  useByokKeys   Boolean           @default(false)
  zeroCostVideo Boolean           @default(false) // free visuals only, skip verification

  // State
  lastGeneratedAt DateTime?

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  briefingLogs BriefingLog[]

  @@index([userId])
  @@index([enabled, nextRunAt])
}

model BriefingConfig {
  id                     String   @id @default("singleton")
  enabled                Boolean  @default(true)
  defaultAiModel         String?
  defaultTtsProvider     String?
  defaultTtsModel        String?
  maxArticlesPerBriefing Int      @default(5)
  targetDurationMinutes  Int      @default(6)
  maxBriefingsPerBatch   Int      @default(50)
  pollIntervalMs         Int      @default(900000) // 15 min
  updatedAt              DateTime @updatedAt
  updatedBy              String?
}

model BriefingLog {
  id             String   @id @default(cuid())
  userId         String
  podcastId      String
  topicSlugs     String[]
  articleUrls    String[]
  generatedAt    DateTime @default(now())
  userBriefingId String?
  scheduledDate  String? // "YYYY-MM-DD" for idempotency

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast      Podcast       @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  userBriefing UserBriefing? @relation(fields: [userBriefingId], references: [id], onDelete: SetNull)

  @@unique([userBriefingId, scheduledDate])
  @@index([userId, generatedAt])
}

// ============ POST-LISTEN QUIZZES ============

enum QuizStatus {
  GENERATING
  READY
  FAILED
}

model PodcastQuiz {
  id           String     @id @default(cuid())
  podcastId    String     @unique
  status       QuizStatus @default(GENERATING)
  model        String?
  provider     String?
  attemptCount Int        @default(0)
  avgScore     Float      @default(0)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  podcast   Podcast        @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]
}

model QuizQuestion {
  id           String @id @default(cuid())
  quizId       String
  order        Int
  question     String @db.Text
  options      Json // ["A","B","C","D"]
  correctIndex Int // 0-3
  explanation  String @db.Text
  turnIndex    Int?
  correctCount Int    @default(0)
  attemptCount Int    @default(0)

  quiz    PodcastQuiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([quizId, order])
}

model QuizAttempt {
  id          String    @id @default(cuid())
  userId      String
  quizId      String
  score       Int
  total       Int
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  quiz    PodcastQuiz  @relation(fields: [quizId], references: [id], onDelete: Cascade)
  answers QuizAnswer[]

  @@unique([userId, quizId])
}

model QuizAnswer {
  id            String   @id @default(cuid())
  attemptId     String
  questionId    String
  selectedIndex Int
  isCorrect     Boolean
  answeredAt    DateTime @default(now())

  attempt  QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([attemptId, questionId])
}

model ShowcaseSet {
  id        String   @id @default(cuid())
  name      String
  items     Json // Array of ShowcaseItem: { visualType, label, description, url, mediaType, credits? }
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
