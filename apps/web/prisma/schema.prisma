}

// ============ TWITTER MENTIONS ============

model TweetMention {
  id            String             @id @default(cuid())
  tweetId       String             @unique
  authorId      String // Twitter numeric user ID
  text          String             @db.Text
  parsedTopic   String?            @db.Text
  status        TweetMentionStatus @default(PENDING)
  userId        String?
  podcastId     String?            @unique
