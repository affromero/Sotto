  adminViewMode            String   @default("ALL")
  // Daily limits (migrated from FreeTierConfig)
  dailyGenerationLimit     Int      @default(1)
  dailyGenerationLimitPro  Int      @default(5)
  dailyVideoLimit          Int      @default(1)
  dailyVideoLimitPro       Int      @default(2)
  dailyMusicLimit          Int      @default(1)
  dailyMusicLimitPro       Int      @default(3)
  dailyAvatarLimit         Int      @default(1)
  dailyAvatarLimitPro      Int      @default(1)
  aiAllocations            Json     @default("[]")
  ttsAllocations           Json     @default("[]")
  updatedAt                DateTime @updatedAt
  updatedBy                String?
}

// ============ SITE CONFIG ============

model SiteConfig {
  id         String   @id @default("singleton")
  openSignup Boolean  @default(false)

  // Local profile sign-in (the Netflix-style picker). When true, the Credentials
  // provider is active and the profile picker is the primary sign-in. Owner-set.
  // null means "use the default": on for self-hosted instances with no ADMIN_EMAILS.
  localAuth Boolean?

  // Owner-set server infrastructure (non-secret selection only; null = fall back to env).
  // Secrets (provider keys, R2/S3 credentials) never live here — they stay in env or the
  // encrypted BYOK store. Set by the owner through the onboarding wizard.
  aiProvider      String?
  aiModel         String?
  aiBaseUrl       String?
  sttProvider     String?
  sttBaseUrl      String?
  sttModel        String?
  ttsProvider     String?
  ttsBaseUrl      String?
  storageProvider String?
  s3Bucket        String?
  s3Region        String?

  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ============ PLAN FEATURE CONFIG ============

model PlanFeatureConfig {
  id                      String   @id @default("singleton")
