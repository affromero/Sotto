  @@index([status])
  @@index([createdAt])
}

// ============ PIPELINE EVENTS ============

model PipelineEvent {
  id        String   @id @default(cuid())
  podcastId String
  createdAt DateTime @default(now())
  stage     String // queue name: 'audio-generation', 'script-verification', etc.
  type      String // 'error' | 'warning' | 'retry' | 'complete'
  message   String   @db.Text
  metadata  Json? // { segmentId?, jobId?, attemptNumber?, errorKind? }

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([podcastId, createdAt])
  @@index([type, createdAt])
}

// ============ API USAGE TRACKING ============

model ApiUsageLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  podcastId String?
  userId    String?
  service   String // anthropic, openai, elevenlabs, etc.
  modelId   String? // e.g. 'claude-sonnet-4-5-20250929', 'whisper-1', 'eleven_v3'
  category  String // discovery, script_generation, audio_generation, interaction

  // Cost tracking
  inputTokens  Int?
  outputTokens Int?
  totalCost    Float

  // Performance
  durationMs Int?

  metadata Json @default("{}")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([podcastId])
  @@index([userId])
  @@index([createdAt])
  @@index([service])
  @@index([modelId])
}

// ============ FEEDBACK (Early Access) ============

model Feedback {
