  startOffset       Float      @default(0) // seconds from parent segment start
  subDuration       Float? // seconds; null = full segment duration
  visualType        VisualType
  prompt            String?    @db.Text
  metadata          Json? // type-specific: chart data, quote text, timeline events, etc.
  visualMode        String? // 'image' | 'video' | 'programmatic'
  videoModel        String? // pricetoken model ID for video mode
  endStatePrompt    String?    @db.Text
  firstFrameUrl     String?
  lastFrameUrl      String?
  assetUrl          String? // R2 URL of generated image/video
