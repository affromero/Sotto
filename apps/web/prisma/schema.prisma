// Sotto Database Schema
// Interactive Podcast Platform

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ============ USER ROLES ============

enum UserRole {
  USER
  CREATOR
  ADMIN
  SYSTEM
}

enum UserPlan {
  FREE
  PRO
}

// ============ USERS & AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  handle        String?   @unique
  image         String?
  bio           String?   @db.Text
  role          UserRole  @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Twitter integration
  twitterHandle          String?   @unique
  twitterEnabled         Boolean   @default(false)
  preferredLanguage      String?
  preferredTtsProvider   String?
  preferredTtsModel      String?
  preferredAiProvider    String?
  preferredAiModel       String?

  // Notification preferences
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)

  // Telegram integration
  telegramEnabled Boolean @default(false)
  telegramChatId  String?

  // Relations
  accounts           Account[]
  sessions           Session[]
  podcasts           Podcast[]
  discoveries        Discovery[]
  discoveryChatErrors DiscoveryChatError[]
  interactions       Interaction[]
  notifications      Notification[]
  apiUsageLogs       ApiUsageLog[]
  pushSubscriptions  PushSubscription[]
  expoPushTokens     ExpoPushToken[]
  voiceClones        VoiceClone[]

  // Social
  likes     Like[]
  saves     Save[]
  followers Follow[] @relation("Following")
  following Follow[] @relation("Follower")

  // API Keys
  apiKeys ApiKey[]

  // Twitter mentions
  tweetMentions TweetMention[]

  // Telegram messages
  telegramMessages TelegramMessage[]

  // BYOK TTS keys (multi-provider)
  userTtsKeys UserTtsKey[]

  // BYOK AI keys (LLM providers)
  userAiKeys UserAiKey[]

  // Collections
  collections       Collection[]
  collectionFollows CollectionFollow[]

  // Interests (onboarding + settings)
  interests             UserInterest[]
  hasCompletedOnboarding Boolean @default(false)

  // Voice requests
  voiceRequestsSent     VoiceRequest[] @relation("VoiceRequester")
  voiceRequestsReceived VoiceRequest[] @relation("VoiceOwner")

  // Voice allowlist
  voiceAllowlistEntries VoiceAllowlist[] @relation("VoiceAllowlisted")

  // Interaction votes
  interactionVotes InteractionVote[]

  // Comments
  comments Comment[]

  // Podcast ratings
  podcastRatings PodcastRating[]

  // Activity feed
  activities Activity[]

  // Taste quiz
  tasteQuizAnswers TasteQuizAnswer[]

  // Saved ideas
  savedIdeas SavedIdea[]

  // Podcast ideas (from Telegram bot)
  podcastIdeas PodcastIdea[]

  // Free tier
  freeGenerationsUsed      Int  @default(0)
  dailyGenerationOverride  Int? // null = use global, 0 = unlimited, N = custom daily limit

  // Subscription plan
  plan         UserPlan     @default(FREE)
  subscription Subscription?

  // Moderation
  bannedAt        DateTime?
  bannedReason    String?    @db.Text
  suspendedUntil  DateTime?
  suspendedReason String?    @db.Text
  warningCount    Int        @default(0)

  // Moderation relations
  moderationActions   ModerationAction[] @relation("ModeratedUser")
  moderationPerformed ModerationAction[] @relation("Moderator")
  reports             Report[]           @relation("Reporter")
  claimReports        ClaimReport[]      @relation("ClaimReporter")

  // Referrals
  referredById String?
  referredBy   User?   @relation("Referrals", fields: [referredById], references: [id])
  referrals    User[]  @relation("Referrals")

  // Stripe Connect (voice monetization)
  stripeAccountId  String?
  stripeOnboarded  Boolean @default(false)

  // Voice purchases
  voicePurchases VoicePurchase[] @relation("VoiceBuyer")

  // Voice preferences (multi-speaker)
  voicePreferences UserVoicePreference[]

  // Per-provider free tier usage tracking
  freeProviderUsage FreeProviderUsage[]

  @@index([role])
  @@index([handle])
  @@index([referredById])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String   @unique
  stripeSubscriptionId String   @unique
  stripePriceId        String
  status               String   // active | canceled | past_due | trialing
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ SOCIAL: FOLLOW ============

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

// ============ PODCASTS ============

model Podcast {
  id        String        @id @default(cuid())
  userId    String
  title     String
  topic     String        @db.Text
  status         PodcastStatus @default(PENDING)
  failedAtStatus String?
  failureReason  String?       @db.Text
  technicalError String?       @db.Text
  failedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // Audio
  audioUrl           String?
  duration           Int?    // seconds
  durationDeviation  Int?    // seconds: (actual - target*60), null if no target set
  fileSize           Int?    // bytes

  // Voice selection
  ttsProvider     String? // null = auto; 'elevenlabs' | 'openai' | 'playht' | 'cartesia' | 'hume'
  ttsModel        String? // e.g. 'eleven_v3', 'tts-1-hd', 'sonic-2', 'premium', 'octave'
  aiProvider      String?  // 'anthropic' | 'openai' | 'groq'
  aiModel         String?  // e.g. 'claude-sonnet-4-5-20250929', 'claude-opus-4-6'
  sttProvider     String? // null = auto; 'openai' | 'groq' | 'elevenlabs' | 'together' | 'deepgram' | 'assemblyai'
  sttModel        String? // e.g. 'whisper-1', 'whisper-large-v3-turbo', 'scribe_v1'
  language        String?  // ISO 639-1, e.g. 'en', 'es', 'ja'

  // Source tracking (web, twitter, api)
  source        PodcastSource @default(WEB)
  sourceTweetId String?

  // Visibility
  visibility PodcastVisibility @default(PUBLIC)

  // Fork tracking
  forkedFromId     String?
  forkedFrom       Podcast?  @relation("Forks", fields: [forkedFromId], references: [id], onDelete: SetNull)
  forks            Podcast[] @relation("Forks")
  remixNote        String?   @db.Text
  parentDiscovery  Json?

  // Versioning
  currentVersion Int @default(1)

  // Counters (denormalized for performance)
  playCount    Int @default(0)
  likeCount    Int @default(0)
  forkCount    Int @default(0)
  saveCount    Int @default(0)
  commentCount Int @default(0)

  // PDF export
  pdfUrl String?

  // Import fields
  importedAudioKey    String?
  originalFormat      String?
  transcriptProvided  Boolean @default(false)
  isHumanContent      Boolean @default(false)
  sourcePlatform      String?  // e.g. "notebooklm", "spotify", "apple_podcasts", "youtube"

  // AI-suggested metadata (for imports where user provided their own)
  suggestedTitle       String?
  suggestedTopic       String?  @db.Text

  // Draft data (voice/config JSON, cleared on generation)
  draftData Json?

  // Relations
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  discovery    Discovery?
  script       Script?
  segments     Segment[]
  interactions Interaction[]
  likes        Like[]
  saves        Save[]
  tags         PodcastTag[]
  jobs             Job[]
  pipelineEvents   PipelineEvent[]
  references       Reference[]
  versions     PodcastVersion[]
  tweetMention      TweetMention?
  telegramMessage   TelegramMessage?
  playbackSessions  PlaybackSession[]
  podcastFeature   PodcastFeature?
  listeningQueues  ListeningQueue[]
  comments         Comment[]
  collectionItems  CollectionItem[]
  savedIdea        SavedIdea?
  voices           PodcastVoice[]
  voicePurchases   VoicePurchase[]
  autoTweets       TwitterAutoTweet[]
  ratings          PodcastRating[]
  claimReports     ClaimReport[]
  voiceTracks      VoiceTrack[]
  defaultVoiceTrackId String?

  @@index([userId])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
  @@index([playCount])
  @@index([likeCount])
  @@index([deletedAt])
}

enum PodcastStatus {
  DRAFT
  PENDING
  DISCOVERING
  EXTRACTING
  SCRIPTING
  VERIFYING_SCRIPT
  VALIDATING_REFERENCES
  SCRIPT_READY
  GENERATING_AUDIO
  STITCHING
  READY
  UPDATING
  FAILED
  IMPORTING
  TRANSCRIBING
}

enum PodcastVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum PodcastSource {
  WEB
  TWITTER
  TELEGRAM
  API
  IMPORT
}

// ============ DISCOVERY (Chat-Based) ============

model Discovery {
  id        String   @id @default(cuid())
  podcastId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Extracted metadata from chat
  topic          String?  @db.Text
  depth          String?  // eli5, quick_overview, standard, deep_dive
  audienceLevel  String?  // beginner, intermediate, expert
  audience       String?  // kids, teens, family, general, mature
  focusAreas     String[] // array of focus topics
  tone           String?  // casual, professional, socratic
  durationTarget Int?     // minutes
  speakers       Json?    // [{name: "Host", description: "..."}] for multi-voice
  priorKnowledge String?  @db.Text
  sourceUrl      String?
  sourceContent  String?  @db.Text
  sourceMetadata Json?

  // Relations
  podcast  Podcast            @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  messages DiscoveryMessage[]
  user     User               @relation(fields: [userId], references: [id])
  userId   String

  @@index([userId])
}

model DiscoveryMessage {
  id          String   @id @default(cuid())
  discoveryId String
  role        String   // user, assistant, system
  content     String   @db.Text
  chips       Json?    // suggested chip options [{label, value}]
  createdAt   DateTime @default(now())

  discovery Discovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)

  @@index([discoveryId])
}

model DiscoveryChatError {
  id          String   @id @default(cuid())
  userId      String
  userMessage String   @db.Text
  errorKind   String   // 'empty_response' | 'exception' | 'auth_error'
  errorDetail String?  @db.Text
  discoveryId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

// ============ SCRIPTS ============

model Script {
  id        String   @id @default(cuid())
  podcastId String   @unique
  turns     Json     // [{speaker: "HOST"|"EXPERT", text: "..."}]
  soundCues Json?    // [{type, prompt, durationSeconds, insertAfterTurn}]
  markdown  String   @db.Text
  context   String?  @db.Text // source context used for generation
  version   Int      @default(1)
  verificationAttempts Int      @default(0)
  verificationFeedback String?  @db.Text
  verificationClaims   Json?    // ClaimAnalysis[] with turnHash — persisted for incremental re-use
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
}

// ============ AUDIO SEGMENTS ============

model Segment {
  id        String  @id @default(cuid())
  podcastId String
  speaker   String
  text      String  @db.Text
  audioUrl  String?
  order     Int
  startTime Float?  // seconds
  duration  Float?  // seconds
  version   Int     @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  podcast            Podcast             @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  voiceTrackSegments VoiceTrackSegment[]

  @@index([podcastId])
  @@index([order])
}

// ============ PODCAST VOICE ASSIGNMENTS ============

model PodcastVoice {
  id        String  @id @default(cuid())
  podcastId String
  speaker   String  // "Host", "Expert", "Skeptic", etc.
  voiceId   String? // TTS voice ID (pool or clone)
  podcast   Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([podcastId, speaker])
  @@index([podcastId])
}

// ============ USER VOICE PREFERENCES ============

model UserVoicePreference {
  id        String @id @default(cuid())
  userId    String
  speaker   String
  voiceId   String
  sortOrder Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, speaker])
  @@index([userId])
}

// ============ PODCAST VERSIONS ============

model PodcastVersion {
  id            String   @id @default(cuid())
  podcastId     String
  version       Int
  audioUrl      String
  duration      Int?
  changeType    String   // 'initial' | 'incorporation' | 'regeneration'
  changeSummary String?  @db.Text
  interactionId String?
  createdAt     DateTime @default(now())

  podcast     Podcast      @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  interaction Interaction? @relation(fields: [interactionId], references: [id])
  segments    PodcastVersionSegment[]

  @@unique([podcastId, version])
  @@index([podcastId])
}

model PodcastVersionSegment {
  id        String @id @default(cuid())
  versionId String
  segmentId String
  order     Int
  startTime Float?

  version PodcastVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

// ============ INTERACTIONS (Q&A during playback) ============

model Interaction {
  id        String            @id @default(cuid())
  podcastId String
  userId    String
  status    InteractionStatus @default(PENDING)

  // Question context
  question  String @db.Text
  timestamp Float  // playback position in seconds

  // Answer
  answer String? @db.Text

  // Resolution
  resolved     Boolean @default(false)
  incorporated Boolean @default(false) // baked into podcast
  helpful      Boolean? // null = no feedback, true/false = user response
  segmentOrder Int?     // computed by worker: which segment the question maps to

  // Public Q&A
  visibility   String  @default("PUBLIC") // PUBLIC or PRIVATE
  upvoteCount  Int     @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  podcast  Podcast            @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions PodcastVersion[]
  votes    InteractionVote[]

  @@index([podcastId])
  @@index([userId])
  @@index([status])
}

model InteractionVote {
  id            String   @id @default(cuid())
  userId        String
  interactionId String
  createdAt     DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  interaction Interaction @relation(fields: [interactionId], references: [id], onDelete: Cascade)

  @@unique([userId, interactionId])
  @@index([interactionId])
}

enum InteractionStatus {
  PENDING
  ANSWERING
  ANSWERED
  RESOLVED
  INCORPORATING
  INCORPORATED
}

// ============ COMMENTS (Threaded) ============

model Comment {
  id         String    @id @default(cuid())
  content    String    @db.Text
  userId     String
  podcastId  String
  parentId   String?
  timestamp  Float?    // optional podcast playback timestamp pin
  replyCount Int       @default(0)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast   @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([podcastId, createdAt])
  @@index([parentId])
}

// ============ SOCIAL: LIKES & SAVES ============

model Like {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([podcastId])
}

model Save {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([podcastId])
}

// ============ PODCAST RATINGS ============

model PodcastRating {
  id        String   @id @default(cuid())
  userId    String
  podcastId String

  voiceNaturalness    Int // 1-5: "How natural do the voices sound?"
  contentAccuracy     Int // 1-5: "Did the AI get the facts right?"
  conversationFlow    Int // 1-5: "Does the back-and-forth feel natural?"
  overallSatisfaction Int // 1-5: overall summary

  comment   String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([podcastId])
}

// ============ TAGS ============

model Tag {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  parentId String?

  parent   Tag?    @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Tag[]   @relation("TagHierarchy")

  podcasts      PodcastTag[]
  userInterests UserInterest[]

  @@index([slug])
  @@index([parentId])
}

model PodcastTag {
  id        String @id @default(cuid())
  podcastId String
  tagId     String

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([podcastId, tagId])
  @@index([tagId])
}

// ============ USER INTERESTS ============

model UserInterest {
  id        String   @id @default(cuid())
  userId    String
  tagId     String
  source    String   @default("onboarding") // "onboarding" | "behavioral" | "manual"
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([userId])
  @@index([tagId])
}

// ============ TASTE QUIZ ============

model TasteQuizAnswer {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  question   String
  tagSlugs   String[]
  response   String   // "yes" | "no" | "skip"
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

// ============ SAVED IDEAS ============

model SavedIdea {
  id         String    @id @default(cuid())
  userId     String
  questionId String
  question   String
  tagSlugs   String[]
  category   String
  podcastId  String?   @unique
  createdAt  DateTime  @default(now())

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast? @relation(fields: [podcastId], references: [id], onDelete: SetNull)

  @@unique([userId, questionId])
  @@index([userId, createdAt])
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  data      Json?
  read      Boolean          @default(false)
  pushed    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

enum NotificationType {
  PODCAST_READY
  PODCAST_FAILED
  KEY_INVALID
  PODCAST_LIKED
  PODCAST_FORKED
  NEW_FOLLOWER
  SIMILAR_PODCAST_CREATED
  TWITTER_PODCAST_READY
  TELEGRAM_PODCAST_READY
  VOICE_REQUEST_RECEIVED
  VOICE_REQUEST_APPROVED
  VOICE_REQUEST_DENIED
  QUESTION_ON_YOUR_PODCAST
  QUESTION_UPVOTED
  COMMENT_ON_YOUR_PODCAST
  COMMENT_REPLY
  SCRIPT_READY
  ACCOUNT_WARNING
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
  CONTENT_REMOVED
  PLATFORM_ANNOUNCEMENT
  VOICE_VERIFICATION_REQUIRED
  VOICE_VERIFICATION_PASSED
  VOICE_VERIFICATION_FAILED
  VOICE_BLOCKED_DUPLICATE
  VOICE_OWNERSHIP_ALERT
  CLAIM_REPORT_ON_YOUR_PODCAST
  PIPELINE_FAILURE
}

// ============ MODERATION ============

model ModerationAction {
  id          String   @id @default(cuid())
  userId      String
  moderatorId String
  action      String   // 'warn' | 'suspend' | 'ban' | 'unban' | 'unsuspend' | 'remove_content'
  reason      String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  user      User @relation("ModeratedUser", fields: [userId], references: [id], onDelete: Cascade)
  moderator User @relation("Moderator", fields: [moderatorId], references: [id])

  @@index([userId, createdAt])
}

// ============ PUSH SUBSCRIPTIONS ============

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ EXPO PUSH TOKENS (mobile) ============

model ExpoPushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   // "ios" | "android"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ JOBS (BullMQ tracking) ============

model Job {
  id        String   @id @default(cuid())
  podcastId String?
  type      String
  payload   Json
  status    String   // pending, processing, complete, failed
  result    Json?
  error     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  podcast Podcast? @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([type, status])
  @@index([podcastId])
  @@index([status])
  @@index([createdAt])
}

// ============ PIPELINE EVENTS ============

model PipelineEvent {
  id        String   @id @default(cuid())
  podcastId String
  createdAt DateTime @default(now())
  stage     String   // queue name: 'audio-generation', 'script-verification', etc.
  type      String   // 'error' | 'warning' | 'retry'
  message   String   @db.Text
  metadata  Json?    // { segmentId?, jobId?, attemptNumber?, errorKind? }

  podcast   Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([podcastId, createdAt])
  @@index([type, createdAt])
}

// ============ API USAGE TRACKING ============

model ApiUsageLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  podcastId String?
  userId    String?
  service   String   // anthropic, openai, elevenlabs, etc.
  modelId   String?  // e.g. 'claude-sonnet-4-5-20250929', 'whisper-1', 'eleven_v3'
  category  String   // discovery, script_generation, audio_generation, interaction

  // Cost tracking
  inputTokens  Int?
  outputTokens Int?
  totalCost    Float

  // Performance
  durationMs Int?

  metadata Json @default("{}")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([podcastId])
  @@index([userId])
  @@index([createdAt])
  @@index([service])
  @@index([modelId])
}

// ============ FEEDBACK (Early Access) ============

model Feedback {
  id        String         @id @default(cuid())
  userId    String?
  email     String?
  name      String?
  type      FeedbackType
  rating    Int?           // 1-5 stars
  subject   String
  message   String         @db.Text
  context   String?        // page/feature where feedback was given
  status    FeedbackStatus @default(NEW)
  response  String?        @db.Text // admin response
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  GENERAL
  PRAISE
  CONCERN
}

enum FeedbackStatus {
  NEW
  REVIEWED
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

// ============ TWITTER MENTIONS ============

model TweetMention {
  id            String             @id @default(cuid())
  tweetId       String             @unique
  authorId      String             // Twitter numeric user ID
  text          String             @db.Text
  parsedTopic   String?            @db.Text
  status        TweetMentionStatus @default(PENDING)
  userId        String?
  podcastId     String?            @unique
  replyTweetId  String?
  parentTweetId String?
  errorMessage  String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  podcast Podcast? @relation(fields: [podcastId], references: [id], onDelete: SetNull)

  @@index([authorId])
  @@index([status])
  @@index([createdAt])
}

enum TweetMentionStatus {
  PENDING
  PARSING
  GENERATING
  READY
  REPLIED
  FAILED
  IGNORED
}

// ============ TELEGRAM MESSAGES ============

model TelegramMessage {
  id                 String                 @id @default(cuid())
  telegramUserId     String
  chatId             String
  telegramMessageId  String?
  text               String?                @db.Text
  parsedTopic        String?                @db.Text
  status             TelegramMessageStatus  @default(PENDING)
  userId             String?
  podcastId          String?                @unique
  errorMessage       String?                @db.Text
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  podcast Podcast? @relation(fields: [podcastId], references: [id], onDelete: SetNull)

  @@index([telegramUserId])
  @@index([chatId])
  @@index([status])
  @@index([createdAt])
}

enum TelegramMessageStatus {
  PENDING
  DISCOVERING
  GENERATING
  READY
  REPLIED
  FAILED
  IGNORED
}

// ============ PODCAST IDEAS (Telegram Save-for-Later) ============

model PodcastIdea {
  id        String   @id @default(cuid())
  userId    String
  text      String   @db.Text
  sourceUrl String?
  source    String   @default("telegram")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// ============ RECOMMENDATION ENGINE ============

model RecommendationLog {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  surface   String   // picks, explore, trending
  position  Int
  score     Float
  signals   Json     // {relevance, collaborative, quality, freshness, novelty}
  explanation String @db.Text
  impressed   Boolean @default(false)
  clicked     Boolean @default(false)
  queued      Boolean @default(false)
  listenedPercent Float?
  refreshBatch Int   @default(0)
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([podcastId, createdAt])
  @@index([surface, createdAt])
}

model ListeningQueue {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  position  Int
  addedAt   DateTime @default(now())
  source    String   // picks, explore, following, search

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([userId, position])
}

// ============ ML FEATURE STORE ============

model UserFeature {
  id     String @id @default(cuid())
  userId String @unique

  // Engagement
  totalListenMinutes      Float @default(0)
  totalPodcastsListened   Int   @default(0)
  avgCompletionRate       Float @default(0)
  avgListenSpeed          Float @default(1)

  // Abandonment
  avgAbandonPercent Float @default(0)
  optimalDuration   Float @default(10) // minutes where highest completion

  // Preferences (inferred from behavior)
  preferredDepth         String? // eli5, quick_overview, standard, deep_dive
  preferredTone          String? // casual, professional, socratic
  preferredAudienceLevel String? // beginner, intermediate, expert
  preferredDuration      Float?  // minutes

  // Affinities
  topicAffinity Json? // [{tagId, weight}]
  voiceAffinity Json? // [{voiceId, completionRate}]

  // Social
  followingCount   Int   @default(0)
  followerCount    Int   @default(0)
  likeRate         Float @default(0)
  forkRate         Float @default(0)
  interactionRate  Float @default(0)
  creatorLoyalty   Float @default(0)

  // Behavioral
  archetype         String? // deep_listener, skimmer, explorer, completer, social_learner
  speakerPreference Float   @default(0) // -1 to 1
  noveltyResponseRate Float @default(0)

  // Temporal
  peakListeningHours   Json? // [{hour, listenMinutes}]
  postListenBehavior   Json? // {liked: pct, saved: pct, forked: pct, ...}
  topicProgressionPath Json? // [{topic, depth, timestamp}]

  // Recency
  daysSinceLastListen Float @default(0)
  listenFrequency     Float @default(0)

  // Vector (pgvector)
  embedding Unsupported("vector(384)")?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([archetype])
}

model PodcastFeature {
  id        String @id @default(cuid())
  podcastId String @unique

  // Quality
  avgCompletionRate    Float @default(0)
  medianCompletionRate Float @default(0)
  totalUniqueListeners Int   @default(0)
  totalListenMinutes   Float @default(0)

  // Engagement
  likeToListenRatio  Float @default(0)
  saveToListenRatio  Float @default(0)
  forkToListenRatio  Float @default(0)
  interactionRate    Float @default(0)

  // Abandonment
  abandonmentCurve         Json?  // [{percentBucket, abandonRate}] in 5% increments
  segmentAbandonRates      Json?  // [{segmentOrder, speaker, abandonRate}]
  questionThenAbandonRate  Float  @default(0)

  // Playback
  avgListenSpeed    Float @default(1)
  speedDistribution Json? // {1x: pct, 1.25x: pct, ...}
  dropoffPoints     Json? // [{position, dropoffRate}]
  seekHotspots      Json? // [{position, seekCount}]

  // Re-engagement
  relistenRate       Float @default(0)
  completionBySource Json? // {feed: pct, recommendation: pct, search: pct, direct: pct}

  // Content
  segmentCount          Int   @default(0)
  durationSeconds       Int   @default(0)
  referenceCount        Int   @default(0)
  verifiedReferenceRate Float @default(0)
  questionDensityByPosition Json? // [{percentBucket, questionsPerListener}]

  // Vector (pgvector)
  embedding Unsupported("vector(384)")?

  podcast    Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([podcastId])
  @@index([avgCompletionRate])
}

// ============ BEHAVIORAL EVENTS (ML Data Pipeline) ============

model BehavioralEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String?
  sessionId String
  eventType String   // e.g. playback.play, feed.impression
  eventData Json     // event-specific payload

  podcastId  String?
  pageUrl    String?  @db.Text
  deviceType String?
  userAgent  String?  @db.VarChar(512)
  referrer   String?  @db.Text
  clientTs   DateTime?

  @@index([userId, eventType, createdAt])
  @@index([podcastId, eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
}

model UserSession {
  id        String   @id @default(cuid())
  sessionId String   @unique
  userId    String?
  startedAt DateTime @default(now())
  lastSeenAt DateTime @default(now())

  deviceType String?
  userAgent  String?  @db.VarChar(512)
  ipHash     String?  @db.VarChar(64) // SHA-256 of IP, never raw
  referrer   String?  @db.Text
  pageCount  Int      @default(1)

  @@index([userId, startedAt])
  @@index([sessionId])
}

model PlaybackSession {
  id        String   @id @default(cuid())
  userId    String?
  sessionId String
  podcastId String
  startedAt DateTime @default(now())
  endedAt   DateTime?

  // Aggregates
  totalListenSeconds Float  @default(0)
  maxPosition        Float  @default(0)
  completionPercent  Float  @default(0)

  // Behavior
  pauseCount     Int    @default(0)
  seekCount      Int    @default(0)
  speedChanges   Int    @default(0)
  lastSpeed      Float  @default(1)
  interruptCount Int    @default(0)

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([userId, podcastId])
  @@index([podcastId, startedAt])
  @@index([userId, startedAt])
}

// ============ WAITLIST ============

enum WaitlistStatus {
  PENDING
  APPROVED
  REJECTED
}

model Waitlist {
  id            String         @id @default(cuid())
  email         String         @unique
  twitterHandle String?
  source        String?
  status        WaitlistStatus @default(PENDING)
  unsubscribed  Boolean        @default(false)
  approvedAt    DateTime?
  approvedBy    String?
  signedUpAt    DateTime?
  createdAt     DateTime       @default(now())

  @@index([createdAt])
  @@index([status])
}

// ============ API KEYS ============

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  keyPrefix  String    // first 16 chars for display (sk_sotto_XXXX...)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

// ============ VOICE CLONES ============

model VoiceClone {
  id                 String                  @id @default(cuid())
  userId             String
  name               String
  provider           String                  @default("elevenlabs")
  externalVoiceId    String
  sourceType         VoiceCloneSource
  sampleUrl          String?
  description        String?                 @db.VarChar(200)
  requestable        Boolean                 @default(false)
  priceInCents       Int?                    // null = free, 0+ = paid per-podcast
  verificationStatus VoiceVerificationStatus @default(PENDING_VERIFICATION)
  createdAt          DateTime                @default(now())

  user                    User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  voiceRequests           VoiceRequest[]
  allowlist               VoiceAllowlist[]
  voicePurchases          VoicePurchase[]
  fingerprint             VoiceFingerprint?
  verificationChallenges  VoiceVerificationChallenge[]
  similarityMatchesAs     VoiceSimilarityMatch[]      @relation("MatchedVoice")
  blockedMatchesAs        VoiceSimilarityMatch[]      @relation("BlockedVoice")

  @@unique([provider, externalVoiceId])
  @@index([userId])
  @@index([verificationStatus])
}

enum VoiceCloneSource {
  UPLOAD
  RECORD
}

enum VoiceVerificationStatus {
  PENDING_VERIFICATION
  AWAITING_CHALLENGE
  CHALLENGE_SUBMITTED
  VERIFIED
  BLOCKED
  REJECTED
  ADMIN_VERIFIED
  ADMIN_BLOCKED
  PROTECTED
}

// ============ VOICE ALLOWLIST ============

model VoiceAllowlist {
  id            String   @id @default(cuid())
  voiceCloneId  String
  allowedUserId String
  createdAt     DateTime @default(now())

  voiceClone  VoiceClone @relation(fields: [voiceCloneId], references: [id], onDelete: Cascade)
  allowedUser User       @relation("VoiceAllowlisted", fields: [allowedUserId], references: [id], onDelete: Cascade)

  @@unique([voiceCloneId, allowedUserId])
  @@index([allowedUserId])
}

// ============ VOICE FINGERPRINTS ============

model VoiceFingerprint {
  id           String   @id @default(cuid())
  voiceCloneId String   @unique
  embedding    Float[]
  modelVersion String
  audioUrl     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  voiceClone VoiceClone @relation(fields: [voiceCloneId], references: [id], onDelete: Cascade)
}

// ============ VOICE VERIFICATION CHALLENGES ============

model VoiceVerificationChallenge {
  id            String    @id @default(cuid())
  voiceCloneId  String
  phrase        String
  recordingUrl  String?
  similarity    Float?
  passed        Boolean?
  attemptNumber Int
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  voiceClone VoiceClone @relation(fields: [voiceCloneId], references: [id], onDelete: Cascade)

  @@index([voiceCloneId])
}

// ============ VOICE SIMILARITY MATCHES ============

model VoiceSimilarityMatch {
  id             String   @id @default(cuid())
  matchedVoiceId String
  blockedVoiceId String
  similarity     Float
  resolvedBy     String?
  resolution     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  matchedVoice VoiceClone @relation("MatchedVoice", fields: [matchedVoiceId], references: [id], onDelete: Cascade)
  blockedVoice VoiceClone @relation("BlockedVoice", fields: [blockedVoiceId], references: [id], onDelete: Cascade)

  @@index([matchedVoiceId])
  @@index([blockedVoiceId])
}

// ============ REFERENCES (Citations) ============

model Reference {
  id        String        @id @default(cuid())
  podcastId String
  number    Int
  title     String        @db.Text
  authors   String[]
  year      Int?
  url       String?       @db.Text
  type      ReferenceType @default(WEB)
  publisher String?
  doi       String?
  createdAt DateTime      @default(now())

  // Verification
  verificationStatus  VerificationStatus @default(PENDING)
  verificationDetails Json?
  originalTitle       String?            @db.Text
  contentDomain       String?            // 'ACADEMIC' | 'NEWS' | 'GOVERNMENT' | 'GENERAL'

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([podcastId, number])
  @@index([podcastId])
}

enum ReferenceType {
  WEB
  PAPER
  BOOK
  ARTICLE
  VIDEO
  REPORT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  REPLACED
  REMOVED
}

// ============ RESERVED HANDLES ============

model ReservedHandle {
  id        String   @id @default(cuid())
  handle    String   @unique
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())
}

// ============ VOICE REQUESTS ============

model VoiceRequest {
  id           String             @id @default(cuid())
  requesterId  String
  voiceOwnerId String
  voiceCloneId String
  status       VoiceRequestStatus @default(PENDING)
  message      String?            @db.Text
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  requester  User       @relation("VoiceRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  voiceOwner User       @relation("VoiceOwner", fields: [voiceOwnerId], references: [id], onDelete: Cascade)
  voiceClone VoiceClone @relation(fields: [voiceCloneId], references: [id], onDelete: Cascade)

  @@unique([requesterId, voiceCloneId])
  @@index([voiceOwnerId])
  @@index([status])
}

enum VoiceRequestStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
}

// ============ USER TTS KEYS (Multi-Provider BYOK) ============

model UserTtsKey {
  id           String    @id @default(cuid())
  userId       String
  provider     String    // 'elevenlabs' | 'openai' | 'playht' | 'cartesia' | 'hume'
  encryptedKey String    @db.Text
  extraData    String?   @db.Text // encrypted JSON for multi-field auth (e.g. PlayHT userId)
  isValid      Boolean   @default(true)
  label        String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// ============ USER AI KEYS (LLM BYOK) ============

model UserAiKey {
  id           String    @id @default(cuid())
  userId       String
  provider     String    // 'anthropic' | 'openai'
  encryptedKey String    @db.Text
  isValid      Boolean   @default(true)
  label        String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// ============ COLLECTIONS (Curated Playlists) ============

model Collection {
  id            String   @id @default(cuid())
  name          String
  description   String?  @db.Text
  userId        String
  isPublic      Boolean  @default(true)
  podcastCount  Int      @default(0)
  followerCount Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CollectionItem[]
  followers CollectionFollow[]

  @@index([userId])
}

model CollectionItem {
  id           String   @id @default(cuid())
  collectionId String
  podcastId    String
  order        Int      @default(0)
  addedAt      DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  podcast    Podcast    @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([collectionId, podcastId])
  @@index([collectionId])
}

model CollectionFollow {
  id           String   @id @default(cuid())
  userId       String
  collectionId String
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@unique([userId, collectionId])
  @@index([collectionId])
}

// ============ ACTIVITY FEED ============

model Activity {
  id         String   @id @default(cuid())
  userId     String
  type       String   // PODCAST_CREATED, PODCAST_FORKED, PODCAST_LIKED, USER_FOLLOWED, COMMENT_POSTED, COLLECTION_CREATED
  targetId   String?  // The ID of the target entity (podcast, user, collection, comment)
  targetType String?  // 'podcast', 'user', 'collection', 'comment'
  metadata   Json?    // Any extra context (e.g., fork parent title, comment snippet)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

// ============ FREE TIER CONFIG ============

model FreeTierConfig {
  id                    String   @id @default("singleton")
  aiProvider            String   @default("groq")
  aiModel               String   @default("llama-3.1-8b-instant")
  ttsProvider           String   @default("kittentts")
  ttsModel              String   @default("kitten-tts-mini-0.8")
  sttProvider           String   @default("groq")
  sttModel              String   @default("whisper-large-v3-turbo")
  generationLimit       Int      @default(3)
  dailyGenerationLimit  Int      @default(1)
  aiAllocations         Json?
  ttsAllocations        Json?
  updatedAt             DateTime @updatedAt
  updatedBy             String?
}

model FreeProviderUsage {
  id       String @id @default(cuid())
  userId   String
  category String // 'ai' | 'tts'
  provider String
  used     Int    @default(0)
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, provider])
  @@index([userId])
}

// ============ VOICE PURCHASES (Stripe) ============

model VoicePurchase {
  id                  String   @id @default(cuid())
  buyerId             String
  voiceCloneId        String
  podcastId           String
  amountCents         Int
  platformFeeCents    Int
  stripePaymentIntent String   @unique
  status              String   @default("authorized") // authorized | captured | cancelled | refunded
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  buyer      User       @relation("VoiceBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  voiceClone VoiceClone @relation(fields: [voiceCloneId], references: [id], onDelete: Cascade)
  podcast    Podcast    @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([buyerId])
  @@index([voiceCloneId])
  @@index([podcastId])
  @@index([stripePaymentIntent])
}

// ============ TWITTER CONFIG (Admin Dashboard) ============

model TwitterConfig {
  id                      String   @id @default("singleton")
  autoTweetEnabled        Boolean  @default(false)
  minLikes                Int      @default(10)
  minPlays                Int      @default(50)
  minForks                Int      @default(3)
  trendPollingEnabled     Boolean  @default(false)
  trendPollIntervalMs     Int      @default(7200000)
  maxTrendPodcastsPerDay  Int      @default(3)
  trendSearchQueries      String[] @default(["AI", "science", "technology"])
  tweetTemplate           String   @default("New on Sotto: {{title}}\n\n{{topic}}\n\nListen: {{url}}")
  updatedAt               DateTime @updatedAt
  updatedBy               String?
}

model TwitterAutoTweet {
  id           String   @id @default(cuid())
  podcastId    String
  tweetId      String?
  tweetText    String?  @db.Text
  trigger      String   // 'threshold' | 'manual' | 'trend'
  status       String   @default("pending") // 'pending' | 'posted' | 'failed'
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([podcastId])
  @@index([status])
  @@index([createdAt])
}

// ============ REPORTS ============

enum ReportReason {
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  SEXUAL_CONTENT
  MISINFORMATION
  SPAM
  IMPERSONATION
  COPYRIGHT
  VOICE_THEFT
  MUSIC_UPLOAD
  FALSE_HUMAN_BADGE
  FALSE_CLAIM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED_ACTIONED
  RESOLVED_DISMISSED
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  targetType  String       // 'podcast' | 'comment' | 'user'
  targetId    String
  reason      ReportReason
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  resolvedBy  String?
  resolution  String?      @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ContentFlag {
  id         String   @id @default(cuid())
  targetType String   // 'podcast' | 'comment' | 'discovery_message'
  targetId   String
  userId     String?
  categories String[]
  scores     Json
  source     String   // 'auto_input' | 'auto_output' | 'worker_scan'
  reviewed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([reviewed, createdAt])
  @@index([targetType, targetId])
}

// ============ CLAIM REPORTS ============

enum ClaimReportStatus {
  PENDING
  REVIEWING
  RESOLVED_VERIFIED
  RESOLVED_INACCURATE
  DISMISSED
}

model ClaimReport {
  id          String            @id @default(cuid())
  reporterId  String
  podcastId   String
  turnIndex   Int
  turnText    String            @db.Text
  description String            @db.Text
  status      ClaimReportStatus @default(PENDING)
  resolvedBy  String?
  resolution  String?           @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime          @default(now())

  reporter User    @relation("ClaimReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  podcast  Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([reporterId, podcastId, turnIndex])
  @@index([podcastId, status])
  @@index([status, createdAt])
}

// ============ VOICE TRACKS ============

enum VoiceTrackStatus {
  PENDING
  GENERATING_AUDIO
  STITCHING
  READY
  FAILED
  STALE
}

model VoiceTrack {
  id            String           @id @default(cuid())
  podcastId     String
  name          String
  status        VoiceTrackStatus @default(PENDING)
  audioUrl      String?
  duration      Int?
  fileSize      Int?
  ttsProvider   String?
  ttsModel      String?
  failureReason String?          @db.Text
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  podcast  Podcast             @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  voices   VoiceTrackVoice[]
  segments VoiceTrackSegment[]

  @@index([podcastId])
  @@index([status])
}

model VoiceTrackVoice {
  id           String @id @default(cuid())
  voiceTrackId String
  speaker      String
  voiceId      String

  voiceTrack VoiceTrack @relation(fields: [voiceTrackId], references: [id], onDelete: Cascade)

  @@unique([voiceTrackId, speaker])
}

model VoiceTrackSegment {
  id           String  @id @default(cuid())
  voiceTrackId String
  segmentId    String
  audioUrl     String?
  duration     Float?
  startTime    Float?
  order        Int

  voiceTrack VoiceTrack @relation(fields: [voiceTrackId], references: [id], onDelete: Cascade)
  segment    Segment    @relation(fields: [segmentId], references: [id], onDelete: Cascade)

  @@unique([voiceTrackId, segmentId])
  @@index([voiceTrackId])
}
