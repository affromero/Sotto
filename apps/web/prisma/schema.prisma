// Sotto Database Schema
// Interactive Podcast Platform

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [vector]
}

// ============ USER ROLES ============

enum UserRole {
  USER
  ADMIN
  SYSTEM
}

enum UserPlan {
  FREE
  PRO
}

// ============ VIDEO GENERATION ============

enum VisualType {
  DATA_CHART
  QUOTE
  COMPARISON
  TIMELINE
  DIAGRAM
  STOCK_FOOTAGE
  AI_ILLUSTRATION
  TEXT_CARD
  MAP_OVERLAY
  DATA_TABLE
  SOURCE_FIGURE
}

enum VideoStatus {
  DRAFT
  PENDING
  CLASSIFYING
  GENERATING_VISUALS
  GENERATING_TRANSITIONS
  GENERATING_AVATARS
  COMPOSING
  READY
  FAILED
  STALE
}

enum MusicStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

// ============ USERS & AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  handle        String?   @unique
  image         String?
  bio           String?   @db.Text
  role          UserRole  @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Twitter integration
  twitterHandle        String? @unique
  twitterEnabled       Boolean @default(false)
  preferredLanguage    String?
  preferredTtsProvider String?
  preferredTtsModel    String?
  preferredAiProvider  String?
  preferredAiModel     String?

  // Notification preferences
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)

  // Telegram integration
  telegramEnabled Boolean @default(false)
  telegramChatId  String?

  // Relations
  accounts            Account[]
  sessions            Session[]
  podcasts            Podcast[]
  discoveries         Discovery[]
  discoveryChatErrors DiscoveryChatError[]
  interactions        Interaction[]
  notifications       Notification[]
  apiUsageLogs        ApiUsageLog[]
  pushSubscriptions   PushSubscription[]
  expoPushTokens      ExpoPushToken[]
  voiceClones         VoiceClone[]

  // Saves
  saves Save[]

  // API Keys
  apiKeys           ApiKey[]
  privateFeedTokens PrivateFeedToken[]

  // Twitter mentions
  tweetMentions TweetMention[]

  // Telegram messages
  telegramMessages TelegramMessage[]

  // BYOK TTS keys (multi-provider)
  userTtsKeys UserTtsKey[]

  // BYOK AI keys (LLM providers)
  userAiKeys UserAiKey[]

  // Collections
  collections Collection[]

  // Interests (onboarding + settings)
  interests              UserInterest[]
  hasCompletedOnboarding Boolean        @default(false)

  // Voice requests
  voiceRequestsSent     VoiceRequest[] @relation("VoiceRequester")
  voiceRequestsReceived VoiceRequest[] @relation("VoiceOwner")

  // Voice allowlist
  voiceAllowlistEntries VoiceAllowlist[] @relation("VoiceAllowlisted")

  // Podcast ratings
  podcastRatings PodcastRating[]

  // Taste quiz
  tasteQuizAnswers TasteQuizAnswer[]

  // Saved ideas
  savedIdeas SavedIdea[]

  // Podcast ideas (from Telegram bot)
  podcastIdeas PodcastIdea[]

  // Private agent output ingestions
  agentIngestions AgentIngestion[]

  // Private meeting transcript ingestions
  meetingIngestions MeetingIngestion[]

  // Free tier
  dailyGenerationOverride Int? // null = use global, 0 = unlimited, N = custom daily limit

  // Budget enforcement
  spentMonthCents   Int       @default(0)
  budgetMonthCents  Int       @default(0) // 0 = no budget limit
  spentMonthResetAt DateTime?

  // Subscription plan
  plan         UserPlan      @default(FREE)
  subscription Subscription?

  // Moderation
  bannedAt        DateTime?
  bannedReason    String?   @db.Text
  suspendedUntil  DateTime?
  suspendedReason String?   @db.Text
  warningCount    Int       @default(0)

  // Moderation relations
  moderationActions   ModerationAction[] @relation("ModeratedUser")
  moderationPerformed ModerationAction[] @relation("Moderator")
  reports             Report[]           @relation("Reporter")
  claimReports        ClaimReport[]      @relation("ClaimReporter")

  // Referrals
  referredById       String?
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          User[]    @relation("Referrals")
  referralVerified   Boolean   @default(false)
  referralVerifiedAt DateTime?

  // Stripe Connect (voice monetization)
  stripeAccountId String?
  stripeOnboarded Boolean @default(false)

  // Voice purchases
  voicePurchases VoicePurchase[] @relation("VoiceBuyer")

  // Voice preferences (multi-speaker)
  voicePreferences UserVoicePreference[]

  // Per-provider free tier usage tracking
  freeProviderUsage FreeProviderUsage[]

  // Voice track contributions (re-voice proposals)
  voiceTrackContributions VoiceTrack[] @relation("VoiceTrackContributions")

  // Invitation links created by admin
  invitationLinks InvitationLink[] @relation("InvitationLinksCreated")

  // Demo projects (admin video studio)
  demoProjects DemoProject[]

  // Avatar images (lip-sync)
  avatarImages         AvatarImage[]
  avatarSharesSent     AvatarImageShare[] @relation("AvatarShareRequester")
  avatarSharesReceived AvatarImageShare[] @relation("AvatarShareOwner")

  // Daily Briefings
  briefingEnabled       Boolean           @default(false)
  briefingTime          String? // "HH:mm" wall-clock
  briefingTimezone      String? // IANA, e.g. "America/New_York"
  briefingDays          Int               @default(127) // bitmask: Mon=1..Sun=64
  briefingVisibility    PodcastVisibility @default(PRIVATE)
  lastBriefingAt        DateTime?
  briefingLogs          BriefingLog[]
  // Briefing customization — null = use user's general pref → admin default → platform auto
  briefingAiModel       String? // AI model override for briefings
  briefingTtsProvider   String? // TTS provider override
  briefingTtsModel      String? // TTS model override
  briefingHostVoiceId   String? // Voice pool entry name (provider-agnostic)
  briefingExpertVoiceId String? // Voice pool entry name (provider-agnostic)
  briefingDepth         String? // eli5, quick_overview, standard, deep_dive
  briefingTone          String? // casual, professional, socratic, comedic, satirical, storytelling
  briefingAudienceLevel String? // beginner, intermediate, expert
  briefingDuration      Int? // target minutes (1-40)
  briefingFormat        Int               @default(2) // 1=Solo, 2=Dialogue, 3=Panel, 4=Roundtable
  briefingPrompt        String?           @db.Text // custom instructions/topic focus
  briefingUseByokKeys   Boolean           @default(false) // opt-in: when true + user has BYOK, use their keys

  // Multi-briefing configs
  userBriefings UserBriefing[]

  // Quizzes
  quizEnabled  Boolean       @default(true)
  quizAttempts QuizAttempt[]

  @@index([role])
  @@index([handle])
  @@index([referredById])
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId     String   @unique
  stripeSubscriptionId String   @unique
  stripePriceId        String
  status               String // active | canceled | past_due | trialing
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ PODCASTS ============

model Podcast {
  id             String        @id @default(cuid())
  userId         String
  title          String
  slug           String?
  topic          String        @db.Text
  status         PodcastStatus @default(PENDING)
  failedAtStatus String?
  failureReason  String?       @db.Text
  technicalError String?       @db.Text
  errorId        String?
  failedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // Audio
  audioUrl          String?
  duration          Int? // seconds
  durationDeviation Int? // seconds: (actual - target*60), null if no target set
  fileSize          Int? // bytes

  // Voice selection
  ttsProvider      String? // explicit or platform-resolved provider required before audio generation
  ttsModel         String? // e.g. 'eleven_v3', 'tts-1-hd', 'sonic-2', 'premium', 'octave'
  aiProvider       String? // 'anthropic' | 'openai'
  aiModel          String? // e.g. 'claude-sonnet-4-5-20250929', 'claude-opus-4-6'
  verificationMode String  @default("standard") // standard, relaxed, showcase
  zeroCostVideo    Boolean @default(false) // skip AI illustrations + verification for $0 video
  aiAutoResolved   Boolean @default(false)
  ttsAutoResolved  Boolean @default(false)
  sttProvider      String? // required for imported audio without transcript; 'openai' | 'elevenlabs' | 'together' | 'deepgram' | 'assemblyai'
  sttModel         String? // e.g. 'whisper-1', 'whisper-large-v3-turbo', 'scribe_v1'
  language         String? // ISO 639-1, e.g. 'en', 'es', 'ja'

  // Source tracking (web, twitter, api)
  source        PodcastSource @default(WEB)
  sourceTweetId String?

  // Visibility
  visibility PodcastVisibility @default(PRIVATE)
  isDelisted Boolean           @default(false)

  // Versioning
  currentVersion Int @default(1)

  // Counters (denormalized for performance)
  playCount Int @default(0)
  saveCount Int @default(0)

  // PDF export
  pdfUrl String?

  // Video generation
  videoUrl String?

  // Waveform visualization
  waveformUrl    String?
  spectrogramUrl String?

  // Background music
  musicUrl    String?
  musicVolume Float   @default(0.15)
  musicBaked  Boolean @default(false)

  // Import fields
  importedAudioKey     String?
  originalFormat       String?
  transcriptProvided   Boolean @default(false)
  isHumanContent       Boolean @default(false)
  lowReferences        Boolean @default(false)
  verificationProgress Json? // transient progress during reference validation
  sourcePlatform       String? // e.g. "notebooklm", "spotify", "apple_podcasts", "youtube"

  // AI-suggested metadata (for imports where user provided their own)
  suggestedTitle String?
  suggestedTopic String? @db.Text

  // Draft data (voice/config JSON, cleared on generation)
  draftData Json?

  // Relations
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  discovery           Discovery?
  script              Script?
  segments            Segment[]
  interactions        Interaction[]
  saves               Save[]
  tags                PodcastTag[]
  jobs                Job[]
  pipelineEvents      PipelineEvent[]
  references          Reference[]
  versions            PodcastVersion[]
  tweetMention        TweetMention?
  telegramMessage     TelegramMessage?
  playbackSessions    PlaybackSession[]
  podcastFeature      PodcastFeature?
  listeningQueues     ListeningQueue[]
  collectionItems     CollectionItem[]
  savedIdea           SavedIdea?
  voices              PodcastVoice[]
  voicePurchases      VoicePurchase[]
  autoTweets          TwitterAutoTweet[]
  ratings             PodcastRating[]
  claimReports        ClaimReport[]
  voiceTracks         VoiceTrack[]
  voiceTrackProposals VoiceTrack[]       @relation("VoiceTrackProposals")
  defaultVoiceTrackId String?
  videoGenerations    VideoGeneration[]
  musicGenerations    MusicGeneration[]
  audioFingerprint    AudioFingerprint?
  duplicateSource     DuplicateMatch[]   @relation("DuplicateSource")
  duplicateMatches    DuplicateMatch[]   @relation("DuplicateMatch")
  quiz                PodcastQuiz?
  briefingLogs        BriefingLog[]
  agentIngestion      AgentIngestion?
  meetingIngestion    MeetingIngestion?
  landingShowcase     LandingShowcase?
  researchDossier     ResearchDossier?
  creativeOutline     CreativeOutline?
  vocabularyEntries   VocabularyEntry[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
  @@index([playCount])
  @@index([deletedAt])
}

enum PodcastStatus {
  DRAFT
  PENDING
  DISCOVERING
  EXTRACTING
  RESEARCHING
  PLANNING
  SCRIPTING
  COMPILING
  SCRIPT_READY
  GENERATING_AUDIO
  STITCHING
  READY
  UPDATING
  FAILED
  IMPORTING
  TRANSCRIBING
  DUPLICATE_REVIEW
}

model ResearchDossier {
  id        String   @id @default(cuid())
  podcastId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mode             String // 'source-bound' | 'curated' | 'open-web'
  userBrief        Json // { topic, audienceLevel, tone, durationTarget, mustCover, mustAvoid, suppliedSourceUrls, discoverySummary }
  sources          Json // SourceRecord[]
  evidence         Json // EvidenceCard[]
  gaps             Json? // string[] — identified knowledge gaps
  blockedClaims    Json? // string[] — claims that couldn't be verified
  recommendedAngle String? @db.Text

  totalInputTokens  Int     @default(0)
  totalOutputTokens Int     @default(0)
  model             String?

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
}

model CreativeOutline {
  id        String   @id @default(cuid())
  podcastId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drivingQuestion     String @db.Text
  listenerPromise     String @db.Text
  thesis              String @db.Text
  narrativeFramework  String // 'anecdote_reflection' | 'question_cascade' | 'problem_solution' | 'editorial_comedy'
  hook                String @db.Text
  beats               Json // Beat[]
  tensionCurve        Json? // { beatOrder, tension }[]
  bannedAngles        Json? // string[]
  unresolvedQuestions Json? // string[]
  speakerRoles        Json? // { speaker, role }[]

  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  model        String?

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
}

enum PodcastVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum PodcastSource {
  WEB
  TWITTER
  TELEGRAM
  API
  AGENT
  MEETING
  IMPORT
  ADMIN
  BRIEFING
}

// ============ DISCOVERY (Chat-Based) ============

model Discovery {
  id        String   @id @default(cuid())
  podcastId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Extracted metadata from chat
  topic          String?  @db.Text
  depth          String? // eli5, quick_overview, standard, deep_dive
  audienceLevel  String? // beginner, intermediate, expert
  audience       String? // kids, teens, family, general, mature
  focusAreas     String[] // array of focus topics
  tone           String? // casual, professional, socratic
  durationTarget Int? // minutes
  speakers       Json? // [{name: "Host", description: "..."}] for multi-voice
  priorKnowledge String?  @db.Text
  sourceUrl      String?
  sourceContent  String?  @db.Text
  sourceMetadata Json?

  // Verification & feasibility
  verificationMode      String  @default("standard") // standard, relaxed
  feasibilityVerdict    String? // proceed, warn, reject
  feasibilitySuggestion String? @db.Text

  // Relations
  podcast  Podcast            @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  messages DiscoveryMessage[]
  user     User               @relation(fields: [userId], references: [id])
  userId   String

  @@index([userId])
}

model AgentIngestion {
  id             String   @id @default(cuid())
  userId         String
  podcastId      String   @unique
  idempotencyKey String?
  provider       String
  agentName      String
  runId          String?
  contentHash    String
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([contentHash])
}

model MeetingIngestion {
  id             String    @id @default(cuid())
  userId         String
  podcastId      String    @unique
  idempotencyKey String?
  platform       String?
  meetingTitle   String
  startedAt      DateTime?
  endedAt        DateTime?
  transcriptHash String
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([transcriptHash])
}

model DiscoveryMessage {
  id          String   @id @default(cuid())
  discoveryId String
  role        String // user, assistant, system
  content     String   @db.Text
  chips       Json? // suggested chip options [{label, value}]
  createdAt   DateTime @default(now())

  discovery Discovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)

  @@index([discoveryId])
}

model DiscoveryChatError {
  id          String   @id @default(cuid())
  userId      String
  userMessage String   @db.Text
  errorKind   String // 'empty_response' | 'exception' | 'auth_error'
  errorDetail String?  @db.Text
  discoveryId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

// ============ SCRIPTS ============

model Script {
  id                   String   @id @default(cuid())
  podcastId            String   @unique
  turns                Json // [{speaker: "HOST"|"EXPERT", text: "..."}]
  soundCues            Json? // [{type, prompt, durationSeconds, insertAfterTurn}]
  markdown             String   @db.Text
  context              String?  @db.Text // source context used for generation
  version              Int      @default(1)
  verificationAttempts Int      @default(0)
  verificationFeedback String?  @db.Text
  verificationClaims   Json? // ClaimAnalysis[] with turnHash — persisted for incremental re-use
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
}

// ============ AUDIO SEGMENTS ============

model Segment {
  id          String  @id @default(cuid())
  podcastId   String
  speaker     String
  text        String  @db.Text
  audioUrl    String?
  order       Int
  startTime   Float? // seconds
  duration    Float? // seconds
  wordTimings Json? // Array<{ word: string; start: number; end: number }>
  version     Int     @default(1)

  ttsProvider String? // Per-segment override: 'elevenlabs' | 'openai' | 'cartesia' | etc.
  ttsModel    String? // Per-segment override: provider-specific model ID
  ttsVoiceId  String? // Per-segment override: specific voice ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  podcast            Podcast             @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  voiceTrackSegments VoiceTrackSegment[]
  segmentVisuals     SegmentVisual[]
  transitionsFrom    SegmentTransition[] @relation("TransitionFrom")
  transitionsTo      SegmentTransition[] @relation("TransitionTo")

  @@index([podcastId])
  @@index([order])
}

// ============ PODCAST VOICE ASSIGNMENTS ============

model PodcastVoice {
  id        String  @id @default(cuid())
  podcastId String
  speaker   String // "Host", "Expert", "Skeptic", etc.
  voiceId   String? // TTS voice ID (pool or clone)
  provider  String? // TTS provider that assigned the voiceId
  podcast   Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([podcastId, speaker])
  @@index([podcastId])
}

// ============ USER VOICE PREFERENCES ============

model UserVoicePreference {
  id        String @id @default(cuid())
  userId    String
  speaker   String
  voiceId   String
  sortOrder Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, speaker])
  @@index([userId])
}

// ============ PODCAST VERSIONS ============

model PodcastVersion {
  id            String   @id @default(cuid())
  podcastId     String
  version       Int
  audioUrl      String
  duration      Int?
  changeType    String // 'initial' | 'incorporation' | 'regeneration'
  changeSummary String?  @db.Text
  interactionId String?
  createdAt     DateTime @default(now())

  podcast     Podcast                 @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  interaction Interaction?            @relation(fields: [interactionId], references: [id])
  segments    PodcastVersionSegment[]

  @@unique([podcastId, version])
  @@index([podcastId])
}

model PodcastVersionSegment {
  id         String  @id @default(cuid())
  versionId  String
  segmentId  String
  order      Int
  startTime  Float?
  ttsVoiceId String? // Snapshot of segment's TTS voice ID at version time

  version PodcastVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

// ============ INTERACTIONS (Q&A during playback) ============

model Interaction {
  id        String            @id @default(cuid())
  podcastId String
  userId    String
  status    InteractionStatus @default(PENDING)

  // Question context
  question  String @db.Text
  timestamp Float // playback position in seconds

  // Answer
  answer String? @db.Text

  // Resolution
  resolved     Boolean  @default(false)
  incorporated Boolean  @default(false) // baked into podcast
  helpful      Boolean? // null = no feedback, true/false = user response
  segmentOrder Int? // computed by worker: which segment the question maps to

  // Interaction privacy
  visibility String @default("PUBLIC") // PUBLIC or PRIVATE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  podcast  Podcast          @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions PodcastVersion[]

  @@index([podcastId])
  @@index([userId])
  @@index([status])
}

enum InteractionStatus {
  PENDING
  ANSWERING
  ANSWERED
  RESOLVED
  INCORPORATING
  INCORPORATED
}

// ============ SAVES ============

model Save {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([podcastId])
}

// ============ PODCAST RATINGS ============

model PodcastRating {
  id        String @id @default(cuid())
  userId    String
  podcastId String

  voiceNaturalness    Int // 1-5: "How natural do the voices sound?"
  contentAccuracy     Int // 1-5: "Did the AI get the facts right?"
  conversationFlow    Int // 1-5: "Does the back-and-forth feel natural?"
  overallSatisfaction Int // 1-5: overall summary

  comment           String? @db.Text
  isCreator         Boolean @default(true)
  completionPercent Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([podcastId])
  @@index([podcastId, isCreator])
}

// ============ TAGS ============

model Tag {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  parentId String?

  parent   Tag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Tag[] @relation("TagHierarchy")

  podcasts      PodcastTag[]
  userInterests UserInterest[]

  @@index([slug])
  @@index([parentId])
}

model PodcastTag {
  id        String @id @default(cuid())
  podcastId String
  tagId     String

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([podcastId, tagId])
  @@index([tagId])
}

// ============ USER INTERESTS ============

model UserInterest {
  id        String   @id @default(cuid())
  userId    String
  tagId     String
  source    String   @default("onboarding") // "onboarding" | "behavioral" | "manual"
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
