// Sotto Database Schema
// Interactive Episode Platform

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// ============ USER ROLES ============

enum UserRole {
  USER
  ADMIN
}

// ============ USERS & AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  handle        String?   @unique
  image         String?
  role          UserRole  @default(USER)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  preferredLanguage    String?
  preferredTtsProvider String?
  preferredTtsModel    String?
  preferredAiProvider  String?
  preferredAiModel     String?

  // Notification preferences
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)

  // Relations
  episodes            Episode[]
  discoveries         Discovery[]
  discoveryChatErrors DiscoveryChatError[]
  interactions        Interaction[]
  notifications       Notification[]
  apiUsageLogs        ApiUsageLog[]
  pushSubscriptions   PushSubscription[]

  // Saves
  saves Save[]

  // API Keys
  apiKeys       ApiKey[]
  pairingTokens PairingToken[]

  // BYOK TTS keys (multi-provider)
  userTtsKeys UserTtsKey[]

  // BYOK AI keys (LLM providers)
  userAiKeys UserAiKey[]

  // Interests (onboarding + settings)
  interests              UserInterest[]
  hasCompletedOnboarding Boolean        @default(false)

  // Private agent output ingestions
  agentIngestions AgentIngestion[]

  // Voice preferences (multi-speaker)
  voicePreferences UserVoicePreference[]

  // Language learning
  courses            Course[]
  classSubmissions   ClassSubmission[]
  speakingRecordings SpeakingRecording[]
  writingResponses   WritingResponse[]
  mockExams          MockExam[]

  @@index([role])
  @@index([handle])
}

// ============ EPISODES ============

model Episode {
  id             String        @id @default(cuid())
  userId         String
  title          String
  slug           String?
  topic          String        @db.Text
  status         EpisodeStatus @default(PENDING)
  failedAtStatus String?
  failureReason  String?       @db.Text
  technicalError String?       @db.Text
  errorId        String?
  failedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // Audio
  audioUrl          String?
  duration          Int? // seconds
  durationDeviation Int? // seconds: (actual - target*60), null if no target set
  fileSize          Int? // bytes

  // Voice selection
  ttsProvider      String? // explicit or platform-resolved provider required before audio generation
  ttsModel         String? // e.g. 'eleven_v3', 'tts-1-hd', 'sonic-2', 'premium', 'octave'
  aiProvider       String? // 'anthropic' | 'openai'
  aiModel          String? // e.g. 'claude-sonnet-4-5-20250929', 'claude-opus-4-6'
  verificationMode String  @default("standard") // standard, relaxed, showcase
  aiAutoResolved   Boolean @default(false)
  ttsAutoResolved  Boolean @default(false)
  sttProvider      String? // required for imported audio without transcript; 'openai' | 'elevenlabs' | 'together' | 'deepgram' | 'assemblyai'
  sttModel         String? // e.g. 'whisper-1', 'whisper-large-v3-turbo', 'scribe_v1'
  language         String? // ISO 639-1, e.g. 'en', 'es', 'ja'

  // Source tracking
  source        EpisodeSource @default(WEB)

  // Visibility
  visibility EpisodeVisibility @default(PRIVATE)
  isDelisted Boolean           @default(false)

  // Versioning
  currentVersion Int @default(1)

  // PDF export
  pdfUrl String?

  // Waveform visualization
  waveformUrl    String?
  spectrogramUrl String?

  // Content/verification flags
  lowReferences        Boolean @default(false)
  verificationProgress Json? // transient progress during reference validation
  sourcePlatform       String? // e.g. "notebooklm", "spotify", "apple_episodes", "youtube"

  // Relations
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  discovery           Discovery?
  script              Script?
  segments            Segment[]
  interactions        Interaction[]
  saves               Save[]
  tags                EpisodeTag[]
  jobs                Job[]
  pipelineEvents      PipelineEvent[]
  references          Reference[]
  versions            EpisodeVersion[]
  voices              EpisodeVoice[]
  audioFingerprint    AudioFingerprint?
  agentIngestion      AgentIngestion?
  researchDossier     ResearchDossier?
  creativeOutline     CreativeOutline?
  vocabularyEntries   VocabularyEntry[]
  classSection        ClassSection?
  examSection         ExamSection?
  practiceSession     PracticeSession?

  @@unique([userId, slug])
  @@index([userId])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
  @@index([deletedAt])
}

enum EpisodeStatus {
  PENDING
  DISCOVERING
  EXTRACTING
  RESEARCHING
  PLANNING
  SCRIPTING
  COMPILING
  SCRIPT_READY
  GENERATING_AUDIO
  STITCHING
  READY
  UPDATING
  FAILED
  IMPORTING
  TRANSCRIBING
}

model ResearchDossier {
  id        String   @id @default(cuid())
  episodeId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mode             String // 'source-bound' | 'curated' | 'open-web'
  userBrief        Json // { topic, audienceLevel, tone, durationTarget, mustCover, mustAvoid, suppliedSourceUrls, discoverySummary }
  sources          Json // SourceRecord[]
  evidence         Json // EvidenceCard[]
  gaps             Json? // string[] — identified knowledge gaps
  blockedClaims    Json? // string[] — claims that couldn't be verified
  recommendedAngle String? @db.Text

  totalInputTokens  Int     @default(0)
  totalOutputTokens Int     @default(0)
  model             String?

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

model CreativeOutline {
  id        String   @id @default(cuid())
  episodeId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drivingQuestion     String @db.Text
  listenerPromise     String @db.Text
  thesis              String @db.Text
  narrativeFramework  String // 'anecdote_reflection' | 'question_cascade' | 'problem_solution' | 'editorial_comedy'
  hook                String @db.Text
  beats               Json // Beat[]
  tensionCurve        Json? // { beatOrder, tension }[]
  bannedAngles        Json? // string[]
  unresolvedQuestions Json? // string[]
  speakerRoles        Json? // { speaker, role }[]

  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  model        String?

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

enum EpisodeVisibility {
  UNLISTED
  PRIVATE
}

enum EpisodeSource {
  WEB
  API
  AGENT
  IMPORT
  ADMIN
  CLASS
}

// ============ DISCOVERY (Chat-Based) ============

model Discovery {
  id        String   @id @default(cuid())
  episodeId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Extracted metadata from chat
  topic          String?  @db.Text
  depth          String? // eli5, quick_overview, standard, deep_dive
  audienceLevel  String? // beginner, intermediate, expert
  audience       String? // kids, teens, family, general, mature
  focusAreas     String[] // array of focus topics
  tone           String? // casual, professional, socratic
  durationTarget Int? // minutes
  speakers       Json? // [{name: "Host", description: "..."}] for multi-voice
  priorKnowledge String?  @db.Text
  sourceUrl      String?
  sourceContent  String?  @db.Text
  sourceMetadata Json?

  // Verification & feasibility
  verificationMode      String  @default("standard") // standard, relaxed
  feasibilityVerdict    String? // proceed, warn, reject
  feasibilitySuggestion String? @db.Text

  // Relations
  episode  Episode            @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  messages DiscoveryMessage[]
  user     User               @relation(fields: [userId], references: [id])
  userId   String

  @@index([userId])
}

model AgentIngestion {
  id             String   @id @default(cuid())
  userId         String
  episodeId      String   @unique
  idempotencyKey String?
  provider       String
  agentName      String
  runId          String?
  contentHash    String
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([contentHash])
}

model DiscoveryMessage {
  id          String   @id @default(cuid())
  discoveryId String
  role        String // user, assistant, system
  content     String   @db.Text
  chips       Json? // suggested chip options [{label, value}]
  createdAt   DateTime @default(now())

  discovery Discovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)

  @@index([discoveryId])
}

model DiscoveryChatError {
  id          String   @id @default(cuid())
  userId      String
  userMessage String   @db.Text
  errorKind   String // 'empty_response' | 'exception' | 'auth_error'
  errorDetail String?  @db.Text
  discoveryId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

// ============ SCRIPTS ============

model Script {
  id                   String   @id @default(cuid())
  episodeId            String   @unique
  turns                Json // [{speaker: "HOST"|"EXPERT", text: "..."}]
  soundCues            Json? // [{type, prompt, durationSeconds, insertAfterTurn}]
  markdown             String   @db.Text
  context              String?  @db.Text // source context used for generation
  version              Int      @default(1)
  verificationAttempts Int      @default(0)
  verificationFeedback String?  @db.Text
  verificationClaims   Json? // ClaimAnalysis[] with turnHash — persisted for incremental re-use
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
}

// ============ AUDIO SEGMENTS ============

model Segment {
  id          String  @id @default(cuid())
  episodeId   String
  speaker     String
  text        String  @db.Text
  audioUrl    String?
  order       Int
  startTime   Float? // seconds
  duration    Float? // seconds
  wordTimings Json? // Array<{ word: string; start: number; end: number }>
  version     Int     @default(1)

  ttsProvider String? // Per-segment override: 'elevenlabs' | 'openai' | 'cartesia' | etc.
  ttsModel    String? // Per-segment override: provider-specific model ID
  ttsVoiceId  String? // Per-segment override: specific voice ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episode            Episode             @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId])
  @@index([order])
}

// ============ EPISODE VOICE ASSIGNMENTS ============

model EpisodeVoice {
  id        String  @id @default(cuid())
  episodeId String
  speaker   String // "Host", "Expert", "Skeptic", etc.
  voiceId   String? // TTS voice ID (pool or clone)
  provider  String? // TTS provider that assigned the voiceId
  episode   Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, speaker])
  @@index([episodeId])
}

// ============ USER VOICE PREFERENCES ============

model UserVoicePreference {
  id        String @id @default(cuid())
  userId    String
  speaker   String
  voiceId   String
  sortOrder Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, speaker])
  @@index([userId])
}

// ============ EPISODE VERSIONS ============

model EpisodeVersion {
  id            String   @id @default(cuid())
  episodeId     String
  version       Int
  audioUrl      String
  duration      Int?
  changeType    String // 'initial' | 'incorporation' | 'regeneration'
  changeSummary String?  @db.Text
  interactionId String?
  createdAt     DateTime @default(now())

  episode     Episode                 @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  interaction Interaction?            @relation(fields: [interactionId], references: [id])
  segments    EpisodeVersionSegment[]

  @@unique([episodeId, version])
  @@index([episodeId])
}

model EpisodeVersionSegment {
  id         String  @id @default(cuid())
  versionId  String
  segmentId  String
  order      Int
  startTime  Float?
  ttsVoiceId String? // Snapshot of segment's TTS voice ID at version time

  version EpisodeVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

// ============ INTERACTIONS (Q&A during playback) ============

model Interaction {
  id        String            @id @default(cuid())
  episodeId String
  userId    String
  status    InteractionStatus @default(PENDING)

  // Question context
  question  String @db.Text
  timestamp Float // playback position in seconds

  // Answer
  answer String? @db.Text

  // Resolution
  resolved     Boolean  @default(false)
  incorporated Boolean  @default(false) // baked into episode
  helpful      Boolean? // null = no feedback, true/false = user response
  segmentOrder Int? // computed by worker: which segment the question maps to

  // Interaction privacy
  visibility String @default("PUBLIC") // PUBLIC or PRIVATE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episode  Episode          @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions EpisodeVersion[]

  @@index([episodeId])
  @@index([userId])
  @@index([status])
}

enum InteractionStatus {
  PENDING
  ANSWERING
  ANSWERED
  RESOLVED
  INCORPORATING
  INCORPORATED
}

// ============ SAVES ============

model Save {
  id        String   @id @default(cuid())
  userId    String
  episodeId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([userId, episodeId])
  @@index([episodeId])
}

// ============ TAGS ============

model Tag {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  parentId String?

  parent   Tag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Tag[] @relation("TagHierarchy")

  episodes      EpisodeTag[]
  userInterests UserInterest[]

  @@index([slug])
  @@index([parentId])
}

model EpisodeTag {
  id        String @id @default(cuid())
  episodeId String
  tagId     String

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([episodeId, tagId])
  @@index([tagId])
}

// ============ USER INTERESTS ============

model UserInterest {
  id        String   @id @default(cuid())
  userId    String
  tagId     String
  source    String   @default("onboarding") // "onboarding" | "manual"
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([userId])
  @@index([tagId])
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  data      Json?
  read      Boolean          @default(false)
  pushed    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

enum NotificationType {
  EPISODE_READY
  EPISODE_FAILED
  KEY_INVALID
  SCRIPT_READY
  PLATFORM_ANNOUNCEMENT
  PIPELINE_FAILURE
}

// ============ PUSH SUBSCRIPTIONS ============

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ JOBS (BullMQ tracking) ============

model Job {
  id        String   @id @default(cuid())
  episodeId String?
  type      String
  payload   Json
  status    String // pending, processing, complete, failed
  result    Json?
  error     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  episode Episode? @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([type, status])
  @@index([episodeId])
  @@index([status])
  @@index([createdAt])
}

// ============ PIPELINE EVENTS ============

model PipelineEvent {
  id        String   @id @default(cuid())
  episodeId String
  createdAt DateTime @default(now())
  stage     String // queue name: 'audio-generation', 'script-verification', etc.
  type      String // 'error' | 'warning' | 'retry' | 'complete'
  message   String   @db.Text
  metadata  Json? // { segmentId?, jobId?, attemptNumber?, errorKind? }

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([episodeId, createdAt])
  @@index([type, createdAt])
}

// ============ API USAGE TRACKING ============

model ApiUsageLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  episodeId String?
  userId    String?
  service   String // anthropic, openai, elevenlabs, etc.
  modelId   String? // e.g. 'claude-sonnet-4-5-20250929', 'whisper-1', 'eleven_v3'
  category  String // discovery, script_generation, audio_generation, interaction

  // Cost tracking
  inputTokens  Int?
  outputTokens Int?
  totalCost    Float

  // Performance
  durationMs Int?

  metadata Json @default("{}")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([episodeId])
  @@index([userId])
  @@index([createdAt])
  @@index([service])
  @@index([modelId])
}

// ============ FEEDBACK (Early Access) ============

model Feedback {
  id        String         @id @default(cuid())
  userId    String?
  email     String?
  name      String?
  type      FeedbackType
  rating    Int? // 1-5 stars
  subject   String
  message   String         @db.Text
  context   String? // page/feature where feedback was given
  status    FeedbackStatus @default(NEW)
  response  String?        @db.Text // admin response
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  GENERAL
  PRAISE
  CONCERN
}

enum FeedbackStatus {
  NEW
  REVIEWED
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

// ============ API KEYS ============

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  keyPrefix  String // first 16 chars for display (sk_sotto_XXXX...)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

// ============ DEVICE PAIRING ============

// Short-lived, single-use "scan to connect" token. The QR a learner shows on the
// server renders {serverUrl, token}; a phone/tablet redeems it for a long-lived
// ApiKey. Only the hash is stored — the raw token lives in the QR for a few minutes.
model PairingToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  name      String    @default("Paired device")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// ============ REFERENCES (Citations) ============

model Reference {
  id        String        @id @default(cuid())
  episodeId String
  number    Int
  title     String        @db.Text
  authors   String[]
  year      Int?
  url       String?       @db.Text
  type      ReferenceType @default(WEB)
  publisher String?
  doi       String?
  createdAt DateTime      @default(now())

  // Verification
  verificationStatus  VerificationStatus @default(PENDING)
  verificationDetails Json?
  originalTitle       String?            @db.Text
  contentDomain       String? // 'ACADEMIC' | 'NEWS' | 'GOVERNMENT' | 'EDUCATIONAL' | 'GENERAL'

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, number])
  @@index([episodeId])
}

model VocabularyEntry {
  id              String   @id @default(cuid())
  episodeId       String
  number          Int // [V1], [V2] marker index, 1-based
  word            String // target language word/phrase
  translation     String // native language translation
  partOfSpeech    String? // noun, verb, adjective, etc.
  pronunciation   String? // phonetic guide (e.g. "SHPREE-chen")
  exampleSentence String?  @db.Text // usage in context
  difficulty      String? // beginner, intermediate, advanced
  createdAt       DateTime @default(now())

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@unique([episodeId, number])
  @@index([episodeId])
}

enum ReferenceType {
  WEB
  PAPER
  BOOK
  ARTICLE
  VIDEO
  REPORT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  REPLACED
  REMOVED
}

// ============ RESERVED HANDLES ============

model ReservedHandle {
  id        String   @id @default(cuid())
  handle    String   @unique
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())
}

// ============ USER TTS KEYS (Multi-Provider BYOK) ============

model UserTtsKey {
  id           String    @id @default(cuid())
  userId       String
  provider     String // 'elevenlabs' | 'openai' | 'cartesia' | 'hume' | 'fal' | 'replicate'
  encryptedKey String    @db.Text
  extraData    String?   @db.Text // encrypted JSON for multi-field auth
  isValid      Boolean   @default(true)
  label        String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// ============ USER AI KEYS (LLM BYOK) ============

model UserAiKey {
  id           String    @id @default(cuid())
  userId       String
  provider     String // 'anthropic' | 'openai'
  encryptedKey String    @db.Text
  isValid      Boolean   @default(true)
  label        String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// ============ AUTO MODEL CONFIG ============

model AutoModelConfig {
  id                  String   @id @default("singleton")
  aiProvider          String   @default("anthropic")
  aiModel             String   @default("claude-haiku-4-5-20251001")
  ttsProvider         String   @default("openai")
  ttsModel            String   @default("tts-1-hd")
  sttProvider         String   @default("openai")
  sttModel            String   @default("whisper-large-v3-turbo")
  platformAiProvider  String   @default("anthropic")
  platformAiModel     String   @default("claude-haiku-4-5-20251001")
  includedModels      Json?
  includedTtsModels   Json?
  includedSttModels   Json?
  updatedAt           DateTime @updatedAt
  updatedBy           String?
}

// ============ SITE CONFIG ============

model SiteConfig {
  id         String   @id @default("singleton")

  // Owner-set server infrastructure (non-secret selection only; null = fall back to env).
  // Secrets (provider keys, R2/S3 credentials) never live here — they stay in env or the
  // encrypted BYOK store. Set by the owner through the onboarding wizard.
  aiProvider      String?
  aiModel         String?
  aiBaseUrl       String?
  sttProvider     String?
  sttBaseUrl      String?
  sttModel        String?
  ttsProvider     String?
  ttsBaseUrl      String?
  storageProvider String?
  s3Bucket        String?
  s3Region        String?

  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ============ AUDIO FINGERPRINTING & DUPLICATE DETECTION ============

model AudioFingerprint {
  id          String   @id @default(cuid())
  episodeId   String   @unique
  fingerprint Int[]
  duration    Int // seconds
  createdAt   DateTime @default(now())

  episode Episode @relation(fields: [episodeId], references: [id], onDelete: Cascade)

  @@index([duration])
}

// ============ MODEL PRICING SNAPSHOTS ============

model ModelPricingSnapshot {
  id              String   @id @default(cuid())
  modelId         String
  provider        String
  inputPerMTok    Float
  outputPerMTok   Float
  contextWindow   Int?
  maxOutputTokens Int?
  source          String   @default("registry") // "registry" | "fetched" | "admin"
  createdAt       DateTime @default(now())

  @@index([modelId, createdAt])
  @@index([createdAt])
}

// ============ LANGUAGE LEARNING — CURRICULUM ============

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

// The learner's chosen teaching approach, grounded in second-language-acquisition
// research. Shapes how content is generated so a learner can switch methods if one
// is not working for them. See lib/pedagogy.ts for the evidence behind each.
enum PedagogyStyle {
  BALANCED // mix of comprehensible input, form-focus, and retrieval practice
  IMMERSION // comprehensible input (Krashen i+1), target-language-first
  GRAMMAR // explicit, form-focused instruction
  COMMUNICATION // communicative output (Swain), fluency-first
  INTENSIVE // retrieval practice + spaced repetition (the testing effect)
}

// Global curriculum: one per native→target language pair.
// source: 'seeded' = hand-authored JSON; 'generated' = agent-composed on demand.
model Curriculum {
  id         String   @id @default(cuid())
  nativeLang String // ISO 639-1, e.g. "en"
  targetLang String // ISO 639-1, e.g. "de"
  title      String
  version    Int      @default(1)
  source     String   @default("seeded") // "seeded" | "generated"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lessons Lesson[]
  courses Course[]

  @@unique([nativeLang, targetLang])
}

// A node in the fixed lesson tree. Ordering + competencies are fixed; class
// instances generated from a lesson adapt to the learner's weak items.
model Lesson {
  id            String    @id @default(cuid())
  curriculumId  String
  level         CefrLevel
  order         Int // global gate ordering within the curriculum
  parentId      String? // tree: unit -> lesson; null = top-level unit
  slug          String // stable key, e.g. "a1-greetings"
  title         String
  objective     String    @db.Text
  grammarPoints Json // string[] of grammar topic keys, e.g. ["present-tense-sein"]
  vocabThemes   Json // string[] themes, e.g. ["greetings","numbers-1-20"]
  targetVocab   Json // [{ lemma, gloss, pos? }]
  canDoSummary  String?   @db.Text // CEFR can-do statement
  estMinutes    Int       @default(60)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  parent     Lesson?    @relation("LessonTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Lesson[]      @relation("LessonTree")
  classes    CourseClass[]

  @@unique([curriculumId, slug])
  @@unique([curriculumId, order])
  @@index([curriculumId, level, order])
  @@index([parentId])
}

// A learner's enrollment in one language pair. CEFR level lives here (a user
// can hold several courses at several levels).
model Course {
  id            String    @id @default(cuid())
  userId        String
  nativeLang    String
  targetLang    String
  curriculumId  String
  currentLevel  CefrLevel @default(A1) // "you are here"; assigned by placement, advances with mastery
  startLevel    CefrLevel @default(A1) // immutable placement result
  pedagogy      PedagogyStyle @default(BALANCED) // teaching approach; shapes generation
  activeClassId String? // current in-flight class (gating convenience cache)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  curriculum       Curriculum        @relation(fields: [curriculumId], references: [id])
  placement        PlacementResult?
  classes          CourseClass[]
  vocab            LearnerVocab[]
  grammar          LearnerGrammar[]
  vocabEdges       VocabEdge[]
  practiceSessions PracticeSession[]
  note             CourseNote?
  mockExams        MockExam[]

  @@unique([userId, nativeLang, targetLang]) // one course per user per language pair
  @@index([userId])
  @@index([curriculumId])
}

// Snapshot of the adaptive placement test that assigned a course's start level.
model PlacementResult {
  id           String    @id @default(cuid())
  courseId     String    @unique
  level        CefrLevel
  responses    Json // [{ questionId, skill, cefr, selectedIndex, correct }]
  scoreBySkill Json // { grammar, vocab, listening } -> 0..1
  model        String?
  provider     String?
  createdAt    DateTime  @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// ============ LANGUAGE LEARNING — CLASSES ============

enum SkillType {
  GRAMMAR
  READING
  LISTENING
  SPEAKING
  WRITING
}

enum ClassStatus {
  LOCKED
  GENERATING
  AVAILABLE
  IN_PROGRESS
  SUBMITTED
  PASSED
  FAILED
}

enum SectionStatus {
  PENDING
  GENERATING
  READY
  IN_PROGRESS
  SUBMITTED
  PASSED
  FAILED
}

// Single-skill practice. VOCAB is first-class here (spaced-repetition recall)
// and is deliberately NOT in SkillType, which gates the four class sections.
enum PracticeKind {
  GRAMMAR
  READING
  LISTENING
  SPEAKING
  WRITING
  VOCAB
}

enum PracticeStatus {
  ACTIVE
  COMPLETED
}

// A ~1h class instantiated from a Lesson for a specific course. Mastery-gated:
// the next class only unlocks once this one is PASSED.
model CourseClass {
  id              String      @id @default(cuid())
  courseId        String
  lessonId        String
  order           Int // mirrors Lesson.order; stable user-facing sequence
  status          ClassStatus @default(LOCKED)
  attempt         Int         @default(1) // whole-class retry counter
  adaptiveSeed    Json? // { vocabIds, grammarKeys, dueCount } that seeded this class
  passThreshold   Float       @default(0.7) // fraction of sections that must pass
  worksheetPdfUrl String?
  sourceUrl       String? // sourced class: the real article/paper/link it was built from (null = curriculum class)
  sourceTitle     String? // human-readable source title for display
  submittedAt     DateTime?
  passedAt        DateTime?
  failedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson     Lesson           @relation(fields: [lessonId], references: [id])
  sections   ClassSection[]
  submission ClassSubmission?

  @@index([courseId, order])
  @@index([courseId, status])
  @@index([lessonId])
}

// One skill section per (re)attempt. Failed-section regeneration = a new row
// with attempt+1 and a new seed; the latest attempt per (class, skill) is active.
model ClassSection {
  id            String        @id @default(cuid())
  classId       String
  skill         SkillType
  attempt       Int           @default(1)
  status        SectionStatus @default(PENDING)
  seed          String // variation token; changes on retry -> similar-but-not-identical
  spec          Json // resolved generation spec (objective + adaptive items used)
  score         Float?
  passed        Boolean?
  passThreshold Float         @default(0.7)
  episodeId     String?       @unique // LISTENING section -> reuse Episode; @unique because one section per episode
  generatedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  class         CourseClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  episode       Episode?         @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  questions     LessonQuestion[]
  prompts       SpeakingPrompt[]
  writingPrompts WritingPrompt[]

  @@index([classId, skill, attempt])
}

// MC question for a GRAMMAR/READING/LISTENING section. Forked from the old
// post-listen quiz question shape, but supports retries and has no episode.
model LessonQuestion {
  id           String   @id @default(cuid())
  sectionId    String
  order        Int
  skill        SkillType
  question     String   @db.Text
  options      Json // ["A","B","C","D"]
  correctIndex Int
  explanation  String   @db.Text
  vocabIds     String[] @default([]) // memory-graph linkage (later phases)
  grammarKeys  String[] @default([])
  passageRef   String?  @db.Text // short label/anchor for the passage or listening turn
  passageText  String?  @db.Text // the actual reading passage (sourced classes: a CEFR-leveled excerpt with [N] citations)
  createdAt    DateTime @default(now())

  section ClassSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, order])
  @@index([sectionId])
}

// One submission per class attempt; aggregates the graded MC answers.
model ClassSubmission {
  id           String   @id @default(cuid())
  classId      String   @unique
  userId       String
  overallScore Float?
  passed       Boolean?
  submittedAt  DateTime @default(now())

  class   CourseClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers SectionAnswer[]

  @@index([userId])
}

model SectionAnswer {
  id            String   @id @default(cuid())
  submissionId  String
  sectionId     String
  questionId    String
  selectedIndex Int
  isCorrect     Boolean
  answeredAt    DateTime @default(now())

  submission ClassSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([sectionId])
}

// ============ LANGUAGE LEARNING — SPEAKING ============

enum SpeakingGradeStatus {
  PENDING
  GRADING
  SCORED
  FAILED
}

// One target phrase the learner must say aloud, hung off a SPEAKING ClassSection.
// A speaking prompt hangs off EXACTLY ONE parent: a class section (gated class)
// or a practice session (ungated). The XOR is enforced in app code.
model SpeakingPrompt {
  id                String   @id @default(cuid())
  sectionId         String?
  practiceSessionId String?
  examSectionId     String?
  order             Int
  targetPhrase      String   @db.Text
  translation       String   @db.Text
  ipa               String?  @db.Text
  referenceTtsUrl   String? // pre-rendered model pronunciation (resolveTtsProvider at build)
  createdAt         DateTime @default(now())

  section         ClassSection?    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  practiceSession PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  examSection     ExamSection?     @relation(fields: [examSectionId], references: [id], onDelete: Cascade)
  recordings      SpeakingRecording[]

  @@unique([sectionId, order])
  @@unique([practiceSessionId, order])
  @@unique([examSectionId, order])
  @@index([sectionId])
  @@index([practiceSessionId])
  @@index([examSectionId])
}

// A learner's recorded attempt at a SpeakingPrompt, graded asynchronously.
model SpeakingRecording {
  id                String              @id @default(cuid())
  sectionId         String?
  practiceSessionId String?
  examSectionId     String?
  promptId          String
  userId            String
  audioUrl          String
  transcript        String?             @db.Text
  overallScore      Float? // 0..1 combined pronunciation score
  rubricScores      Json? // { accuracy, fluency, completeness } each 0..1
  phonemeScores     Json? // per-word alignment ops from align.ts
  feedback          String?             @db.Text
  status            SpeakingGradeStatus @default(PENDING)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  prompt          SpeakingPrompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceSession PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([practiceSessionId])
  @@index([examSectionId])
  @@index([promptId])
  @@index([userId])
}

// A writing task. Hangs off EXACTLY ONE parent (a class section or a practice
// session), like SpeakingPrompt; XOR enforced in app code.
model WritingPrompt {
  id                String   @id @default(cuid())
  sectionId         String?
  practiceSessionId String?
  examSectionId     String?
  order             Int
  task              String   @db.Text // the writing task the learner responds to
  guidance          String?  @db.Text // optional hints / what to include
  createdAt         DateTime @default(now())

  section         ClassSection?     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  practiceSession PracticeSession?  @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  examSection     ExamSection?      @relation(fields: [examSectionId], references: [id], onDelete: Cascade)
  responses       WritingResponse[]

  @@unique([sectionId, order])
  @@unique([practiceSessionId, order])
  @@unique([examSectionId, order])
  @@index([sectionId])
  @@index([practiceSessionId])
  @@index([examSectionId])
}

// A learner's writing response, graded synchronously by the LLM (corrections +
// score), unlike speaking which is graded async by a worker.
model WritingResponse {
  id                String   @id @default(cuid())
  sectionId         String?
  practiceSessionId String?
  examSectionId     String?
  promptId          String
  userId            String
  text              String   @db.Text
  overallScore      Float? // 0..1
  corrections       Json? // [{ old, new, why }]
  feedback          String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  prompt          WritingPrompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceSession PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([practiceSessionId])
  @@index([examSectionId])
  @@index([promptId])
  @@index([userId])
}

// ============ LANGUAGE LEARNING — MOCK EXAMS ============

// Flagship CEFR exam whose FORMAT a mock exam is modeled on. Never affiliated
// with the real institution; we replicate structure only, never exam content.
enum ExamInstitution {
  GOETHE // German (Goethe-Institut)
  DELE // Spanish (Instituto Cervantes)
  CAMBRIDGE // English (Cambridge English Qualifications)
  CEFR_GENERIC // institution-agnostic CEFR mock
}

enum MockExamStatus {
  GENERATING
  READY
  IN_PROGRESS
  SUBMITTED
  SCORED
  FAILED
}

// An ungated, full-length practice exam modeled on a flagship CEFR exam format.
// Self-assessment only: it NEVER advances Course.currentLevel.
model MockExam {
  id          String          @id @default(cuid())
  userId      String
  courseId    String
  institution ExamInstitution
  level       CefrLevel
  status      MockExamStatus  @default(GENERATING)
  blueprintId String // catalog id, e.g. "goethe/b1"
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sections   ExamSection[]
  submission ExamSubmission?

  @@index([userId])
  @@index([courseId])
}

// One part of a mock exam (e.g. "Leseverstehen Teil 1"). LISTENING reuses Episode;
// speaking/writing reuse SpeakingPrompt/WritingPrompt via their examSectionId FK.
model ExamSection {
  id        String        @id @default(cuid())
  examId    String
  skill     SkillType
  part      String // institution-flavored part name
  order     Int
  format    String // 'mc' | 'listening' | 'speaking' | 'writing'
  weight    Float         @default(0) // share of the overall band; sums to ~1 per exam
  status    SectionStatus @default(PENDING)
  episodeId String?       @unique // LISTENING section -> reuse Episode
  score     Float?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  exam            MockExam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  episode         Episode?         @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  questions       ExamQuestion[]
  speakingPrompts SpeakingPrompt[]
  writingPrompts  WritingPrompt[]

  @@index([examId, order])
}

// MC question for an exam section. Mirrors LessonQuestion; MC has no async grading
// so a separate model keeps exams decoupled from ClassSection.
model ExamQuestion {
  id           String   @id @default(cuid())
  sectionId    String
  order        Int
  skill        SkillType
  question     String   @db.Text
  options      Json // ["A","B","C","D"]
  correctIndex Int
  explanation  String   @db.Text
  passageRef   String?  @db.Text
  passageText  String?  @db.Text
  createdAt    DateTime @default(now())

  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, order])
  @@index([sectionId])
}

// One submission per exam: the mock band + overall feedback. Does not change level.
model ExamSubmission {
  id           String   @id @default(cuid())
  examId       String   @unique
  overallScore Float?
  band         String? // e.g. "B2 (mock)"
  feedback     String?  @db.Text
  submittedAt  DateTime @default(now())

  exam           MockExam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  sectionResults ExamSectionResult[]
}

model ExamSectionResult {
  id           String  @id @default(cuid())
  submissionId String
  sectionId    String
  skill        SkillType
  score        Float // 0..1
  feedback     String? @db.Text

  submission ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, sectionId])
  @@index([sectionId])
}

// ============ LANGUAGE LEARNING — MEMORY GRAPH (SRS) ============

enum EdgeType {
  VOCAB_VOCAB // collocation / morphological relation
  VOCAB_GRAMMAR // word exemplifies a grammar topic
  VOCAB_CLASS // word introduced / practiced in a class
  VOCAB_EPISODE // word appeared in a listening episode
  GRAMMAR_GRAMMAR // prerequisite chain
}

// Per-course vocabulary node with SM-2 spaced-repetition state.
model LearnerVocab {
  id            String  @id @default(cuid())
  courseId      String
  lemma         String // canonical target-language form
  translation   String
  partOfSpeech  String?
  pronunciation String?
  // SRS state (SM-2)
  ease         Float     @default(2.5)
  intervalDays Float     @default(0)
  dueAt        DateTime  @default(now())
  reps         Int       @default(0)
  lapses       Int       @default(0)
  mastery      Float     @default(0) // 0..1 rolled-up strength
  lastReviewed DateTime?
  // provenance
  firstSeenClassId String?
  cefrLevel        CefrLevel?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  course   Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  edgesOut VocabEdge[] @relation("EdgeSource")
  edgesIn  VocabEdge[] @relation("EdgeTarget")

  @@unique([courseId, lemma])
  @@index([courseId, dueAt])
  @@index([courseId, mastery])
}

// Per-course grammar-topic node with SRS state.
model LearnerGrammar {
  id           String     @id @default(cuid())
  courseId     String
  topicKey     String // matches Lesson.grammarPoints keys
  title        String
  cefrLevel    CefrLevel?
  ease         Float      @default(2.5)
  intervalDays Float      @default(0)
  dueAt        DateTime   @default(now())
  reps         Int        @default(0)
  lapses       Int        @default(0)
  mastery      Float      @default(0)
  lastReviewed DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, topicKey])
  @@index([courseId, dueAt])
  @@index([courseId, mastery])
}

// Polymorphic edge: exactly the endpoints relevant to `type` are non-null.
model VocabEdge {
  id            String   @id @default(cuid())
  courseId      String
  type          EdgeType
  weight        Float    @default(1.0)
  sourceVocabId String?
  targetVocabId String?
  grammarId     String?
  classId       String?
  episodeId     String?
  createdAt     DateTime @default(now())

  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sourceVocab LearnerVocab? @relation("EdgeSource", fields: [sourceVocabId], references: [id], onDelete: Cascade)
  targetVocab LearnerVocab? @relation("EdgeTarget", fields: [targetVocabId], references: [id], onDelete: Cascade)

  @@index([courseId, type])
  @@index([sourceVocabId])
  @@index([targetVocabId])
  @@index([grammarId])
}

// Ungated single-skill practice within a course. Distinct from the gated
// CourseClass: short, repeatable, and only consolidates the memory graph (SRS).
model PracticeSession {
  id           String         @id @default(cuid())
  courseId     String
  kind         PracticeKind
  status       PracticeStatus @default(ACTIVE)
  items        Json // generated practice items (recall cards / questions / prompt refs)
  seed         String
  score        Float? // 0..1, set on submit
  vocabLemmas  String[]       @default([]) // lemmas this session reviews (SRS targets)
  grammarKeys  String[]       @default([]) // grammar topicKeys this session reviews
  episodeId    String?        @unique // LISTENING practice audio (one episode per session)
  startedAt    DateTime       @default(now())
  completedAt  DateTime?

  course           Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  episode          Episode?            @relation(fields: [episodeId], references: [id], onDelete: SetNull)
  prompts          SpeakingPrompt[]
  recordings       SpeakingRecording[]
  writingPrompts   WritingPrompt[]
  writingResponses WritingResponse[]

  @@index([courseId, kind])
  @@index([courseId, status])
}

// One editable free-text context doc per course: goals, background, interests.
// Feeds placement + per-learner class/practice generation; never the shared curriculum.
model CourseNote {
  id        String   @id @default(cuid())
  courseId  String   @unique
  body      String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}
