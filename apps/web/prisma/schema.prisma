  @@unique([userId, questionId])
  @@index([userId])
}

// ============ SAVED IDEAS ============

model SavedIdea {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  question   String
  tagSlugs   String[]
  category   String
  podcastId  String?  @unique
  createdAt  DateTime @default(now())

