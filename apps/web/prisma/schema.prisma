  proTtsProvider           String   @default("elevenlabs")
  proTtsModel              String   @default("eleven_v3")
  proSttProvider           String   @default("openai")
  proSttModel              String   @default("whisper-large-v3-turbo")
  platformAiProvider       String   @default("anthropic")
  platformAiModel          String   @default("claude-haiku-4-5-20251001")
  freeIncludedModels       Json?
  proIncludedModels        Json?
  freeIncludedTtsModels    Json?
  proIncludedTtsModels     Json?
  freeIncludedSttModels    Json?
  proIncludedSttModels     Json?
  // Image (still images for video visuals)
  freeImageProvider        String   @default("fal")
  freeImageModel           String   @default("fal-flux-1-schnell")
  proImageProvider         String   @default("fal")
  proImageModel            String   @default("fal-flux-1-schnell")
  freeIncludedImageModels  Json?
  proIncludedImageModels   Json?
  // Video (text-to-video)
  freeVideoProvider        String   @default("fal")
  freeVideoModel           String   @default("fal-wan2.5-480p")
  proVideoProvider         String   @default("fal")
  proVideoModel            String   @default("fal-wan2.5-480p")
  freeIncludedVideoModels  Json?
  proIncludedVideoModels   Json?
  // Avatar (lip-sync avatar overlays)
  freeAvatarProvider       String   @default("heygen")
  freeAvatarModel          String   @default("heygen-avatar-standard")
  proAvatarProvider        String   @default("heygen")
  proAvatarModel           String   @default("heygen-avatar-standard")
  freeIncludedAvatarModels Json?
