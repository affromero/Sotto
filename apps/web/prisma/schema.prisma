// ============ REPORTS ============

enum ReportReason {
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  SEXUAL_CONTENT
  MISINFORMATION
  SPAM
  IMPERSONATION
  COPYRIGHT
  VOICE_THEFT
  MUSIC_UPLOAD
  FALSE_HUMAN_BADGE
  FALSE_CLAIM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED_ACTIONED
  RESOLVED_DISMISSED
  ASSET_REPLACED
  DELISTED
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  targetType  String // 'podcast' | 'comment' | 'user'
  targetId    String
  reason      ReportReason
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  resolvedBy  String?
  resolution  String?      @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  // Copyright claim fields (used when reason = COPYRIGHT)
  claimantEmail   String?
  claimantName    String?
  evidenceUrl     String?
  segmentVisualId String?
  counterNotice   String? @db.Text

  reporter      User           @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  segmentVisual SegmentVisual? @relation(fields: [segmentVisualId], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

model ContentFlag {
  id         String   @id @default(cuid())
  targetType String // 'podcast' | 'comment' | 'discovery_message'
  targetId   String
  userId     String?
  categories String[]
  scores     Json
  source     String // 'auto_input' | 'auto_output' | 'worker_scan'
  reviewed   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([reviewed, createdAt])
  @@index([targetType, targetId])
}

// ============ CLAIM REPORTS ============

enum ClaimReportStatus {
  PENDING
  REVIEWING
  RESOLVED_VERIFIED
  RESOLVED_INACCURATE
  DISMISSED
}

model ClaimReport {
  id          String            @id @default(cuid())
