// Sotto Database Schema
// Interactive Podcast Platform

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_DATABASE_URL")
  extensions = [vector]
}

// ============ USER ROLES ============

enum UserRole {
  USER
  ADMIN
  SYSTEM
}

// ============ VIDEO GENERATION ============

enum VisualType {
  DATA_CHART
  QUOTE
  COMPARISON
  TIMELINE
  DIAGRAM
  STOCK_FOOTAGE
  AI_ILLUSTRATION
  TEXT_CARD
  MAP_OVERLAY
  DATA_TABLE
  SOURCE_FIGURE
}

enum VideoStatus {
  DRAFT
  PENDING
  CLASSIFYING
  GENERATING_VISUALS
  GENERATING_TRANSITIONS
  GENERATING_AVATARS
  COMPOSING
  READY
  FAILED
  STALE
}

// ============ USERS & AUTH ============

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  handle        String?   @unique
  image         String?
  bio           String?   @db.Text
  role          UserRole  @default(USER)
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Local profile sign-in (self-hosted). passwordHash is scrypt (lib/password.ts);
  // forcePasswordChange makes a member set a new password on first sign-in;
  // tokenVersion is bumped to invalidate active JWT sessions (member removal,
  // password reset). All null/zero for OAuth-only accounts.
  passwordHash        String?
  forcePasswordChange Boolean @default(false)
  tokenVersion        Int     @default(0)

  preferredLanguage    String?
  preferredTtsProvider String?
  preferredTtsModel    String?
  preferredAiProvider  String?
  preferredAiModel     String?

  // Notification preferences
  emailNotifications Boolean @default(true)
  pushNotifications  Boolean @default(true)

  // Relations
  accounts            Account[]
  sessions            Session[]
  podcasts            Podcast[]
  discoveries         Discovery[]
  discoveryChatErrors DiscoveryChatError[]
  interactions        Interaction[]
  notifications       Notification[]
  apiUsageLogs        ApiUsageLog[]
  pushSubscriptions   PushSubscription[]
  expoPushTokens      ExpoPushToken[]
  voiceClones         VoiceClone[]

  // Saves
  saves Save[]

  // API Keys
  apiKeys       ApiKey[]
  pairingTokens PairingToken[]

  // BYOK TTS keys (multi-provider)
  userTtsKeys UserTtsKey[]

  // BYOK AI keys (LLM providers)
  userAiKeys UserAiKey[]

  // Interests (onboarding + settings)
  interests              UserInterest[]
  hasCompletedOnboarding Boolean        @default(false)

  // Taste quiz
  tasteQuizAnswers TasteQuizAnswer[]

  // Private agent output ingestions
  agentIngestions AgentIngestion[]

  // Moderation
  bannedAt        DateTime?
  bannedReason    String?   @db.Text
  suspendedUntil  DateTime?
  suspendedReason String?   @db.Text
  warningCount    Int       @default(0)

  // Moderation relations
  moderationActions   ModerationAction[] @relation("ModeratedUser")
  moderationPerformed ModerationAction[] @relation("Moderator")
  reports             Report[]           @relation("Reporter")
  // Referrals
  referredById       String?
  referredBy         User?     @relation("Referrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals          User[]    @relation("Referrals")
  referralVerified   Boolean   @default(false)
  referralVerifiedAt DateTime?

  // Voice preferences (multi-speaker)
  voicePreferences UserVoicePreference[]

  // Invitation links created by admin
  invitationLinks InvitationLink[] @relation("InvitationLinksCreated")

  // Demo projects (admin video studio)
  demoProjects DemoProject[]

  // Avatar images (lip-sync)
  avatarImages         AvatarImage[]
  avatarSharesSent     AvatarImageShare[] @relation("AvatarShareRequester")
  avatarSharesReceived AvatarImageShare[] @relation("AvatarShareOwner")

  // Language learning
  courses            Course[]
  classSubmissions   ClassSubmission[]
  speakingRecordings SpeakingRecording[]
  writingResponses   WritingResponse[]
  mockExams          MockExam[]

  @@index([role])
  @@index([handle])
  @@index([referredById])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============ PODCASTS ============

model Podcast {
  id             String        @id @default(cuid())
  userId         String
  title          String
  slug           String?
  topic          String        @db.Text
  status         PodcastStatus @default(PENDING)
  failedAtStatus String?
  failureReason  String?       @db.Text
  technicalError String?       @db.Text
  errorId        String?
  failedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  // Audio
  audioUrl          String?
  duration          Int? // seconds
  durationDeviation Int? // seconds: (actual - target*60), null if no target set
  fileSize          Int? // bytes

  // Voice selection
  ttsProvider      String? // explicit or platform-resolved provider required before audio generation
  ttsModel         String? // e.g. 'eleven_v3', 'tts-1-hd', 'sonic-2', 'premium', 'octave'
  aiProvider       String? // 'anthropic' | 'openai'
  aiModel          String? // e.g. 'claude-sonnet-4-5-20250929', 'claude-opus-4-6'
  verificationMode String  @default("standard") // standard, relaxed, showcase
  zeroCostVideo    Boolean @default(false) // skip AI illustrations + verification for $0 video
  aiAutoResolved   Boolean @default(false)
  ttsAutoResolved  Boolean @default(false)
  sttProvider      String? // required for imported audio without transcript; 'openai' | 'elevenlabs' | 'together' | 'deepgram' | 'assemblyai'
  sttModel         String? // e.g. 'whisper-1', 'whisper-large-v3-turbo', 'scribe_v1'
  language         String? // ISO 639-1, e.g. 'en', 'es', 'ja'

  // Source tracking
  source        PodcastSource @default(WEB)

  // Visibility
  visibility PodcastVisibility @default(PRIVATE)
  isDelisted Boolean           @default(false)

  // Versioning
  currentVersion Int @default(1)

  // Counters (denormalized for performance)
  playCount Int @default(0)
  saveCount Int @default(0)

  // PDF export
  pdfUrl String?

  // Video generation
  videoUrl String?

  // Waveform visualization
  waveformUrl    String?
  spectrogramUrl String?

  // Import fields
  importedAudioKey     String?
  originalFormat       String?
  transcriptProvided   Boolean @default(false)
  isHumanContent       Boolean @default(false)
  lowReferences        Boolean @default(false)
  verificationProgress Json? // transient progress during reference validation
  sourcePlatform       String? // e.g. "notebooklm", "spotify", "apple_podcasts", "youtube"

  // AI-suggested metadata (for imports where user provided their own)
  suggestedTitle String?
  suggestedTopic String? @db.Text

  // Relations
  user                User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  discovery           Discovery?
  script              Script?
  segments            Segment[]
  interactions        Interaction[]
  saves               Save[]
  tags                PodcastTag[]
  jobs                Job[]
  pipelineEvents      PipelineEvent[]
  references          Reference[]
  versions            PodcastVersion[]
  playbackSessions    PlaybackSession[]
  podcastFeature      PodcastFeature?
  listeningQueues     ListeningQueue[]
  voices              PodcastVoice[]
  videoGenerations    VideoGeneration[]
  audioFingerprint    AudioFingerprint?
  duplicateSource     DuplicateMatch[]   @relation("DuplicateSource")
  duplicateMatches    DuplicateMatch[]   @relation("DuplicateMatch")
  agentIngestion      AgentIngestion?
  landingShowcase     LandingShowcase?
  researchDossier     ResearchDossier?
  creativeOutline     CreativeOutline?
  vocabularyEntries   VocabularyEntry[]
  classSection        ClassSection?
  examSection         ExamSection?
  practiceSession     PracticeSession?

  @@unique([userId, slug])
  @@index([userId])
  @@index([status])
  @@index([visibility])
  @@index([createdAt])
  @@index([playCount])
  @@index([deletedAt])
}

enum PodcastStatus {
  PENDING
  DISCOVERING
  EXTRACTING
  RESEARCHING
  PLANNING
  SCRIPTING
  COMPILING
  SCRIPT_READY
  GENERATING_AUDIO
  STITCHING
  READY
  UPDATING
  FAILED
  IMPORTING
  TRANSCRIBING
  DUPLICATE_REVIEW
}

model ResearchDossier {
  id        String   @id @default(cuid())
  podcastId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mode             String // 'source-bound' | 'curated' | 'open-web'
  userBrief        Json // { topic, audienceLevel, tone, durationTarget, mustCover, mustAvoid, suppliedSourceUrls, discoverySummary }
  sources          Json // SourceRecord[]
  evidence         Json // EvidenceCard[]
  gaps             Json? // string[] — identified knowledge gaps
  blockedClaims    Json? // string[] — claims that couldn't be verified
  recommendedAngle String? @db.Text

  totalInputTokens  Int     @default(0)
  totalOutputTokens Int     @default(0)
  model             String?

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
}

model CreativeOutline {
  id        String   @id @default(cuid())
  podcastId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  drivingQuestion     String @db.Text
  listenerPromise     String @db.Text
  thesis              String @db.Text
  narrativeFramework  String // 'anecdote_reflection' | 'question_cascade' | 'problem_solution' | 'editorial_comedy'
  hook                String @db.Text
  beats               Json // Beat[]
  tensionCurve        Json? // { beatOrder, tension }[]
  bannedAngles        Json? // string[]
  unresolvedQuestions Json? // string[]
  speakerRoles        Json? // { speaker, role }[]

  inputTokens  Int     @default(0)
  outputTokens Int     @default(0)
  model        String?

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
}

enum PodcastVisibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum PodcastSource {
  WEB
  API
  AGENT
  IMPORT
  ADMIN
  CLASS
}

// ============ DISCOVERY (Chat-Based) ============

model Discovery {
  id        String   @id @default(cuid())
  podcastId String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Extracted metadata from chat
  topic          String?  @db.Text
  depth          String? // eli5, quick_overview, standard, deep_dive
  audienceLevel  String? // beginner, intermediate, expert
  audience       String? // kids, teens, family, general, mature
  focusAreas     String[] // array of focus topics
  tone           String? // casual, professional, socratic
  durationTarget Int? // minutes
  speakers       Json? // [{name: "Host", description: "..."}] for multi-voice
  priorKnowledge String?  @db.Text
  sourceUrl      String?
  sourceContent  String?  @db.Text
  sourceMetadata Json?

  // Verification & feasibility
  verificationMode      String  @default("standard") // standard, relaxed
  feasibilityVerdict    String? // proceed, warn, reject
  feasibilitySuggestion String? @db.Text

  // Relations
  podcast  Podcast            @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  messages DiscoveryMessage[]
  user     User               @relation(fields: [userId], references: [id])
  userId   String

  @@index([userId])
}

model AgentIngestion {
  id             String   @id @default(cuid())
  userId         String
  podcastId      String   @unique
  idempotencyKey String?
  provider       String
  agentName      String
  runId          String?
  contentHash    String
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([contentHash])
}

model DiscoveryMessage {
  id          String   @id @default(cuid())
  discoveryId String
  role        String // user, assistant, system
  content     String   @db.Text
  chips       Json? // suggested chip options [{label, value}]
  createdAt   DateTime @default(now())

  discovery Discovery @relation(fields: [discoveryId], references: [id], onDelete: Cascade)

  @@index([discoveryId])
}

model DiscoveryChatError {
  id          String   @id @default(cuid())
  userId      String
  userMessage String   @db.Text
  errorKind   String // 'empty_response' | 'exception' | 'auth_error'
  errorDetail String?  @db.Text
  discoveryId String?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([userId])
}

// ============ SCRIPTS ============

model Script {
  id                   String   @id @default(cuid())
  podcastId            String   @unique
  turns                Json // [{speaker: "HOST"|"EXPERT", text: "..."}]
  soundCues            Json? // [{type, prompt, durationSeconds, insertAfterTurn}]
  markdown             String   @db.Text
  context              String?  @db.Text // source context used for generation
  version              Int      @default(1)
  verificationAttempts Int      @default(0)
  verificationFeedback String?  @db.Text
  verificationClaims   Json? // ClaimAnalysis[] with turnHash — persisted for incremental re-use
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
}

// ============ AUDIO SEGMENTS ============

model Segment {
  id          String  @id @default(cuid())
  podcastId   String
  speaker     String
  text        String  @db.Text
  audioUrl    String?
  order       Int
  startTime   Float? // seconds
  duration    Float? // seconds
  wordTimings Json? // Array<{ word: string; start: number; end: number }>
  version     Int     @default(1)

  ttsProvider String? // Per-segment override: 'elevenlabs' | 'openai' | 'cartesia' | etc.
  ttsModel    String? // Per-segment override: provider-specific model ID
  ttsVoiceId  String? // Per-segment override: specific voice ID

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  podcast            Podcast             @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  segmentVisuals     SegmentVisual[]
  transitionsFrom    SegmentTransition[] @relation("TransitionFrom")
  transitionsTo      SegmentTransition[] @relation("TransitionTo")

  @@index([podcastId])
  @@index([order])
}

// ============ PODCAST VOICE ASSIGNMENTS ============

model PodcastVoice {
  id        String  @id @default(cuid())
  podcastId String
  speaker   String // "Host", "Expert", "Skeptic", etc.
  voiceId   String? // TTS voice ID (pool or clone)
  provider  String? // TTS provider that assigned the voiceId
  podcast   Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([podcastId, speaker])
  @@index([podcastId])
}

// ============ USER VOICE PREFERENCES ============

model UserVoicePreference {
  id        String @id @default(cuid())
  userId    String
  speaker   String
  voiceId   String
  sortOrder Int    @default(0)
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, speaker])
  @@index([userId])
}

// ============ PODCAST VERSIONS ============

model PodcastVersion {
  id            String   @id @default(cuid())
  podcastId     String
  version       Int
  audioUrl      String
  duration      Int?
  changeType    String // 'initial' | 'incorporation' | 'regeneration'
  changeSummary String?  @db.Text
  interactionId String?
  createdAt     DateTime @default(now())

  podcast     Podcast                 @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  interaction Interaction?            @relation(fields: [interactionId], references: [id])
  segments    PodcastVersionSegment[]

  @@unique([podcastId, version])
  @@index([podcastId])
}

model PodcastVersionSegment {
  id         String  @id @default(cuid())
  versionId  String
  segmentId  String
  order      Int
  startTime  Float?
  ttsVoiceId String? // Snapshot of segment's TTS voice ID at version time

  version PodcastVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
}

// ============ INTERACTIONS (Q&A during playback) ============

model Interaction {
  id        String            @id @default(cuid())
  podcastId String
  userId    String
  status    InteractionStatus @default(PENDING)

  // Question context
  question  String @db.Text
  timestamp Float // playback position in seconds

  // Answer
  answer String? @db.Text

  // Resolution
  resolved     Boolean  @default(false)
  incorporated Boolean  @default(false) // baked into podcast
  helpful      Boolean? // null = no feedback, true/false = user response
  segmentOrder Int? // computed by worker: which segment the question maps to

  // Interaction privacy
  visibility String @default("PUBLIC") // PUBLIC or PRIVATE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  podcast  Podcast          @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions PodcastVersion[]

  @@index([podcastId])
  @@index([userId])
  @@index([status])
}

enum InteractionStatus {
  PENDING
  ANSWERING
  ANSWERED
  RESOLVED
  INCORPORATING
  INCORPORATED
}

// ============ SAVES ============

model Save {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([podcastId])
}

// ============ TAGS ============

model Tag {
  id       String  @id @default(cuid())
  name     String  @unique
  slug     String  @unique
  parentId String?

  parent   Tag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children Tag[] @relation("TagHierarchy")

  podcasts      PodcastTag[]
  userInterests UserInterest[]

  @@index([slug])
  @@index([parentId])
}

model PodcastTag {
  id        String @id @default(cuid())
  podcastId String
  tagId     String

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([podcastId, tagId])
  @@index([tagId])
}

// ============ USER INTERESTS ============

model UserInterest {
  id        String   @id @default(cuid())
  userId    String
  tagId     String
  source    String   @default("onboarding") // "onboarding" | "behavioral" | "manual"
  weight    Float    @default(1.0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([userId, tagId])
  @@index([userId])
  @@index([tagId])
}

// ============ TASTE QUIZ ============

model TasteQuizAnswer {
  id         String   @id @default(cuid())
  userId     String
  questionId String
  question   String
  tagSlugs   String[]
  response   String // "yes" | "no" | "skip"
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
}

// ============ NOTIFICATIONS ============

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String           @db.Text
  data      Json?
  read      Boolean          @default(false)
  pushed    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

enum NotificationType {
  PODCAST_READY
  PODCAST_FAILED
  KEY_INVALID
  QUESTION_ON_YOUR_PODCAST
  SCRIPT_READY
  ACCOUNT_WARNING
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
  CONTENT_REMOVED
  PLATFORM_ANNOUNCEMENT
  VOICE_VERIFICATION_REQUIRED
  VOICE_VERIFICATION_PASSED
  VOICE_VERIFICATION_FAILED
  VOICE_BLOCKED_DUPLICATE
  VOICE_OWNERSHIP_ALERT
  PIPELINE_FAILURE
  REFERRAL_SIGNUP
  VIDEO_READY
  VIDEO_FAILED
  AVATAR_FAILED
  AVATAR_IMAGE_REQUEST_RECEIVED
  AVATAR_IMAGE_REQUEST_APPROVED
  AVATAR_IMAGE_REQUEST_DENIED
  AVATAR_IMAGE_REQUEST_REVOKED
}

// ============ MODERATION ============

model ModerationAction {
  id          String   @id @default(cuid())
  userId      String
  moderatorId String
  action      String // 'warn' | 'suspend' | 'ban' | 'unban' | 'unsuspend' | 'remove_content'
  reason      String   @db.Text
  metadata    Json?
  createdAt   DateTime @default(now())

  user      User @relation("ModeratedUser", fields: [userId], references: [id], onDelete: Cascade)
  moderator User @relation("Moderator", fields: [moderatorId], references: [id])

  @@index([userId, createdAt])
}

// ============ PUSH SUBSCRIPTIONS ============

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ EXPO PUSH TOKENS (mobile) ============

model ExpoPushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String // "ios" | "android"
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ============ JOBS (BullMQ tracking) ============

model Job {
  id        String   @id @default(cuid())
  podcastId String?
  type      String
  payload   Json
  status    String // pending, processing, complete, failed
  result    Json?
  error     String?
  attempts  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  podcast Podcast? @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([type, status])
  @@index([podcastId])
  @@index([status])
  @@index([createdAt])
}

// ============ PIPELINE EVENTS ============

model PipelineEvent {
  id        String   @id @default(cuid())
  podcastId String
  createdAt DateTime @default(now())
  stage     String // queue name: 'audio-generation', 'script-verification', etc.
  type      String // 'error' | 'warning' | 'retry' | 'complete'
  message   String   @db.Text
  metadata  Json? // { segmentId?, jobId?, attemptNumber?, errorKind? }

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([podcastId, createdAt])
  @@index([type, createdAt])
}

// ============ API USAGE TRACKING ============

model ApiUsageLog {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  podcastId String?
  userId    String?
  service   String // anthropic, openai, elevenlabs, etc.
  modelId   String? // e.g. 'claude-sonnet-4-5-20250929', 'whisper-1', 'eleven_v3'
  category  String // discovery, script_generation, audio_generation, interaction

  // Cost tracking
  inputTokens  Int?
  outputTokens Int?
  totalCost    Float

  // Performance
  durationMs Int?

  metadata Json @default("{}")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([podcastId])
  @@index([userId])
  @@index([createdAt])
  @@index([service])
  @@index([modelId])
}

// ============ FEEDBACK (Early Access) ============

model Feedback {
  id        String         @id @default(cuid())
  userId    String?
  email     String?
  name      String?
  type      FeedbackType
  rating    Int? // 1-5 stars
  subject   String
  message   String         @db.Text
  context   String? // page/feature where feedback was given
  status    FeedbackStatus @default(NEW)
  response  String?        @db.Text // admin response
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdAt])
}

enum FeedbackType {
  BUG
  FEATURE_REQUEST
  GENERAL
  PRAISE
  CONCERN
}

enum FeedbackStatus {
  NEW
  REVIEWED
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

// ============ BEHAVIORAL / ML FEATURE STORE (analytics) ============

model ListeningQueue {
  id        String   @id @default(cuid())
  userId    String
  podcastId String
  position  Int
  addedAt   DateTime @default(now())
  source    String // picks, explore, search

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([userId, podcastId])
  @@index([userId, position])
}

// ============ ML FEATURE STORE ============

model UserFeature {
  id     String @id @default(cuid())
  userId String @unique

  // Engagement
  totalListenMinutes    Float @default(0)
  totalPodcastsListened Int   @default(0)
  avgCompletionRate     Float @default(0)
  avgListenSpeed        Float @default(1)

  // Abandonment
  avgAbandonPercent Float @default(0)
  optimalDuration   Float @default(10) // minutes where highest completion

  // Preferences (inferred from behavior)
  preferredDepth         String? // eli5, quick_overview, standard, deep_dive
  preferredTone          String? // casual, professional, socratic
  preferredAudienceLevel String? // beginner, intermediate, expert
  preferredDuration      Float? // minutes

  // Affinities
  topicAffinity Json? // [{tagId, weight}]
  voiceAffinity Json? // [{voiceId, completionRate}]

  // Private activity
  interactionRate Float @default(0)
  creatorLoyalty  Float @default(0)

  // Behavioral
  archetype           String? // deep_listener, skimmer, explorer, completer, active_learner
  speakerPreference   Float   @default(0) // -1 to 1
  noveltyResponseRate Float   @default(0)

  // Temporal
  peakListeningHours   Json? // [{hour, listenMinutes}]
  postListenBehavior   Json? // {saved: pct, asked: pct, rated: pct, ...}
  topicProgressionPath Json? // [{topic, depth, timestamp}]

  // Recency
  daysSinceLastListen Float @default(0)
  listenFrequency     Float @default(0)

  // Vector (pgvector)
  embedding Unsupported("vector(384)")?

  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([archetype])
}

model PodcastFeature {
  id        String @id @default(cuid())
  podcastId String @unique

  // Quality
  avgCompletionRate    Float @default(0)
  medianCompletionRate Float @default(0)
  totalUniqueListeners Int   @default(0)
  totalListenMinutes   Float @default(0)

  // Private activity
  saveToListenRatio Float @default(0)
  interactionRate   Float @default(0)

  // Abandonment
  abandonmentCurve        Json? // [{percentBucket, abandonRate}] in 5% increments
  segmentAbandonRates     Json? // [{segmentOrder, speaker, abandonRate}]
  questionThenAbandonRate Float @default(0)

  // Playback
  avgListenSpeed    Float @default(1)
  speedDistribution Json? // {1x: pct, 1.25x: pct, ...}
  dropoffPoints     Json? // [{position, dropoffRate}]
  seekHotspots      Json? // [{position, seekCount}]

  // Re-engagement
  relistenRate Float @default(0)

  // Content
  segmentCount              Int   @default(0)
  durationSeconds           Int   @default(0)
  referenceCount            Int   @default(0)
  verifiedReferenceRate     Float @default(0)
  questionDensityByPosition Json? // [{percentBucket, questionsPerListener}]

  // Vector (pgvector)
  embedding Unsupported("vector(384)")?

  podcast    Podcast  @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  computedAt DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([podcastId])
  @@index([avgCompletionRate])
}

// ============ BEHAVIORAL EVENTS (ML Data Pipeline) ============

model BehavioralEvent {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  userId    String?
  sessionId String
  eventType String // e.g. playback.play, feed.impression
  eventData Json // event-specific payload

  podcastId  String?
  pageUrl    String?   @db.Text
  deviceType String?
  userAgent  String?   @db.VarChar(512)
  referrer   String?   @db.Text
  clientTs   DateTime?

  @@index([userId, eventType, createdAt])
  @@index([podcastId, eventType, createdAt])
  @@index([sessionId, createdAt])
  @@index([eventType, createdAt])
  @@index([createdAt])
}

model UserSession {
  id         String   @id @default(cuid())
  sessionId  String   @unique
  userId     String?
  startedAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  deviceType String?
  userAgent  String? @db.VarChar(512)
  ipHash     String? @db.VarChar(64) // SHA-256 of IP, never raw
  country    String? @db.VarChar(2) // ISO 3166-1 alpha-2 (e.g. "US")
  referrer   String? @db.Text
  pageCount  Int     @default(1)

  @@index([userId, startedAt])
  @@index([sessionId])
  @@index([country])
}

model PlaybackSession {
  id        String    @id @default(cuid())
  userId    String?
  sessionId String
  podcastId String
  startedAt DateTime  @default(now())
  endedAt   DateTime?

  // Aggregates
  totalListenSeconds Float @default(0)
  maxPosition        Float @default(0)
  completionPercent  Float @default(0)

  // Behavior
  pauseCount     Int   @default(0)
  seekCount      Int   @default(0)
  speedChanges   Int   @default(0)
  lastSpeed      Float @default(1)
  interruptCount Int   @default(0)

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([userId, podcastId])
  @@index([podcastId, startedAt])
  @@index([userId, startedAt])
}

// ============ WAITLIST ============

enum WaitlistStatus {
  PENDING
  APPROVED
  REJECTED
}

model Waitlist {
  id            String         @id @default(cuid())
  email         String         @unique
  source        String?
  wishlist      String?
  referralCode  String?
  status        WaitlistStatus @default(PENDING)
  unsubscribed  Boolean        @default(false)
  approvedAt    DateTime?
  approvedBy    String?
  signedUpAt    DateTime?
  createdAt     DateTime       @default(now())

  @@index([createdAt])
  @@index([status])
}

// ============ INVITATION LINKS ============

model InvitationLink {
  id        String    @id @default(cuid())
  code      String    @unique
  createdBy String
  email     String?
  enabled   Boolean   @default(true)
  usedAt    DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())

  creator User @relation("InvitationLinksCreated", fields: [createdBy], references: [id])

  @@index([code])
  @@index([createdBy])
}

// ============ API KEYS ============

model ApiKey {
  id         String    @id @default(cuid())
  userId     String
  name       String
  keyHash    String    @unique
  keyPrefix  String // first 16 chars for display (sk_sotto_XXXX...)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyHash])
}

// ============ DEVICE PAIRING ============

// Short-lived, single-use "scan to connect" token. The QR a learner shows on the
// server renders {serverUrl, token}; a phone/tablet redeems it for a long-lived
// ApiKey. Only the hash is stored — the raw token lives in the QR for a few minutes.
model PairingToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  name      String    @default("Paired device")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
}

// ============ VOICE CLONES ============

model VoiceClone {
  id                 String                  @id @default(cuid())
  userId             String
  name               String
  provider           String                  @default("elevenlabs")
  externalVoiceId    String
  sourceType         VoiceCloneSource
  sampleUrl          String?
  description        String?                 @db.VarChar(200)
  verificationStatus VoiceVerificationStatus @default(PENDING_VERIFICATION)
  createdAt          DateTime                @default(now())

  user                   User                         @relation(fields: [userId], references: [id], onDelete: Cascade)
  fingerprint            VoiceFingerprint?
  verificationChallenges VoiceVerificationChallenge[]
  similarityMatchesAs    VoiceSimilarityMatch[]       @relation("MatchedVoice")
  blockedMatchesAs       VoiceSimilarityMatch[]       @relation("BlockedVoice")

  @@unique([userId, provider, externalVoiceId])
  @@index([userId])
  @@index([verificationStatus])
}

enum VoiceCloneSource {
  UPLOAD
  RECORD
  IMPORT
}

enum VoiceVerificationStatus {
  PENDING_VERIFICATION
  AWAITING_CHALLENGE
  CHALLENGE_SUBMITTED
  VERIFIED
  BLOCKED
  REJECTED
  ADMIN_VERIFIED
  ADMIN_BLOCKED
  PROTECTED
}

// ============ VOICE FINGERPRINTS ============

model VoiceFingerprint {
  id           String   @id @default(cuid())
  voiceCloneId String   @unique
  embedding    Float[]
  modelVersion String
  audioUrl     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  voiceClone VoiceClone @relation(fields: [voiceCloneId], references: [id], onDelete: Cascade)
}

// ============ VOICE VERIFICATION CHALLENGES ============

model VoiceVerificationChallenge {
  id            String   @id @default(cuid())
  voiceCloneId  String
  phrase        String
  recordingUrl  String?
  similarity    Float?
  passed        Boolean?
  attemptNumber Int
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  voiceClone VoiceClone @relation(fields: [voiceCloneId], references: [id], onDelete: Cascade)

  @@index([voiceCloneId])
}

// ============ VOICE SIMILARITY MATCHES ============

model VoiceSimilarityMatch {
  id             String   @id @default(cuid())
  matchedVoiceId String
  blockedVoiceId String
  similarity     Float
  resolvedBy     String?
  resolution     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  matchedVoice VoiceClone @relation("MatchedVoice", fields: [matchedVoiceId], references: [id], onDelete: Cascade)
  blockedVoice VoiceClone @relation("BlockedVoice", fields: [blockedVoiceId], references: [id], onDelete: Cascade)

  @@index([matchedVoiceId])
  @@index([blockedVoiceId])
}

// ============ REFERENCES (Citations) ============

model Reference {
  id        String        @id @default(cuid())
  podcastId String
  number    Int
  title     String        @db.Text
  authors   String[]
  year      Int?
  url       String?       @db.Text
  type      ReferenceType @default(WEB)
  publisher String?
  doi       String?
  createdAt DateTime      @default(now())

  // Verification
  verificationStatus  VerificationStatus @default(PENDING)
  verificationDetails Json?
  originalTitle       String?            @db.Text
  contentDomain       String? // 'ACADEMIC' | 'NEWS' | 'GOVERNMENT' | 'EDUCATIONAL' | 'GENERAL'

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([podcastId, number])
  @@index([podcastId])
}

model VocabularyEntry {
  id              String   @id @default(cuid())
  podcastId       String
  number          Int // [V1], [V2] marker index, 1-based
  word            String // target language word/phrase
  translation     String // native language translation
  partOfSpeech    String? // noun, verb, adjective, etc.
  pronunciation   String? // phonetic guide (e.g. "SHPREE-chen")
  exampleSentence String?  @db.Text // usage in context
  difficulty      String? // beginner, intermediate, advanced
  createdAt       DateTime @default(now())

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@unique([podcastId, number])
  @@index([podcastId])
}

enum ReferenceType {
  WEB
  PAPER
  BOOK
  ARTICLE
  VIDEO
  REPORT
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  REPLACED
  REMOVED
}

// ============ RESERVED HANDLES ============

model ReservedHandle {
  id        String   @id @default(cuid())
  handle    String   @unique
  reason    String?
  createdBy String?
  createdAt DateTime @default(now())
}

// ============ USER TTS KEYS (Multi-Provider BYOK) ============

model UserTtsKey {
  id           String    @id @default(cuid())
  userId       String
  provider     String // 'elevenlabs' | 'openai' | 'cartesia' | 'hume' | 'fal' | 'replicate'
  encryptedKey String    @db.Text
  extraData    String?   @db.Text // encrypted JSON for multi-field auth
  isValid      Boolean   @default(true)
  label        String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// ============ USER AI KEYS (LLM BYOK) ============

model UserAiKey {
  id           String    @id @default(cuid())
  userId       String
  provider     String // 'anthropic' | 'openai'
  encryptedKey String    @db.Text
  isValid      Boolean   @default(true)
  label        String?
  lastUsedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
  @@index([userId])
}

// ============ AUTO MODEL CONFIG ============

model AutoModelConfig {
  id                  String   @id @default("singleton")
  aiProvider          String   @default("anthropic")
  aiModel             String   @default("claude-haiku-4-5-20251001")
  ttsProvider         String   @default("openai")
  ttsModel            String   @default("tts-1-hd")
  sttProvider         String   @default("openai")
  sttModel            String   @default("whisper-large-v3-turbo")
  platformAiProvider  String   @default("anthropic")
  platformAiModel     String   @default("claude-haiku-4-5-20251001")
  includedModels      Json?
  includedTtsModels   Json?
  includedSttModels   Json?
  // Image (still images for video visuals)
  imageProvider       String   @default("fal")
  imageModel          String   @default("fal-flux-1-schnell")
  includedImageModels Json?
  // Video (text-to-video)
  videoProvider       String   @default("fal")
  videoModel          String   @default("fal-wan2.5-480p")
  includedVideoModels Json?
  // Avatar (lip-sync avatar overlays)
  avatarProvider      String   @default("heygen")
  avatarModel         String   @default("heygen-avatar-standard")
  includedAvatarModels Json?
  // Motion (programmatic visual rendering)
  motionProvider      String   @default("remotion")
  updatedAt           DateTime @updatedAt
  updatedBy           String?
}

// ============ SITE CONFIG ============

model SiteConfig {
  id         String   @id @default("singleton")
  openSignup Boolean  @default(false)

  // Local profile sign-in (the Netflix-style picker). When true, the Credentials
  // provider is active and the profile picker is the primary sign-in. Owner-set.
  // null means "use the default": on for self-hosted instances with no ADMIN_EMAILS.
  localAuth Boolean?

  // Owner-set server infrastructure (non-secret selection only; null = fall back to env).
  // Secrets (provider keys, R2/S3 credentials) never live here — they stay in env or the
  // encrypted BYOK store. Set by the owner through the onboarding wizard.
  aiProvider      String?
  aiModel         String?
  aiBaseUrl       String?
  sttProvider     String?
  sttBaseUrl      String?
  sttModel        String?
  ttsProvider     String?
  ttsBaseUrl      String?
  storageProvider String?
  s3Bucket        String?
  s3Region        String?

  updatedAt DateTime @updatedAt
  updatedBy String?
}

// ============ LANDING SHOWCASE CONFIG (Admin Dashboard) ============

model LandingShowcase {
  id        String @id @default("singleton")
  podcastId String @unique

  // JourneyChapter Step 2 — Script excerpt range
  scriptTurnStart Int @default(0)
  scriptTurnCount Int @default(2)

  // JourneyChapter Step 3 — Audio clip range (seconds)
  audioClipStart Float  @default(0)
  audioClipEnd   Float? // null = 30s from start

  // ShowcaseChapter — Video segment range
  videoSegmentStart Int @default(0)
  videoSegmentCount Int @default(4)

  // Feature toggles — controls whether landing page shows interactive toggles
  showAvatar Boolean @default(false)
  showVideo  Boolean @default(false)

  updatedAt DateTime @updatedAt
  updatedBy String?

  podcast Podcast @relation(fields: [podcastId], references: [id])

  @@index([podcastId])
}

// ============ REPORTS ============

enum ReportReason {
  HARASSMENT
  HATE_SPEECH
  VIOLENCE
  SEXUAL_CONTENT
  MISINFORMATION
  SPAM
  IMPERSONATION
  COPYRIGHT
  VOICE_THEFT
  MUSIC_UPLOAD
  FALSE_HUMAN_BADGE
  FALSE_CLAIM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWING
  RESOLVED_ACTIONED
  RESOLVED_DISMISSED
  ASSET_REPLACED
  DELISTED
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  targetType  String // 'podcast' | 'comment' | 'user'
  targetId    String
  reason      ReportReason
  description String?      @db.Text
  status      ReportStatus @default(PENDING)
  resolvedBy  String?
  resolution  String?      @db.Text
  resolvedAt  DateTime?
  createdAt   DateTime     @default(now())

  // Copyright claim fields (used when reason = COPYRIGHT)
  claimantEmail   String?
  claimantName    String?
  evidenceUrl     String?
  segmentVisualId String?
  counterNotice   String? @db.Text

  reporter      User           @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  segmentVisual SegmentVisual? @relation(fields: [segmentVisualId], references: [id], onDelete: SetNull)

  @@unique([reporterId, targetType, targetId])
  @@index([status, createdAt])
  @@index([targetType, targetId])
}

// ============ AUDIO FINGERPRINTING & DUPLICATE DETECTION ============

model AudioFingerprint {
  id          String   @id @default(cuid())
  podcastId   String   @unique
  fingerprint Int[]
  duration    Int // seconds
  createdAt   DateTime @default(now())

  podcast Podcast @relation(fields: [podcastId], references: [id], onDelete: Cascade)

  @@index([duration])
}

enum DuplicateMatchStatus {
  PENDING
  APPROVED
  REJECTED
}

model DuplicateMatch {
  id               String               @id @default(cuid())
  sourcePodcastId  String
  matchedPodcastId String
  similarity       Float
  status           DuplicateMatchStatus @default(PENDING)
  reviewedBy       String?
  resolution       String?              @db.Text
  reviewedAt       DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  sourcePodcast  Podcast @relation("DuplicateSource", fields: [sourcePodcastId], references: [id], onDelete: Cascade)
  matchedPodcast Podcast @relation("DuplicateMatch", fields: [matchedPodcastId], references: [id], onDelete: Cascade)

  @@unique([sourcePodcastId, matchedPodcastId])
  @@index([status])
}

// ============ R2 USAGE MONITORING ============

model R2UsageSnapshot {
  id                  String   @id @default(cuid())
  bucket              String
  payloadSizeBytes    Float
  metadataSizeBytes   Float
  objectCount         Int
  uploadCount         Int
  classAOps           Int      @default(0)
  classBOps           Int      @default(0)
  freeOps             Int      @default(0)
  storageCostEstimate Float    @default(0)
  classACostEstimate  Float    @default(0)
  classBCostEstimate  Float    @default(0)
  totalCostEstimate   Float    @default(0)
  prefixBreakdown     Json?
  createdAt           DateTime @default(now())

  @@index([createdAt])
  @@index([bucket, createdAt])
}

// ============ MODEL PRICING SNAPSHOTS ============

model ModelPricingSnapshot {
  id              String   @id @default(cuid())
  modelId         String
  provider        String
  inputPerMTok    Float
  outputPerMTok   Float
  contextWindow   Int?
  maxOutputTokens Int?
  source          String   @default("registry") // "registry" | "fetched" | "admin"
  createdAt       DateTime @default(now())

  @@index([modelId, createdAt])
  @@index([createdAt])
}

// ============ VIDEO GENERATION ============

model VideoGeneration {
  id             String      @id @default(cuid())
  podcastId      String
  status         VideoStatus @default(PENDING)
  videoUrl       String?
  duration       Int? // seconds
  fileSize       Int? // bytes
  width          Int         @default(1280)
  height         Int         @default(720)
  imageProvider  String? // null = auto (fal)
  imageModel     String? // e.g. 'fal-flux-2-pro', 'fal-recraft-v3'
  videoModel     String? // e.g. 'fal-veo3-1080p', 'fal-kling3-1080p'
  pipelineJson   Json? // Approved pipeline editor state
  avatarsVisible Boolean     @default(true)
  zeroCostVideo  Boolean     @default(false) // no AI illustrations, free visuals only
  failureReason  String?     @db.Text
  technicalError String?     @db.Text
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  podcast        Podcast             @relation(fields: [podcastId], references: [id], onDelete: Cascade)
  visuals        SegmentVisual[]
  avatarOverlays AvatarOverlay[]
  transitions    SegmentTransition[]

  @@index([podcastId])
}

model SegmentTransition {
  id                String  @id @default(cuid())
  videoGenerationId String
  fromSegmentId     String
  toSegmentId       String
  fromSegmentOrder  Int
  toSegmentOrder    Int
  transitionModel   String? // pricetoken model ID (FLF2V-capable video model)
  prompt            String? @db.Text
  assetUrl          String?
  assetType         String? // 'video/mp4'
  status            String  @default("pending") // pending | generating | ready | failed
  failureReason     String? @db.Text
  cost              Float?
  recommended       Boolean @default(false)
  enabled           Boolean @default(true)
  durationSeconds   Float   @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  videoGeneration VideoGeneration @relation(fields: [videoGenerationId], references: [id], onDelete: Cascade)
  fromSegment     Segment         @relation("TransitionFrom", fields: [fromSegmentId], references: [id], onDelete: Cascade)
  toSegment       Segment         @relation("TransitionTo", fields: [toSegmentId], references: [id], onDelete: Cascade)

  @@unique([videoGenerationId, fromSegmentId, toSegmentId])
  @@index([videoGenerationId])
}

model SegmentVisual {
  id                String     @id @default(cuid())
  videoGenerationId String
  segmentId         String
  order             Int
  subOrder          Int        @default(0) // ordering within parent segment (0, 1, 2...)
  startOffset       Float      @default(0) // seconds from parent segment start
  subDuration       Float? // seconds; null = full segment duration
  visualType        VisualType
  prompt            String?    @db.Text
  metadata          Json? // type-specific: chart data, quote text, timeline events, etc.
  visualMode        String? // 'image' | 'video' | 'programmatic'
  videoModel        String? // pricetoken model ID for video mode
  endStatePrompt    String?    @db.Text
  firstFrameUrl     String?
  lastFrameUrl      String?
  assetUrl          String? // R2 URL of generated image/video
  assetType         String? // 'image/png' | 'video/mp4'
  motionProvider    String? // 'remotion' | 'hera' — which motion provider rendered this visual
  status            String     @default("pending") // pending | generating | ready | failed
  failureReason     String?    @db.Text
  previewUrl        String? // R2 URL of per-segment preview MP4
  previewStatus     String? // pending | rendering | ready | failed
  previewQuality    String? // 'preview' | 'full'
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  videoGeneration VideoGeneration @relation(fields: [videoGenerationId], references: [id], onDelete: Cascade)
  segment         Segment         @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  reports         Report[]

  @@index([videoGenerationId])
  @@index([segmentId])
  @@index([segmentId, subOrder])
}

model AvatarOverlay {
  id                   String   @id @default(cuid())
  videoGenerationId    String
  speaker              String
  avatarId             String
  avatarName           String?
  previewImageUrl      String?
  heygenVideoId        String?
  videoUrl             String?
  concatAudioUrl       String?
  status               String   @default("pending")
  failureReason        String?  @db.Text
  durationSeconds      Float?
  avatarProvider       String?
  avatarImageUrl       String?
  avatarModelId        String?
  falRequestId         String?
  falChunkIndex        Int?
  falTotalChunks       Int?
  maskShape            String?
  runwaySessionId      String?
  runwayChunkIndex     Int?
  runwayTotalChunks    Int?
  chunkVideoUrl        String?
  chunkDurationSeconds Float?
  enabledSegmentIds    String[] @default([])
  posX                 Float    @default(0.02)
  posY                 Float    @default(0.55)
  width                Float    @default(0.25)
  height               Float    @default(0.35)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  videoGeneration VideoGeneration @relation(fields: [videoGenerationId], references: [id], onDelete: Cascade)

  @@unique([videoGenerationId, speaker])
  @@index([videoGenerationId])
}

enum AvatarImageSource {
  UPLOAD
  GENERATED
  DEFAULT
}

model AvatarImage {
  id                    String            @id @default(cuid())
  userId                String
  user                  User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  imageUrl              String
  sourceType            AvatarImageSource
  prompt                String?           @db.Text
  consentAcknowledgedAt DateTime?
  shareable             Boolean           @default(false)
  createdAt             DateTime          @default(now())

  shares AvatarImageShare[]

  @@unique([userId, name])
  @@index([userId])
}

enum AvatarImageShareStatus {
  PENDING
  APPROVED
  DENIED
  REVOKED
}

model AvatarImageShare {
  id            String                 @id @default(cuid())
  requesterId   String
  imageOwnerId  String
  avatarImageId String
  status        AvatarImageShareStatus @default(PENDING)
  message       String?                @db.Text
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  requester   User        @relation("AvatarShareRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  imageOwner  User        @relation("AvatarShareOwner", fields: [imageOwnerId], references: [id], onDelete: Cascade)
  avatarImage AvatarImage @relation(fields: [avatarImageId], references: [id], onDelete: Cascade)

  @@unique([requesterId, avatarImageId])
  @@index([imageOwnerId])
  @@index([status])
}

// ============ DEMO VIDEO STUDIO ============

enum DemoProjectStatus {
  DRAFT
  SCRIPT_READY
  GENERATING_ASSETS
  COMPOSING
  READY
  FAILED
}

enum DemoSceneAssetStatus {
  PENDING
  GENERATING
  READY
  FAILED
}

model DemoProject {
  id           String            @id @default(cuid())
  userId       String
  user         User              @relation(fields: [userId], references: [id])
  title        String
  description  String?
  features     String[] // feature slugs to demonstrate
  aiModel      String? // AI model for script generation (e.g. "claude-sonnet-4-20250514")
  status       DemoProjectStatus @default(DRAFT)
  failedReason String?
  videoUrl     String? // final composed video
  audioUrl     String? // final stitched voiceover

  // Default TTS config — applied to all new scenes
  defaultTtsProvider String?
  defaultTtsModel    String?
  defaultTtsVoiceId  String?

  // TTS providers to showcase — voice comparison baked into the creation flow
  showcaseProviders String[]

  // Launch video fields
  backgroundMusicUrl    String?
  backgroundMusicVolume Float?
  podcastId             String? // links to the podcast being showcased
  avatarClipUrl         String? // pre-generated avatar clip R2 URL

  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  scenes    DemoScene[]

  @@index([userId])
}

model DemoScene {
  id        String      @id @default(cuid())
  projectId String
  project   DemoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  order     Int // 0-indexed scene order
  title     String // "User creates a podcast"
  narration String // voiceover text for this scene
  actions   Json // DemoAction[] — browser automation steps
  duration  Float? // estimated duration in seconds

  // Independent asset URLs — each generated separately
  recordingUrl     String?
  recordingStatus  DemoSceneAssetStatus @default(PENDING)
  voiceoverUrl     String?
  voiceoverStatus  DemoSceneAssetStatus @default(PENDING)
  visualUrl        String?
  visualStatus     DemoSceneAssetStatus @default(PENDING)
  visualType       String? // 'ai_image' | 'ai_video' | 'map' | null
  visualPrompt     String? // editable prompt for AI visual
  compositedUrl    String? // scene-level composite (recording + voiceover + visual)
  compositedStatus DemoSceneAssetStatus @default(PENDING)
  failedReason     String? // last error message from any asset worker

  // Timing — speed zones within the recording
  // TimingSegment[]: [{ start: 0, end: 5, speed: 1 }, { start: 5, end: 25, speed: 8 }, ...]
  // speed: 0 = skip/cut, null = play entire recording at 1x
  timingSegments Json?

  // TTS config per scene (admin picks voice)
  ttsProvider String?
  ttsModel    String?
  ttsVoiceId  String?

  // Transition to next scene
  transitionType   String? // 'fade' | 'dissolve' | 'wipe' | null
  transitionUrl    String? // generated transition clip
  transitionStatus DemoSceneAssetStatus @default(PENDING)

  // Launch video cinematic fields
  sfxConfig       Json? // SceneSfxConfig
  providerBanner  Json? // ProviderBannerConfig
  avatarConfig    Json? // AvatarConfig
  overlays        Json? // TextOverlayConfig[]
  subtitles       Json? // SubtitleConfig
  actionTimingLog Json? // ActionTimingEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, order])
}

model ShowcaseSet {
  id        String   @id @default(cuid())
  name      String
  items     Json // Array of ShowcaseItem: { visualType, label, description, url, mediaType, credits? }
  active    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============ LANGUAGE LEARNING — CURRICULUM ============

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

// The learner's chosen teaching approach, grounded in second-language-acquisition
// research. Shapes how content is generated so a learner can switch methods if one
// is not working for them. See lib/pedagogy.ts for the evidence behind each.
enum PedagogyStyle {
  BALANCED // mix of comprehensible input, form-focus, and retrieval practice
  IMMERSION // comprehensible input (Krashen i+1), target-language-first
  GRAMMAR // explicit, form-focused instruction
  COMMUNICATION // communicative output (Swain), fluency-first
  INTENSIVE // retrieval practice + spaced repetition (the testing effect)
}

// Global curriculum: one per native→target language pair.
// source: 'seeded' = hand-authored JSON; 'generated' = agent-composed on demand.
model Curriculum {
  id         String   @id @default(cuid())
  nativeLang String // ISO 639-1, e.g. "en"
  targetLang String // ISO 639-1, e.g. "de"
  title      String
  version    Int      @default(1)
  source     String   @default("seeded") // "seeded" | "generated"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  lessons Lesson[]
  courses Course[]

  @@unique([nativeLang, targetLang])
}

// A node in the fixed lesson tree. Ordering + competencies are fixed; class
// instances generated from a lesson adapt to the learner's weak items.
model Lesson {
  id            String    @id @default(cuid())
  curriculumId  String
  level         CefrLevel
  order         Int // global gate ordering within the curriculum
  parentId      String? // tree: unit -> lesson; null = top-level unit
  slug          String // stable key, e.g. "a1-greetings"
  title         String
  objective     String    @db.Text
  grammarPoints Json // string[] of grammar topic keys, e.g. ["present-tense-sein"]
  vocabThemes   Json // string[] themes, e.g. ["greetings","numbers-1-20"]
  targetVocab   Json // [{ lemma, gloss, pos? }]
  canDoSummary  String?   @db.Text // CEFR can-do statement
  estMinutes    Int       @default(60)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  curriculum Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  parent     Lesson?    @relation("LessonTree", fields: [parentId], references: [id], onDelete: SetNull)
  children   Lesson[]      @relation("LessonTree")
  classes    CourseClass[]

  @@unique([curriculumId, slug])
  @@unique([curriculumId, order])
  @@index([curriculumId, level, order])
  @@index([parentId])
}

// A learner's enrollment in one language pair. CEFR level lives here (a user
// can hold several courses at several levels).
model Course {
  id            String    @id @default(cuid())
  userId        String
  nativeLang    String
  targetLang    String
  curriculumId  String
  currentLevel  CefrLevel @default(A1) // "you are here"; assigned by placement, advances with mastery
  startLevel    CefrLevel @default(A1) // immutable placement result
  pedagogy      PedagogyStyle @default(BALANCED) // teaching approach; shapes generation
  activeClassId String? // current in-flight class (gating convenience cache)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  curriculum       Curriculum        @relation(fields: [curriculumId], references: [id])
  placement        PlacementResult?
  classes          CourseClass[]
  vocab            LearnerVocab[]
  grammar          LearnerGrammar[]
  vocabEdges       VocabEdge[]
  practiceSessions PracticeSession[]
  note             CourseNote?
  mockExams        MockExam[]

  @@unique([userId, nativeLang, targetLang]) // one course per user per language pair
  @@index([userId])
  @@index([curriculumId])
}

// Snapshot of the adaptive placement test that assigned a course's start level.
model PlacementResult {
  id           String    @id @default(cuid())
  courseId     String    @unique
  level        CefrLevel
  responses    Json // [{ questionId, skill, cefr, selectedIndex, correct }]
  scoreBySkill Json // { grammar, vocab, listening } -> 0..1
  model        String?
  provider     String?
  createdAt    DateTime  @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}

// ============ LANGUAGE LEARNING — CLASSES ============

enum SkillType {
  GRAMMAR
  READING
  LISTENING
  SPEAKING
  WRITING
}

enum ClassStatus {
  LOCKED
  GENERATING
  AVAILABLE
  IN_PROGRESS
  SUBMITTED
  PASSED
  FAILED
}

enum SectionStatus {
  PENDING
  GENERATING
  READY
  IN_PROGRESS
  SUBMITTED
  PASSED
  FAILED
}

// Single-skill practice. VOCAB is first-class here (spaced-repetition recall)
// and is deliberately NOT in SkillType, which gates the four class sections.
enum PracticeKind {
  GRAMMAR
  READING
  LISTENING
  SPEAKING
  WRITING
  VOCAB
}

enum PracticeStatus {
  ACTIVE
  COMPLETED
}

// A ~1h class instantiated from a Lesson for a specific course. Mastery-gated:
// the next class only unlocks once this one is PASSED.
model CourseClass {
  id              String      @id @default(cuid())
  courseId        String
  lessonId        String
  order           Int // mirrors Lesson.order; stable user-facing sequence
  status          ClassStatus @default(LOCKED)
  attempt         Int         @default(1) // whole-class retry counter
  adaptiveSeed    Json? // { vocabIds, grammarKeys, dueCount } that seeded this class
  passThreshold   Float       @default(0.7) // fraction of sections that must pass
  worksheetPdfUrl String?
  sourceUrl       String? // sourced class: the real article/paper/link it was built from (null = curriculum class)
  sourceTitle     String? // human-readable source title for display
  submittedAt     DateTime?
  passedAt        DateTime?
  failedAt        DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  course     Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson     Lesson           @relation(fields: [lessonId], references: [id])
  sections   ClassSection[]
  submission ClassSubmission?
  inkLayers  ClassInkLayer[]

  @@index([courseId, order])
  @@index([courseId, status])
  @@index([lessonId])
}

// Learner's iPad PencilKit ink for one worksheet surface. Stored verbatim,
// never graded, never sent to an LLM.
model ClassInkLayer {
  id        String   @id @default(cuid())
  classId   String
  surface   String // worksheet surface/page the strokes belong to
  strokes   String   @db.Text // base64-encoded PKDrawing
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, surface])
  @@index([classId])
}

// One skill section per (re)attempt. Failed-section regeneration = a new row
// with attempt+1 and a new seed; the latest attempt per (class, skill) is active.
model ClassSection {
  id            String        @id @default(cuid())
  classId       String
  skill         SkillType
  attempt       Int           @default(1)
  status        SectionStatus @default(PENDING)
  seed          String // variation token; changes on retry -> similar-but-not-identical
  spec          Json // resolved generation spec (objective + adaptive items used)
  score         Float?
  passed        Boolean?
  passThreshold Float         @default(0.7)
  podcastId     String?       @unique // LISTENING section -> reuse Podcast; @unique because one section per podcast
  generatedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  class         CourseClass      @relation(fields: [classId], references: [id], onDelete: Cascade)
  podcast       Podcast?         @relation(fields: [podcastId], references: [id], onDelete: SetNull)
  questions     LessonQuestion[]
  prompts       SpeakingPrompt[]
  writingPrompts WritingPrompt[]

  @@index([classId, skill, attempt])
}

// MC question for a GRAMMAR/READING/LISTENING section. Forked from the old
// post-listen quiz question shape, but supports retries and has no podcast.
model LessonQuestion {
  id           String   @id @default(cuid())
  sectionId    String
  order        Int
  skill        SkillType
  question     String   @db.Text
  options      Json // ["A","B","C","D"]
  correctIndex Int
  explanation  String   @db.Text
  vocabIds     String[] @default([]) // memory-graph linkage (later phases)
  grammarKeys  String[] @default([])
  passageRef   String?  @db.Text // short label/anchor for the passage or listening turn
  passageText  String?  @db.Text // the actual reading passage (sourced classes: a CEFR-leveled excerpt with [N] citations)
  createdAt    DateTime @default(now())

  section ClassSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, order])
  @@index([sectionId])
}

// One submission per class attempt; aggregates the graded MC answers.
model ClassSubmission {
  id           String   @id @default(cuid())
  classId      String   @unique
  userId       String
  overallScore Float?
  passed       Boolean?
  submittedAt  DateTime @default(now())

  class   CourseClass     @relation(fields: [classId], references: [id], onDelete: Cascade)
  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers SectionAnswer[]

  @@index([userId])
}

model SectionAnswer {
  id            String   @id @default(cuid())
  submissionId  String
  sectionId     String
  questionId    String
  selectedIndex Int
  isCorrect     Boolean
  answeredAt    DateTime @default(now())

  submission ClassSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, questionId])
  @@index([sectionId])
}

// ============ LANGUAGE LEARNING — SPEAKING ============

enum SpeakingGradeStatus {
  PENDING
  GRADING
  SCORED
  FAILED
}

// One target phrase the learner must say aloud, hung off a SPEAKING ClassSection.
// A speaking prompt hangs off EXACTLY ONE parent: a class section (gated class)
// or a practice session (ungated). The XOR is enforced in app code.
model SpeakingPrompt {
  id                String   @id @default(cuid())
  sectionId         String?
  practiceSessionId String?
  examSectionId     String?
  order             Int
  targetPhrase      String   @db.Text
  translation       String   @db.Text
  ipa               String?  @db.Text
  referenceTtsUrl   String? // pre-rendered model pronunciation (resolveTtsProvider at build)
  createdAt         DateTime @default(now())

  section         ClassSection?    @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  practiceSession PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  examSection     ExamSection?     @relation(fields: [examSectionId], references: [id], onDelete: Cascade)
  recordings      SpeakingRecording[]

  @@unique([sectionId, order])
  @@unique([practiceSessionId, order])
  @@unique([examSectionId, order])
  @@index([sectionId])
  @@index([practiceSessionId])
  @@index([examSectionId])
}

// A learner's recorded attempt at a SpeakingPrompt, graded asynchronously.
model SpeakingRecording {
  id                String              @id @default(cuid())
  sectionId         String?
  practiceSessionId String?
  examSectionId     String?
  promptId          String
  userId            String
  audioUrl          String
  transcript        String?             @db.Text
  overallScore      Float? // 0..1 combined pronunciation score
  rubricScores      Json? // { accuracy, fluency, completeness } each 0..1
  phonemeScores     Json? // per-word alignment ops from align.ts
  feedback          String?             @db.Text
  status            SpeakingGradeStatus @default(PENDING)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  prompt          SpeakingPrompt   @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceSession PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([practiceSessionId])
  @@index([examSectionId])
  @@index([promptId])
  @@index([userId])
}

// A writing task. Hangs off EXACTLY ONE parent (a class section or a practice
// session), like SpeakingPrompt; XOR enforced in app code.
model WritingPrompt {
  id                String   @id @default(cuid())
  sectionId         String?
  practiceSessionId String?
  examSectionId     String?
  order             Int
  task              String   @db.Text // the writing task the learner responds to
  guidance          String?  @db.Text // optional hints / what to include
  createdAt         DateTime @default(now())

  section         ClassSection?     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  practiceSession PracticeSession?  @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)
  examSection     ExamSection?      @relation(fields: [examSectionId], references: [id], onDelete: Cascade)
  responses       WritingResponse[]

  @@unique([sectionId, order])
  @@unique([practiceSessionId, order])
  @@unique([examSectionId, order])
  @@index([sectionId])
  @@index([practiceSessionId])
  @@index([examSectionId])
}

// A learner's writing response, graded synchronously by the LLM (corrections +
// score), unlike speaking which is graded async by a worker.
model WritingResponse {
  id                String   @id @default(cuid())
  sectionId         String?
  practiceSessionId String?
  examSectionId     String?
  promptId          String
  userId            String
  text              String   @db.Text
  overallScore      Float? // 0..1
  corrections       Json? // [{ old, new, why }]
  feedback          String?  @db.Text
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  prompt          WritingPrompt    @relation(fields: [promptId], references: [id], onDelete: Cascade)
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceSession PracticeSession? @relation(fields: [practiceSessionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@index([practiceSessionId])
  @@index([examSectionId])
  @@index([promptId])
  @@index([userId])
}

// ============ LANGUAGE LEARNING — MOCK EXAMS ============

// Flagship CEFR exam whose FORMAT a mock exam is modeled on. Never affiliated
// with the real institution; we replicate structure only, never exam content.
enum ExamInstitution {
  GOETHE // German (Goethe-Institut)
  DELE // Spanish (Instituto Cervantes)
  CAMBRIDGE // English (Cambridge English Qualifications)
  CEFR_GENERIC // institution-agnostic CEFR mock
}

enum MockExamStatus {
  GENERATING
  READY
  IN_PROGRESS
  SUBMITTED
  SCORED
  FAILED
}

// An ungated, full-length practice exam modeled on a flagship CEFR exam format.
// Self-assessment only: it NEVER advances Course.currentLevel.
model MockExam {
  id          String          @id @default(cuid())
  userId      String
  courseId    String
  institution ExamInstitution
  level       CefrLevel
  status      MockExamStatus  @default(GENERATING)
  blueprintId String // catalog id, e.g. "goethe/b1"
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  course     Course          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sections   ExamSection[]
  submission ExamSubmission?

  @@index([userId])
  @@index([courseId])
}

// One part of a mock exam (e.g. "Leseverstehen Teil 1"). LISTENING reuses Podcast;
// speaking/writing reuse SpeakingPrompt/WritingPrompt via their examSectionId FK.
model ExamSection {
  id        String        @id @default(cuid())
  examId    String
  skill     SkillType
  part      String // institution-flavored part name
  order     Int
  format    String // 'mc' | 'listening' | 'speaking' | 'writing'
  weight    Float         @default(0) // share of the overall band; sums to ~1 per exam
  status    SectionStatus @default(PENDING)
  podcastId String?       @unique // LISTENING section -> reuse Podcast
  score     Float?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  exam            MockExam         @relation(fields: [examId], references: [id], onDelete: Cascade)
  podcast         Podcast?         @relation(fields: [podcastId], references: [id], onDelete: SetNull)
  questions       ExamQuestion[]
  speakingPrompts SpeakingPrompt[]
  writingPrompts  WritingPrompt[]

  @@index([examId, order])
}

// MC question for an exam section. Mirrors LessonQuestion; MC has no async grading
// so a separate model keeps exams decoupled from ClassSection.
model ExamQuestion {
  id           String   @id @default(cuid())
  sectionId    String
  order        Int
  skill        SkillType
  question     String   @db.Text
  options      Json // ["A","B","C","D"]
  correctIndex Int
  explanation  String   @db.Text
  passageRef   String?  @db.Text
  passageText  String?  @db.Text
  createdAt    DateTime @default(now())

  section ExamSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@unique([sectionId, order])
  @@index([sectionId])
}

// One submission per exam: the mock band + overall feedback. Does not change level.
model ExamSubmission {
  id           String   @id @default(cuid())
  examId       String   @unique
  overallScore Float?
  band         String? // e.g. "B2 (mock)"
  feedback     String?  @db.Text
  submittedAt  DateTime @default(now())

  exam           MockExam            @relation(fields: [examId], references: [id], onDelete: Cascade)
  sectionResults ExamSectionResult[]
}

model ExamSectionResult {
  id           String  @id @default(cuid())
  submissionId String
  sectionId    String
  skill        SkillType
  score        Float // 0..1
  feedback     String? @db.Text

  submission ExamSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, sectionId])
  @@index([sectionId])
}

// ============ LANGUAGE LEARNING — MEMORY GRAPH (SRS) ============

enum EdgeType {
  VOCAB_VOCAB // collocation / morphological relation
  VOCAB_GRAMMAR // word exemplifies a grammar topic
  VOCAB_CLASS // word introduced / practiced in a class
  VOCAB_PODCAST // word appeared in a listening podcast
  GRAMMAR_GRAMMAR // prerequisite chain
}

// Per-course vocabulary node with SM-2 spaced-repetition state.
model LearnerVocab {
  id            String  @id @default(cuid())
  courseId      String
  lemma         String // canonical target-language form
  translation   String
  partOfSpeech  String?
  pronunciation String?
  // SRS state (SM-2)
  ease         Float     @default(2.5)
  intervalDays Float     @default(0)
  dueAt        DateTime  @default(now())
  reps         Int       @default(0)
  lapses       Int       @default(0)
  mastery      Float     @default(0) // 0..1 rolled-up strength
  lastReviewed DateTime?
  // provenance
  firstSeenClassId String?
  cefrLevel        CefrLevel?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  course   Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  edgesOut VocabEdge[] @relation("EdgeSource")
  edgesIn  VocabEdge[] @relation("EdgeTarget")

  @@unique([courseId, lemma])
  @@index([courseId, dueAt])
  @@index([courseId, mastery])
}

// Per-course grammar-topic node with SRS state.
model LearnerGrammar {
  id           String     @id @default(cuid())
  courseId     String
  topicKey     String // matches Lesson.grammarPoints keys
  title        String
  cefrLevel    CefrLevel?
  ease         Float      @default(2.5)
  intervalDays Float      @default(0)
  dueAt        DateTime   @default(now())
  reps         Int        @default(0)
  lapses       Int        @default(0)
  mastery      Float      @default(0)
  lastReviewed DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([courseId, topicKey])
  @@index([courseId, dueAt])
  @@index([courseId, mastery])
}

// Polymorphic edge: exactly the endpoints relevant to `type` are non-null.
model VocabEdge {
  id            String   @id @default(cuid())
  courseId      String
  type          EdgeType
  weight        Float    @default(1.0)
  sourceVocabId String?
  targetVocabId String?
  grammarId     String?
  classId       String?
  podcastId     String?
  createdAt     DateTime @default(now())

  course      Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sourceVocab LearnerVocab? @relation("EdgeSource", fields: [sourceVocabId], references: [id], onDelete: Cascade)
  targetVocab LearnerVocab? @relation("EdgeTarget", fields: [targetVocabId], references: [id], onDelete: Cascade)

  @@index([courseId, type])
  @@index([sourceVocabId])
  @@index([targetVocabId])
  @@index([grammarId])
}

// Ungated single-skill practice within a course. Distinct from the gated
// CourseClass: short, repeatable, and only consolidates the memory graph (SRS).
model PracticeSession {
  id           String         @id @default(cuid())
  courseId     String
  kind         PracticeKind
  status       PracticeStatus @default(ACTIVE)
  items        Json // generated practice items (recall cards / questions / prompt refs)
  seed         String
  score        Float? // 0..1, set on submit
  vocabLemmas  String[]       @default([]) // lemmas this session reviews (SRS targets)
  grammarKeys  String[]       @default([]) // grammar topicKeys this session reviews
  podcastId    String?        @unique // LISTENING practice audio (one podcast per session)
  startedAt    DateTime       @default(now())
  completedAt  DateTime?

  course           Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  podcast          Podcast?            @relation(fields: [podcastId], references: [id], onDelete: SetNull)
  prompts          SpeakingPrompt[]
  recordings       SpeakingRecording[]
  writingPrompts   WritingPrompt[]
  writingResponses WritingResponse[]

  @@index([courseId, kind])
  @@index([courseId, status])
}

// One editable free-text context doc per course: goals, background, interests.
// Feeds placement + per-learner class/practice generation; never the shared curriculum.
model CourseNote {
  id        String   @id @default(cuid())
  courseId  String   @unique
  body      String   @db.Text
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
}
