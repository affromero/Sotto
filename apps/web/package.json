{
  "name": "@sotto/web",
  "version": "0.1.0",
  "private": true,
  "description": "Language learning you run yourself, with CEFR courses, adaptive listening, speaking practice, and a vocabulary memory graph on your own stack.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "next build",
    "ci": "npm run speech:config:check && npm run lint && npm run type-check && vitest run --no-file-parallelism && ../../scripts/run-with-env.sh npm run build",
    "dev": "concurrently -n web,workers -c blue,green \"npm run dev:web\" \"npm run dev:workers\"",
    "dev:web": "next dev",
    "dev:workers": "tsx watch src/workers/index.ts",
    "postinstall": "prisma generate",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "seed:curriculum": "tsx prisma/seed-curriculum.ts",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "smoke:audio-providers": "tsx scripts/smoke-audio-providers.ts",
    "speech:config": "node scripts/compile-speech-language-support-config.mjs",
    "speech:config:check": "node scripts/compile-speech-language-support-config.mjs --check",
    "start": "next start",
    "start:workers": "NODE_ENV=production tsx src/workers/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@aws-sdk/client-s3": "^3.1106.0",
    "@aws-sdk/lib-storage": "^3.1106.0",
    "@aws-sdk/s3-request-presigner": "^3.1106.0",
    "@google/genai": "^2.16.0",
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "@sentry/nextjs": "^10.69.0",
    "@sotto/learning-model": "*",
    "@sotto/shared": "*",
    "@steipete/summarize-core": "^0.21.8",
    "bullmq": "^5.80.2",
    "cheerio": "^1.2.0",
    "cmdk": "^1.1.1",
    "cytoscape": "^3.33.4",
    "cytoscape-fcose": "^2.2.0",
    "d3-geo": "^3.1.1",
    "date-fns": "^4.1.0",
    "groundcheck": "*",
    "ioredis": "^5.11.1",
    "jose": "^6.2.8",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.30.0",
    "markit-ai": "^0.5.3",
    "next": "^16.3.0",
    "openai": "^6.46.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.22.0",
    "playwright": "^1.58.2",
    "pricetoken": "^0.13.8",
    "prisma": "7.9.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "resend": "^6.18.1",
    "styled-jsx": "^5.1.7",
    "thesidedoor": "0.1.0",
    "topojson-client": "^3.1.0",
    "typescript": "^6.0.3",
    "web-push": "^3.6.7",
    "world-atlas": "^2.0.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/cytoscape": "^3.31.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/glob": "^8.1.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.3",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "concurrently": "^10.0.4",
    "eslint": "^10.8.1",
    "eslint-config-next": "^16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "glob": "^13.0.6",
    "jsonc-parser": "^3.3.1",
    "tsx": "^4.23.11",
    "vitest": "^4.0.18"
  }
}
