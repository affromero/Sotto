{
  "name": "@sotto/web",
  "version": "0.1.0",
  "description": "Open-source, self-hostable language-learning platform. CEFR-gated courses, adaptive listening, speaking practice, and a personal vocabulary memory graph — running on your own stack with your own API keys.",
  "license": "AGPL-3.0-only",
  "private": true,
  "scripts": {
    "build": "next build",
    "ci": "npm run lint && npm run type-check && vitest run --no-file-parallelism && ../../scripts/run-with-env.sh npm run build",
    "dev": "concurrently -n web,workers -c blue,green \"npm run dev:web\" \"npm run dev:workers\"",
    "dev:web": "next dev",
    "dev:workers": "tsx watch src/workers/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "postinstall": "prisma generate",
    "start": "next start",
    "start:workers": "NODE_ENV=production tsx src/workers/index.ts",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "seed:curriculum": "tsx prisma/seed-curriculum.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/lib-storage": "^3.1002.0",
    "@aws-sdk/s3-request-presigner": "^3.975.0",
    "@google/genai": "^2.7.0",
    "@mozilla/readability": "^0.6.0",
    "@prisma/client": "~6.19.2",
    "@sentry/nextjs": "^10.40.0",
    "@sotto/shared": "*",
    "@sotto/verification-standard": "*",
    "@steipete/summarize-core": "^0.11.1",
    "bullmq": "^5.67.0",
    "cheerio": "^1.2.0",
    "cmdk": "^1.1.1",
    "cytoscape": "^3.33.4",
    "cytoscape-fcose": "^2.2.0",
    "date-fns": "^4.1.0",
    "ioredis": "5.9.2",
    "jose": "^6.1.3",
    "jsdom": "^27.0.1",
    "lucide-react": "^0.563.0",
    "markit-ai": "^0.2.0",
    "next": "^16.2.0",
    "next-auth": "^5.0.0-beta.30",
    "openai": "^6.22.0",
    "pdf-parse": "^2.4.5",
    "pdfjs-dist": "^5.4.296",
    "playwright": "^1.58.2",
    "pricetoken": "^0.13.8",
    "prisma": "~6.19.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "resend": "^6.9.2",
    "styled-jsx": "^5.1.6",
    "thesidedoor": "^0.1.0",
    "typescript": "^5.9.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/cytoscape": "^3.21.9",
    "@types/glob": "^8.1.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^25.0.10",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
