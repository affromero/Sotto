{
  "name": "sotto",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "description": "Where podcasts get social. AI or human — create, discover, interrupt, fork, and remix.",
  "scripts": {
    "build": "npm run build --workspace=@sotto/web",
    "ci": "npm run ci --workspace=@sotto/web",
    "db:sync": "bash scripts/sync-prod-db.sh",
    "dev": "npm run db:sync && doppler run -- npm run dev --workspace=@sotto/web",
    "dev:web": "doppler run -- npm run dev:web --workspace=@sotto/web",
    "dev:workers": "doppler run -- npm run dev:workers --workspace=@sotto/web",
    "record": "NODE_PATH=apps/web/node_modules doppler run -- npx tsx scripts/recording/index.ts",
    "narrate": "NODE_PATH=apps/web/node_modules doppler run -- npx tsx scripts/recording/narrate.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "npm run lint --workspace=@sotto/web",
    "lint:fix": "npm run lint:fix --workspace=@sotto/web",
    "setup": "chmod +x ./scripts/setup.sh && ./scripts/setup.sh",
    "start": "npm run start --workspace=@sotto/web",
    "start:workers": "npm run start:workers --workspace=@sotto/web",
    "test": "npm run test --workspace=@sotto/web",
    "test:smoke": "doppler run -- npm run test:smoke --workspace=@sotto/web",
    "test:coverage": "npm run test:coverage --workspace=@sotto/web",
    "test:watch": "npm run test:watch --workspace=@sotto/web",
    "type-check": "npm run type-check --workspace=@sotto/web",
    "mobile": "npm run mobile:env && npm run start --workspace=@sotto/mobile",
    "mobile:env": "doppler secrets download --no-file --format env | grep '^EXPO_PUBLIC_' | sed \"s|LAN_IP|$(ipconfig getifaddr en0)|g\" > apps/mobile/.env",
    "mobile:ios": "npm run mobile:env && npm run ios --workspace=@sotto/mobile",
    "mobile:android": "npm run mobile:env && npm run android --workspace=@sotto/mobile",
    "mobile:xcode": "npm run ios:open --workspace=@sotto/mobile",
    "mobile:ios:build": "npm run ios:build --workspace=@sotto/mobile",
    "mobile:ios:build:preview": "npm run ios:build:preview --workspace=@sotto/mobile",
    "mobile:ios:build:production": "npm run ios:build:production --workspace=@sotto/mobile",
    "mobile:ios:submit": "npm run ios:submit --workspace=@sotto/mobile",
    "mobile:android:build": "npm run android:build --workspace=@sotto/mobile",
    "mobile:android:build:preview": "npm run android:build:preview --workspace=@sotto/mobile",
    "mobile:android:build:production": "npm run android:build:production --workspace=@sotto/mobile",
    "mobile:android:submit": "npm run android:submit --workspace=@sotto/mobile"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "*.{ts,tsx,js,jsx,json,md,css,yaml,yml}": [
      "prettier --write"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "devDependencies": {
    "@types/geoip-lite": "^1.4.4",
    "lint-staged": "^16.2.7",
    "next-auth": "^5.0.0-beta.30",
    "prettier": "^3.8.1",
    "prisma": "^6.19.2",
    "sort-package-json": "^3.6.1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "geoip-lite": "^1.4.10"
  },
  "overrides": {
    "react-native-reanimated": "4.1.1",
    "react-native-worklets": "0.5.1"
  }
}
