{
  "name": "sotto",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/*", "packages/*"],
  "description": "Podcasts that listen back. Generate AI podcasts from any topic, interrupt to ask questions, and share knowledge with the world.",
  "scripts": {
    "build": "npm run build --workspace=@sotto/web",
    "ci": "npm run ci --workspace=@sotto/web",
    "dev": "npm run dev --workspace=@sotto/web",
    "dev:web": "npm run dev:web --workspace=@sotto/web",
    "dev:workers": "npm run dev:workers --workspace=@sotto/web",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "npm run lint --workspace=@sotto/web",
    "lint:fix": "npm run lint:fix --workspace=@sotto/web",
    "setup": "chmod +x ./scripts/setup.sh && ./scripts/setup.sh",
    "start": "npm run start --workspace=@sotto/web",
    "start:workers": "npm run start:workers --workspace=@sotto/web",
    "test": "npm run test --workspace=@sotto/web",
    "test:coverage": "npm run test:coverage --workspace=@sotto/web",
    "test:watch": "npm run test:watch --workspace=@sotto/web",
    "type-check": "npm run type-check --workspace=@sotto/web",
    "mobile": "npm run start --workspace=@sotto/mobile",
    "mobile:ios": "npm run ios --workspace=@sotto/mobile",
    "mobile:xcode": "npm run ios:open --workspace=@sotto/mobile",
    "mobile:build": "npm run ios:build --workspace=@sotto/mobile",
    "mobile:build:preview": "npm run ios:build:preview --workspace=@sotto/mobile",
    "mobile:build:production": "npm run ios:build:production --workspace=@sotto/mobile",
    "mobile:submit": "npm run ios:submit --workspace=@sotto/mobile"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "*.{ts,tsx,js,jsx,json,md,css,yaml,yml}": [
      "prettier --write"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "devDependencies": {
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "sort-package-json": "^3.6.1"
  }
}
