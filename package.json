{
  "name": "sotto",
  "version": "0.1.0",
  "private": true,
  "description": "Podcasts that listen back. Generate AI podcasts from any topic, interrupt to ask questions, and share knowledge with the world.",
  "scripts": {
    "build": "next build",
    "dev": "concurrently -n web,workers -c blue,green \"npm run dev:web\" \"npm run dev:workers\"",
    "dev:web": "next dev",
    "dev:workers": "tsx watch src/workers/index.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "postinstall": "prisma generate",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:push": "prisma db push",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "seed:demo": "tsx prisma/seed-demo.ts",
    "setup": "chmod +x ./scripts/setup.sh && ./scripts/setup.sh",
    "start": "next start",
    "start:workers": "NODE_ENV=production tsx src/workers/index.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "type-check": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "*.{ts,tsx,js,jsx,json,md,css,yaml,yml}": [
      "prettier --write"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.2",
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.975.0",
    "@aws-sdk/s3-request-presigner": "^3.975.0",
    "@prisma/client": "^6.19.2",
    "bullmq": "^5.67.0",
    "date-fns": "^4.1.0",
    "ioredis": "^5.9.2",
    "lucide-react": "^0.563.0",
    "next": "^16.1.4",
    "next-auth": "^5.0.0-beta.30",
    "pdf-parse": "^2.4.5",
    "pdfmake": "^0.3.3",
    "prisma": "^6.19.2",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "stripe": "^20.2.0",
    "typescript": "^5.9.3",
    "web-push": "^3.6.7",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.0.10",
    "@types/pdfmake": "^0.3.1",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.1.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "jsdom": "^27.0.1",
    "lint-staged": "^16.2.7",
    "playwright": "^1.58.2",
    "prettier": "^3.8.1",
    "sort-package-json": "^3.6.1",
    "tsx": "^4.21.0",
    "vitest": "^4.0.18"
  }
}
