{
  "name": "sotto",
  "version": "0.30.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*",
    "!apps/desktop"
  ],
  "description": "Open-source, self-hostable language learning, taught in your own context through the AI agent you already own.",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "npm run build --workspace=@sotto/web",
    "ci": "npm run ci --workspace=@sotto/web",
    "dev": "scripts/run-with-env.sh env REMOTION_URL=http://localhost:3100 npm run dev --workspace=@sotto/web",
    "dev:web": "scripts/run-with-env.sh npm run dev:web --workspace=@sotto/web",
    "dev:workers": "scripts/run-with-env.sh env REMOTION_URL=http://localhost:3100 npm run dev:workers --workspace=@sotto/web",
    "dev:remotion": "scripts/run-with-env.sh npx tsx services/remotion/src/server.ts",
    "record": "scripts/run-with-env.sh env NODE_PATH=apps/web/node_modules npx tsx scripts/recording/index.ts",
    "narrate": "scripts/run-with-env.sh env NODE_PATH=apps/web/node_modules npx tsx scripts/recording/narrate.ts",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "npm run lint --workspace=@sotto/web",
    "lint:fix": "npm run lint:fix --workspace=@sotto/web",
    "setup": "chmod +x ./scripts/setup.sh && ./scripts/setup.sh",
    "oss:maps-stub": "node scripts/oss-maps-stub.mjs",
    "start": "npm run start --workspace=@sotto/web",
    "start:workers": "npm run start:workers --workspace=@sotto/web",
    "test": "npm run test --workspace=@sotto/web",
    "test:smoke": "npm run test:smoke --workspace=@sotto/web",
    "test:coverage": "npm run test:coverage --workspace=@sotto/web",
    "test:watch": "npm run test:watch --workspace=@sotto/web",
    "type-check": "npm run type-check --workspace=@sotto/web",
    "update-mbfc": "curl -sL https://raw.githubusercontent.com/drmikecrowe/mbfcext/master/docs/v5/data/combined.json -o apps/web/src/data/mbfc-combined.json",
    "mobile": "npm run mobile:env && npm run start --workspace=@sotto/mobile",
    "mobile:env": "bash scripts/sync-mobile-env.sh",
    "mobile:ios": "npm run mobile:env && npm run ios --workspace=@sotto/mobile",
    "mobile:android": "npm run mobile:env && npm run android --workspace=@sotto/mobile",
    "mobile:xcode": "npm run ios:open --workspace=@sotto/mobile",
    "mobile:ios:build": "npm run ios:build --workspace=@sotto/mobile",
    "mobile:ios:build:preview": "npm run ios:build:preview --workspace=@sotto/mobile",
    "mobile:ios:build:production": "npm run ios:build:production --workspace=@sotto/mobile",
    "mobile:ios:submit": "npm run ios:submit --workspace=@sotto/mobile",
    "mobile:android:build": "npm run android:build --workspace=@sotto/mobile",
    "mobile:android:build:preview": "npm run android:build:preview --workspace=@sotto/mobile",
    "mobile:android:build:production": "npm run android:build:production --workspace=@sotto/mobile",
    "mobile:android:submit": "npm run android:submit --workspace=@sotto/mobile",
    "test:e2e:web": "npx playwright test --config e2e/playwright/playwright.config.ts",
    "test:e2e:mobile": "bash e2e/maestro/run.sh",
    "test:e2e:mobile:critical": "bash e2e/maestro/run.sh --tags critical",
    "test:e2e:mobile:skip-backend": "bash e2e/maestro/run.sh --skip-backend"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --max-warnings 0"
    ],
    "*.{ts,tsx,js,jsx,json,md,css,yaml,yml}": [
      "prettier --write"
    ],
    "package.json": [
      "sort-package-json"
    ]
  },
  "devDependencies": {
    "@copilotkit/llmock": "^1.1.1",
    "@playwright/test": "^1.58.2",
    "@types/geoip-lite": "^1.4.4",
    "lint-staged": "^16.2.7",
    "next-auth": "^5.0.0-beta.30",
    "prettier": "^3.8.1",
    "prisma": "^6.19.2",
    "sort-package-json": "^3.6.1"
  },
  "dependencies": {
    "@prisma/client": "^6.19.2",
    "geoip-lite": "^1.4.10",
    "pricetoken": "^0.13.9"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "^16.1.7"
  },
  "overrides": {
    "react-native-reanimated": "4.1.1",
    "react-native-worklets": "0.5.1"
  }
}
