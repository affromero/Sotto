# Sotto — Caddy Reverse Proxy Configuration
#
# Usage:
#   1. Copy this file to /etc/caddy/Caddyfile on your server
#   2. Replace "sotto.fm" with your actual domain
#   3. Reload: sudo systemctl reload caddy
#
# Caddy automatically obtains and renews Let's Encrypt SSL certificates.

sotto.fm {
	reverse_proxy localhost:3000

	encode gzip zstd

	# Transport-level headers only — Next.js owns per-route CSP, X-Frame-Options,
	# Permissions-Policy, X-Content-Type-Options, and Referrer-Policy via headers()
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	# Cache static assets
	@static path /fonts/* /_next/static/* /favicon.ico /manifest.json /sw.js
	header @static Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /var/log/caddy/sotto-access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

www.sotto.fm {
	# Telegram webhook — proxy directly (Telegram can't resolve apex .fm domains)
	handle /api/telegram/webhook {
		reverse_proxy localhost:3000
	}

	# Everything else redirects to apex
	handle {
		redir https://sotto.fm{uri} permanent
	}
}
