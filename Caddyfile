# Sotto Caddy site fragment template.
# Rendered by scripts/deploy.sh to /etc/caddy/conf.d/sotto.conf by default.
# The shared /etc/caddy/Caddyfile must import /etc/caddy/conf.d/*.
#
# Blue-green deploy: both slots listed, Caddy auto-routes to whichever is healthy.
# During normal operation only one slot is up. During transitions both are briefly up.

__SOTTO_APP_DOMAIN__ {
	reverse_proxy localhost:3000 localhost:3010 {
		lb_policy first
		health_uri /api/health
		health_interval 5s
		health_timeout 3s
		health_status 200
	}

	encode gzip zstd

	# Transport-level headers only — Next.js owns per-route CSP, X-Frame-Options,
	# Permissions-Policy, X-Content-Type-Options, and Referrer-Policy via headers()
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	# Cache static assets
	@static path /fonts/* /_next/static/* /favicon.ico /manifest.json /sw.js
	header @static Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /var/log/caddy/sotto-access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

# BEGIN_OPTIONAL_MAPS
__SOTTO_MAPS_DOMAIN__ {
	reverse_proxy localhost:3002 localhost:3012 {
		lb_policy first
		health_uri /api/health
		health_interval 5s
		health_timeout 3s
		health_status 200
	}

	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	@static path /fonts/* /_next/static/* /favicon.ico
	header @static Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /var/log/caddy/maps-access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}
# END_OPTIONAL_MAPS

# BEGIN_OPTIONAL_WWW
__SOTTO_WWW_DOMAIN__ {
	# Telegram webhook — proxy directly when a deployment registers webhooks on the www host.
	handle /api/telegram/webhook {
		reverse_proxy localhost:3000 localhost:3010 {
			lb_policy first
			health_uri /api/health
			health_interval 5s
			health_timeout 3s
			health_status 200
		}
	}

	# Everything else redirects to apex
	handle {
		redir https://__SOTTO_APP_DOMAIN__{uri} permanent
	}
}
# END_OPTIONAL_WWW
