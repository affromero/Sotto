# sotto.fm — Caddy site fragment
# Deployed to: /etc/caddy/conf.d/sotto.fm
# Imported by the shared /etc/caddy/Caddyfile on sotto-prod

sotto.fm {
	reverse_proxy localhost:3000

	encode gzip zstd

	# Transport-level headers only — Next.js owns per-route CSP, X-Frame-Options,
	# Permissions-Policy, X-Content-Type-Options, and Referrer-Policy via headers()
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	# Cache static assets
	@static path /fonts/* /_next/static/* /favicon.ico /manifest.json /sw.js
	header @static Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /var/log/caddy/sotto-access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

maps.sotto.fm {
	reverse_proxy localhost:3002

	encode gzip zstd

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		-Server
	}

	@static path /fonts/* /_next/static/* /favicon.ico
	header @static Cache-Control "public, max-age=31536000, immutable"

	log {
		output file /var/log/caddy/maps-access.log {
			roll_size 50MiB
			roll_keep 5
		}
	}
}

www.sotto.fm {
	# Telegram webhook — proxy directly (Telegram can't resolve apex .fm domains)
	handle /api/telegram/webhook {
		reverse_proxy localhost:3000
	}

	# Everything else redirects to apex
	handle {
		redir https://sotto.fm{uri} permanent
	}
}
